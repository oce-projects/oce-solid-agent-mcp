<!--
  Oce.Solid.Agent.Core — the drawing operations, without the PDM.

  It is the library that exists so that the drawing engine can be tried, and
  used, WITHOUT OpenPDM. It is not a fallback for publishing: separating the two
  is the only way to put the operations on a bench that needs no
  server, no vault and no network.

  THREE THINGS THAT MUST NOT ENTER HERE, AND WHY.

  1. The Dassault DLLs. `Private=False` and `EmbedInteropTypes=False` with
     the HintPath on the installation: the interops stay where
     SOLIDWORKS put them and do not end up in any repository. It is the condition for
     this library to be publishable.

  2. WPF, WebView2, System.Net.Http, System.Web.Extensions. They are the interface
     and the transport of the add-in, not the drawing. If one of these reappears among
     the references, it means code that does not belong here has come back in.

  3. `PlanExecutor.cs`. It is the only file of the layer that depends on OpenPDM
     (`ApiClient`), and it enters only behind an interface of its own (the source of the plan) — entry B3
     of the TODO. Until that exists, it stays out.

  LangVersion 9.0 and not 7.3: the add-in compiles at 9.0 and the code uses it. The
  MCP bridge is at 7.3, but the bridge does not compile these files — it loads them.
-->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{7B3C1F42-9A5E-4D18-A6C2-51E0D7B44A93}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>Oce.Solid.Agent.Core</RootNamespace>
    <AssemblyName>Oce.Solid.Agent.Core</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <LangVersion>9.0</LangVersion>
    <Deterministic>true</Deterministic>
    <!-- Where SOLIDWORKS is. It can be overridden from the command line:
         msbuild /p:SwInstallPath="D:\...\SOLIDWORKS"-->
    <SwInstallPath Condition="'$(SwInstallPath)' == ''">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS</SwInstallPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <!-- It serves `PartView` to turn into PNG the BMP that SOLIDWORKS
         writes: an uncompressed 1024x768 BMP is 2.3 MB, the same frame
         in PNG fits in a few tens of KB.-->
    <Reference Include="System.Drawing" />
    <!-- They serve ONLY SolidWorksMaterials.cs, which reads the list of materials.
         System.Xml was not in the planned list and is needed all the same: XDocument
         is in System.Xml.Linq but its Load() has XmlReader in the signature, which
         is in System.Xml. Without it, CS0012 on SolidWorksMaterials.cs:82.-->
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <!-- Api\ApiCatalog.cs reads api_knowledge.json (entry U1.1). -->
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <!-- SOLIDWORKS Interop: they stay where the installation put them.-->
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SwInstallPath)\api\redist\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SwInstallPath)\api\redist\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
    <!-- DimXpert (entry Z-H3): it is in the same api\redist as the core and is there on
         every installation. `IModelDocExtension.get_DimXpertManager` returns
         it, so the interop of the core already requires it.-->
    <Reference Include="SolidWorks.Interop.swdimxpert">
      <HintPath>$(SwInstallPath)\api\redist\SolidWorks.Interop.swdimxpert.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

