<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Exe</OutputType>
    <RootNamespace>Oce.Solid.Agent</RootNamespace>
    <!-- THE NAME OF THE EXECUTABLE IS THAT OF THE PACKAGE, NOT OF THE NAMESPACE.
         `oce-solid-agent-mcp.exe` is what ends up in the configuration of
         every MCP client, in the installer and in the README commands: it must
         match the name of the repository and of the package, or whoever copies a
         line from the documentation finds a file that is not there.
         The namespace stays in PascalCase with dots, which is the .NET
         convention; the file does not, and the two need not look alike.-->
    <AssemblyName>oce-solid-agent-mcp</AssemblyName>
    <!-- .NET Framework 4.8 is not a matter of taste: the real add-in is
         compiled for that, and this bridge loads it by reflection.-->
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <!-- x64 like SolidWorks: a 32 bit process does not attach.-->
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>bin\</OutputPath>
    <LangVersion>7.3</LangVersion>
    <!-- Two builds of the same source give the same bytes (W3.1-bis.2,
         Checks\language\same-il.ps1). -->
    <Deterministic>true</Deterministic>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Where SOLIDWORKS is: needed only for the interops, which do NOT go in the
         package (Private=False). It is overridden with /p:SwInstallPath=...-->
    <SwInstallPath Condition="'$(SwInstallPath)' == ''">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS</SwInstallPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- THE DRAWING OPERATIONS, CALLED AND NOT REFLECTED.
         Up to 0.5.0 the bridge loaded OpenPDM.SwAddin.dll by hand,
         because that DLL is private and this repository could not
         reference it. Now the library is in here: it is a project reference
         like any other, and the type names are checked by the
         compiler instead of by the customer.-->
    <ProjectReference Include="Oce.Solid.Agent.Core\Oce.Solid.Agent.Core.csproj">
      <Project>{7B3C1F42-9A5E-4D18-A6C2-51E0D7B44A93}</Project>
      <Name>Oce.Solid.Agent.Core</Name>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- SOLIDWORKS interops: the bridge passes ISldWorks and IModelDoc2
         typed to the library. Private=False, so they stay where the
         installation put them and end up neither in the repository nor in the
         package.-->
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SwInstallPath)\api\redist\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SwInstallPath)\api\redist\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Mcp\Protocol.cs" />
    <Compile Include="Mcp\Risorse.cs" />
    <Compile Include="Mcp\Elicitation.cs" />
    <Compile Include="Mcp\Progress.cs" />
    <Compile Include="Bridge\PlanInMemory.cs" />
    <Compile Include="Bridge\Session.cs" />
    <Compile Include="Bridge\Documents.cs" />
    <Compile Include="Bridge\DocumentTurn.cs" />
    <Compile Include="Bridge\Paths.cs" />
    <Compile Include="Bridge\Shape.cs" />
    <Compile Include="Tools\Catalog.cs" />
    <Compile Include="Tools\QuestionRegistry.cs" />
    <Compile Include="Tools\McpTools.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The catalog travels with the executable: without it, the bridge can execute but
         cannot say what can be asked.-->
    <None Include="Tools\catalog.json">
      <Link>catalog.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="App.config" />
  </ItemGroup>
  <ItemGroup>
    <!-- A SINGLE SOURCE FOR THE VERSION. `Program.Version` reads it from
         here instead of keeping a copy by hand, which stayed stuck at
         0.2.0 for seventy-eight minor versions without anyone
         comparing it with anything.-->
    <EmbeddedResource Include="VERSION.txt" />
    <!-- WHAT IS KNOWN OF EACH API MEMBER (entry U1.1), read by api_search and
         api_signature. Embedded, not copied: a knowledge file left behind by
         the installer would make every member look never probed. -->
    <EmbeddedResource Include="Tools\api_knowledge.json" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!-- THE WIN32 VERSION FROM VERSION.txt (entry H14). Whoever right clicked ->
       Properties -> Details on the executable read 0.0.0.0: the real version
       was only a resource read at run time. An MSBuild target and not a
       step of build.ps1, so that it holds for EVERY road that builds the project,
       even msbuild by hand. The contract suite checks that the file properties
       say the same thing as VERSION.txt.-->
  <Target Name="VersionFromFile" BeforeTargets="CoreCompile">
    <ReadLinesFromFile File="$(MSBuildThisFileDirectory)VERSION.txt">
      <Output TaskParameter="Lines" PropertyName="BridgeVersion" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <BridgeVersion>$(BridgeVersion.Trim())</BridgeVersion>
      <VersionFile>$(IntermediateOutputPath)Version.g.cs</VersionFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(VersionFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
      Lines="[assembly: System.Reflection.AssemblyVersion(&quot;$(BridgeVersion).0&quot;)];[assembly: System.Reflection.AssemblyFileVersion(&quot;$(BridgeVersion).0&quot;)];[assembly: System.Reflection.AssemblyInformationalVersion(&quot;$(BridgeVersion)&quot;)]" />
    <ItemGroup>
      <Compile Include="$(VersionFile)" />
      <FileWrites Include="$(VersionFile)" />
    </ItemGroup>
  </Target>
</Project>
