<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Exe</OutputType>
    <RootNamespace>Oce.Solid.Agent</RootNamespace>
    <!-- IL NOME DELL'ESEGUIBILE E' QUELLO DEL PACCHETTO, NON DEL NAMESPACE.
         `oce-solid-agent-mcp.exe` e' cio' che finisce nella configurazione di
         ogni client MCP, nell'installatore e nei comandi del README: deve
         coincidere con il nome del repository e del pacchetto, o chi copia una
         riga dalla documentazione trova un file che non c'e'.
         Il namespace resta in PascalCase con i punti, che e' la convenzione
         .NET; il file no, e i due non devono somigliarsi per forza. -->
    <AssemblyName>oce-solid-agent-mcp</AssemblyName>
    <!-- .NET Framework 4.8 non e' una scelta di gusto: l'add-in vero e'
         compilato per quello, e questo ponte lo carica per riflessione. -->
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <!-- x64 come SolidWorks: un processo a 32 bit non si aggancia. -->
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>bin\</OutputPath>
    <LangVersion>7.3</LangVersion>
    <!-- Two builds of the same source give the same bytes (W3.1-bis.2,
         Checks\language\same-il.ps1). -->
    <Deterministic>true</Deterministic>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Dove sta SOLIDWORKS: serve solo per le interop, che NON entrano nel
         pacchetto (Private=False). Si scavalca con /p:SwInstallPath=... -->
    <SwInstallPath Condition="'$(SwInstallPath)' == ''">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS</SwInstallPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- LE OPERAZIONI DI DISEGNO, CHIAMATE E NON RIFLESSE.
         Fino alla 0.5.0 il ponte caricava OpenPDM.SwAddin.dll a mano,
         perche' quella DLL e' privata e questo repository non poteva
         referenziarla. Adesso la libreria sta qui dentro: e' un riferimento
         di progetto come un altro, e i nomi dei tipi li controlla il
         compilatore invece del cliente. -->
    <ProjectReference Include="Oce.Solid.Agent.Core\Oce.Solid.Agent.Core.csproj">
      <Project>{7B3C1F42-9A5E-4D18-A6C2-51E0D7B44A93}</Project>
      <Name>Oce.Solid.Agent.Core</Name>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Interop di SOLIDWORKS: il ponte passa ISldWorks e IModelDoc2
         tipizzati alla libreria. Private=False, quindi restano dove le ha
         messe l'installazione e non finiscono ne' nel repository ne' nel
         pacchetto. -->
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SwInstallPath)\api\redist\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SwInstallPath)\api\redist\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Mcp\Protocol.cs" />
    <Compile Include="Mcp\Risorse.cs" />
    <Compile Include="Mcp\Elicitation.cs" />
    <Compile Include="Mcp\Progress.cs" />
    <Compile Include="Bridge\PlanInMemory.cs" />
    <Compile Include="Bridge\Session.cs" />
    <Compile Include="Bridge\Documents.cs" />
    <Compile Include="Bridge\DocumentTurn.cs" />
    <Compile Include="Bridge\Paths.cs" />
    <Compile Include="Bridge\Shape.cs" />
    <Compile Include="Tools\Catalog.cs" />
    <Compile Include="Tools\QuestionRegistry.cs" />
    <Compile Include="Tools\McpTools.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Il catalogo viaggia con l'eseguibile: senza, il ponte sa eseguire ma
         non sa dire cosa si puo' chiedere. -->
    <None Include="Tools\catalog.json">
      <Link>catalog.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="App.config" />
  </ItemGroup>
  <ItemGroup>
    <!-- UNA SOLA FONTE PER LA VERSIONE. `Program.Version` la legge da
         qui invece di tenerne una copia a mano, che e' rimasta ferma a
         0.2.0 per settantotto versioni minori senza che nessuno la
         confrontasse con niente. -->
    <EmbeddedResource Include="VERSION.txt" />
    <!-- WHAT IS KNOWN OF EACH API MEMBER (entry U1.1), read by api_search and
         api_signature. Embedded, not copied: a knowledge file left behind by
         the installer would make every member look never probed. -->
    <EmbeddedResource Include="Tools\api_knowledge.json" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!-- LA VERSIONE WIN32 DA VERSION.txt (voce H14). Chi faceva tasto destro ->
       Proprieta' -> Dettagli sull'eseguibile leggeva 0.0.0.0: la versione vera
       era solo una risorsa letta a run time. Un bersaglio di MSBuild e non un
       passo di build.ps1, cosi' vale per OGNI strada che compila il progetto,
       anche msbuild a mano. La suite di contratto controlla che le proprieta'
       del file dicano la stessa cosa di VERSION.txt. -->
  <Target Name="VersioneDaFile" BeforeTargets="CoreCompile">
    <ReadLinesFromFile File="$(MSBuildThisFileDirectory)VERSION.txt">
      <Output TaskParameter="Lines" PropertyName="VersionePonte" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <VersionePonte>$(VersionePonte.Trim())</VersionePonte>
      <FileVersione>$(IntermediateOutputPath)Versione.g.cs</FileVersione>
    </PropertyGroup>
    <WriteLinesToFile File="$(FileVersione)" Overwrite="true" WriteOnlyWhenDifferent="true"
      Lines="[assembly: System.Reflection.AssemblyVersion(&quot;$(VersionePonte).0&quot;)];[assembly: System.Reflection.AssemblyFileVersion(&quot;$(VersionePonte).0&quot;)];[assembly: System.Reflection.AssemblyInformationalVersion(&quot;$(VersionePonte)&quot;)]" />
    <ItemGroup>
      <Compile Include="$(FileVersione)" />
      <FileWrites Include="$(FileVersione)" />
    </ItemGroup>
  </Target>
</Project>
