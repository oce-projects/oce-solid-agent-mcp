<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!--
      LOADING AN ASSEMBLY FROM A NETWORK DRIVE.

      The project lives on S:, which is a share. .NET Framework treats
      everything that is not local as a "remote source" and refuses to load it:
      the error is 0x80131515 - "Operation not supported", which names neither
      the network nor trust, and sends one looking for missing dependencies that are not
      missing.

      Here the assembly being loaded is the company's add-in, from the company's
      drive: the restriction protects from nothing and prevents everything.
    -->
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
