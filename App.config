<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!--
      CARICARE UN ASSEMBLY DA UN DISCO DI RETE.

      Il progetto sta su S:, che e' una condivisione. .NET Framework tratta
      tutto cio' che non e' locale come "remote source" e rifiuta di caricarlo:
      l'errore e' 0x80131515 - "Operazione non supportata", che non nomina ne'
      la rete ne' la fiducia, e manda a cercare dipendenze mancanti che non
      mancano.

      Qui l'assembly che si carica e' l'add-in dell'azienda, dal disco
      dell'azienda: la restrizione non protegge da niente e impedisce tutto.
    -->
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
