#!/bin/sh
# Quello che non deve uscire da questa macchina, controllato NEL MOMENTO in cui
# starebbe per uscire.
#
# PERCHE' UN GANCIO E NON UNA RIGA IN UNA LISTA.
#
# Il 14 settembre 2026 `controlla-pubblicabilita.ps1` esisteva gia', era gia'
# giusto, e un minuto prima del primo push diceva «Pulito» sull'albero mentre la
# storia portava ancora un percorso di rete in 155 punti su 41 commit. Il
# controllo non manco': manco' il fatto che qualcuno lo lanciasse.
#
# Un controllo che si lancia quando ci si ricorda e' un controllo che non si
# lancia il giorno che conta - che e' sempre il giorno in cui si ha fretta.
# Qui lo lancia git, e se e' rosso il push non parte.
#
# COME SI ACCENDE (una volta per clone, git non versiona .git/hooks):
#
#     .\Controlli\installa-ganci.ps1
#
# COME SI SCAVALCA, quando serve davvero:
#
#     git push --no-verify
#
# Si scavalca a mano e si sa di averlo fatto. E' diverso dal non averlo mai
# acceso.

# Il gancio sta in Controlli/ganci/, il controllo un livello sopra in Controlli/.
# Si ricava da $0 e non dalla cartella corrente: git lancia i ganci dalla radice
# del lavoro, ma un `sh Controlli/ganci/pre-push` lanciato a mano no, e un
# gancio che funziona solo quando lo chiama git non si puo' provare.
qui=$(dirname "$0")

# The refs being pushed arrive on stdin ("<local ref> <local sha> <remote ref>
# <remote sha>" per line). They are read first, before any command below can
# consume stdin; run by hand without a pipe, the hook judges HEAD.
if [ -t 0 ]; then pushed_refs=""; else pushed_refs=$(cat); fi
controllo="$qui/../controlla-pubblicabilita.ps1"
workflow="$qui/../controlla-workflow.ps1"

if [ ! -f "$controllo" ]; then
    echo "pre-push: non trovo $controllo - il gancio non sa cosa lanciare." >&2
    exit 1
fi
if [ ! -f "$workflow" ]; then
    echo "pre-push: non trovo $workflow - il gancio non sa cosa lanciare." >&2
    exit 1
fi

# -NoProfile: il profilo di chi lavora non deve poter cambiare l'esito.
# -ExecutionPolicy Bypass: il gancio deve funzionare anche su una macchina che
# non ha mai sbloccato gli script, altrimenti il primo che clona lo spegne.
# IL POWERSHELL DELLA CI, PRIMA (voce F9-bis). Costa un decimo di secondo e
# prende la cosa che la CI, per anni, non ha potuto prendere da sola: un
# passo che non si legge. Il push e' il momento giusto perche' e' li' che la
# CI comincia a esistere.
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$workflow"
if [ $? -ne 0 ]; then
    echo "" >&2
    echo "pre-push: FERMO. Un passo della CI non si legge, o non lo chiama" >&2
    echo "nessuno. Sopra c'e' scritto quale." >&2
    exit 1
fi

# IL TODO CONTRO LA REALTA' (23/9/2026).
#
# Due sonde che leggono solo file del repository: i percorsi che il TODO cita
# esistono ancora? i rimandi interni («vedi K17») puntano a una voce vera?
#
# Sono nate perche' un file di 16.000 righe marcisce in silenzio, e il giorno
# in cui le ho scritte hanno trovato **un rimando rotto e quattro firme di API
# sbagliate**. Ma una sonda che si lancia quando ci si ricorda e' una sonda
# che non si lancia: qui la lancia git, come il resto.
#
# NON ci sono le due sonde sulle interop (`firme-del-todo.ps1`,
# `firme-api.ps1`): vogliono SOLIDWORKS installato, e un gancio che fallisce
# su una macchina senza CAD e' un gancio che il primo che clona disattiva.
for sonda in percorsi-del-todo.js rimandi-del-todo.js righe-del-todo.js; do
    if [ -f "$qui/../$sonda" ]; then
        node "$qui/../$sonda"
        if [ $? -ne 0 ]; then
            echo "" >&2
            echo "pre-push: FERMO. $sonda ha trovato qualcosa nel TODO." >&2
            exit 1
        fi
    fi
done

# ZERO O «NON LO SO» (voce Z-C8). Fino al 25/9/2026 era solo un elenco di
# lavoro; riparati tutti i punti, diventa una guardia: un conteggio nuovo che
# risponde zero da un catch, senza il marcatore ZERO-E-ZERO e la ragione, non
# esce dal banco di lavoro. Si prova prima di credergli (--provami).
zero="$qui/../zero-o-non-lo-so.js"
if [ -f "$zero" ]; then
    node "$zero" --provami > /dev/null
    if [ $? -ne 0 ]; then
        node "$zero" --provami | grep -E 'DA GUARDARE|!  |NON SI COMPORTA' >&2
        echo "" >&2
        echo "pre-push: FERMO. Un conteggio dice zero dove vorrebbe dire «non lo so»." >&2
        echo "Si ripara con -1 o null, oppure col marcatore ZERO-E-ZERO: e la ragione." >&2
        exit 1
    fi
fi

# THE LANGUAGE GATE (entry W3.1-bis.1). The Italian in the repository may go
# down, never up. The CI is the real gate; this runs the same script on the
# commits being PUSHED (read from git, not from the working tree, so work not
# yet committed changes nothing): every commit against its parent, with the
# rules of the parent, and a raise only with the trailer
# "Language-Baseline-Raise:" on the commit that raises. Then, on each pushed
# tip, --tighten: if the Italian went down and baseline.json was not lowered,
# the push stops until the lower baseline is committed, so the ratchet closes
# on what was just translated.
language_gate="$qui/../lingua/detect-italian.js"
language_step="$qui/../../.github/passi/language-gate.ps1"
if [ ! -f "$language_gate" ] || [ ! -f "$language_step" ]; then
    echo "pre-push: cannot find $language_gate or $language_step - the hook does not know what to run." >&2
    exit 1
fi
zeros=0000000000000000000000000000000000000000
if [ -z "$pushed_refs" ]; then pushed_refs="HEAD $(git rev-parse HEAD) HEAD $zeros"; fi
echo "$pushed_refs" | while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    [ "$local_sha" = "$zeros" ] && continue   # a branch being deleted
    if [ "$remote_sha" = "$zeros" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        # a new branch: judge what it adds to origin/main, or its tip alone
        remote_sha=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
    fi
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$language_step" -Head "$local_sha" -Base "$remote_sha"
    if [ $? -ne 0 ]; then
        echo "" >&2
        echo "pre-push: STOPPED. The language gate says above which commit grew (or why it" >&2
        echo "cannot run). New text is written in English." >&2
        exit 1
    fi
    node "$language_gate" --rev "$local_sha" --config-rev "$local_sha" --baseline "git:$local_sha" --tighten --quiet
    gate_exit=$?
    if [ $gate_exit -eq 3 ]; then
        echo "" >&2
        echo "pre-push: STOPPED. The Italian went down at $local_sha but Controlli/lingua/baseline.json" >&2
        echo "was not lowered: run node Controlli/lingua/detect-italian.js --tighten, commit, push again." >&2
        exit 1
    fi
    if [ $gate_exit -ne 0 ]; then
        echo "" >&2
        echo "pre-push: STOPPED. The tree of $local_sha is not within its own baseline (see above)." >&2
        exit 1
    fi
done || exit 1

powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$controllo"
esito=$?

if [ $esito -ne 0 ]; then
    echo "" >&2
    echo "pre-push: FERMO. Sopra c'e' scritto cosa uscirebbe e da dove." >&2
    echo "  albero:  si ripara e si rifa' il commit." >&2
    echo "  storia:  Controlli\\bonifica-storia.js, PRIMA del push." >&2
    echo "           Dopo diventa un force-push." >&2
    echo "" >&2
    echo "Se e' un falso positivo, si allarga l'eccezione nel controllo e si" >&2
    echo "scrive perche'. Non si usa --no-verify per farlo tacere." >&2
    exit 1
fi

exit 0
