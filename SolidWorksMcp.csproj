<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Exe</OutputType>
    <RootNamespace>SolidWorksMcp</RootNamespace>
    <AssemblyName>SolidWorksMcp</AssemblyName>
    <!-- .NET Framework 4.8 non e' una scelta di gusto: l'add-in vero e'
         compilato per quello, e questo ponte lo carica per riflessione. -->
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <!-- x64 come SolidWorks: un processo a 32 bit non si aggancia. -->
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>bin\</OutputPath>
    <LangVersion>7.3</LangVersion>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Dove sta SOLIDWORKS: serve solo per le interop, che NON entrano nel
         pacchetto (Private=False). Si scavalca con /p:SwInstallPath=... -->
    <SwInstallPath Condition="'$(SwInstallPath)' == ''">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS</SwInstallPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- LE OPERAZIONI DI DISEGNO, CHIAMATE E NON RIFLESSE.
         Fino alla 0.5.0 il ponte caricava OpenPDM.SwAddin.dll a mano,
         perche' quella DLL e' privata e questo repository non poteva
         referenziarla. Adesso la libreria sta qui dentro: e' un riferimento
         di progetto come un altro, e i nomi dei tipi li controlla il
         compilatore invece del cliente. -->
    <ProjectReference Include="Riscontro.Disegno\Riscontro.Disegno.csproj">
      <Project>{7B3C1F42-9A5E-4D18-A6C2-51E0D7B44A93}</Project>
      <Name>Riscontro.Disegno</Name>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Interop di SOLIDWORKS: il ponte passa ISldWorks e IModelDoc2
         tipizzati alla libreria. Private=False, quindi restano dove le ha
         messe l'installazione e non finiscono ne' nel repository ne' nel
         pacchetto. -->
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SwInstallPath)\api\redist\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SwInstallPath)\api\redist\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Programma.cs" />
    <Compile Include="Mcp\Protocollo.cs" />
    <Compile Include="Ponte\Sessione.cs" />
    <Compile Include="Ponte\Percorsi.cs" />
    <Compile Include="Ponte\Forma.cs" />
    <Compile Include="Strumenti\Catalogo.cs" />
    <Compile Include="Strumenti\Attrezzi.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Il catalogo viaggia con l'eseguibile: senza, il ponte sa eseguire ma
         non sa dire cosa si puo' chiedere. -->
    <None Include="Strumenti\catalogo.json">
      <Link>catalogo.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="App.config" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
