  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <!-- ===================================================================
       THE CHECKS THAT RUN WITHOUT SOLIDWORKS (entry F7)

       A PROJECT OF ITS OWN, AND NOT A MODE OF `Oce.Solid.Agent.Bench.exe`. The csproj
       of the bench resolves the interop with a `HintPath` inside
       `...\SOLIDWORKS\api\redist`: on a machine without SOLIDWORKS that
       path does not exist and the BUILD fails. A flag is not enough —
       the problem is before the runtime.

       THERE IS NO REFERENCE TO `SolidWorks.Interop.*` IN HERE, and
       it is not a preference: it is the check. If somebody adds one,
       this project stops being what it says it is, and the
       simplest way to notice is that it no longer builds elsewhere.

       What is needed from the library and from the bridge is taken by REFLECTION
       or by talking to them over stdio, as any customer would.
       ===================================================================-->

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Exe</OutputType>
    <RootNamespace>Oce.Solid.Agent.ContractTests</RootNamespace>
    <AssemblyName>Oce.Solid.Agent.ContractTests</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <!-- x64 LIKE THE BRIDGE, and it is not a matter of taste: an `AnyCPU`
         executable on .NET Framework starts as 32-bit (`Prefer32Bit` is true by
         default), and loading the x64 image of the bridge from a 32-bit process
         gives `BadImageFormatException` — a message that speaks of «file or
         assembly could not be loaded» and looks like a missing file.-->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <LangVersion>7.3</LangVersion>
    <!-- Two builds of the same source give the same bytes (W3.1-bis.2,
         Checks\language\same-il.ps1). -->
    <Deterministic>true</Deterministic>
    <!-- [CallerFilePath] of the bench recorders gives the path as seen from the
         repository, not the absolute path of this checkout: the same source
         builds the same bytes in any folder (W3.1-bis.2, item 7). -->
    <PathMap>$(MSBuildProjectDirectory)=Tests</PathMap>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

