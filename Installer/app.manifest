<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="SolidWorksMcp.Installa" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!--
          NIENTE ELEVAZIONE, ED E' UNA SCELTA.

          Questo installatore scrive in due posti, tutti e due dell'utente:
          %LOCALAPPDATA% per i file del ponte, e la configurazione del client
          MCP. Non tocca Program Files, non scrive nel registro di macchina,
          non registra componenti COM.

          Chiedere l'amministratore quando non serve e' il modo piu' rapido di
          insegnare a chi installa che il prompt dell'UAC si clicca senza
          leggerlo. E in molte officine il progettista l'amministratore non ce
          l'ha proprio: un installatore che lo chiede non si puo' usare.
        -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11. Senza questa dichiarazione, le API di versione
           mentono e riportano 6.2 (Windows 8). -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Senza questo, su uno schermo 4K la finestra esce sfocata e i
           controlli si sovrappongono. Un progettista CAD lo schermo grande
           ce l'ha sempre. -->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">permonitorv2,permonitor</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
