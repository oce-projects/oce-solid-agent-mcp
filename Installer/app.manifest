<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="Oce.Solid.Agent.Installer" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!--
          NO ELEVATION, AND IT IS A CHOICE.

          This installer writes in two places, both belonging to the user:
          %LOCALAPPDATA% for the bridge files, and the configuration of the MCP
          client. It does not touch Program Files, does not write to the machine
          registry, does not register COM components.

          Asking for the administrator when it is not needed is the quickest way to
          teach whoever installs that the UAC prompt is clicked without
          reading it. And in many workshops the designer does not have the administrator
          at all: an installer that asks for it cannot be used.
        -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11. Without this declaration, the version APIs
           lie and report 6.2 (Windows 8).-->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Without this, on a 4K screen the window comes out blurred and the
           controls overlap. A CAD designer always has
           the big screen.-->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">permonitorv2,permonitor</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
