<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <!-- WinExe and not Exe: without it, a black prompt window opens behind
         the installer window, and the first impression of an
         installer is half of its job.-->
    <OutputType>WinExe</OutputType>
    <RootNamespace>Oce.Solid.Agent.Installer</RootNamespace>
    <AssemblyName>Installer</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <!-- x64 like the bridge and like SOLIDWORKS. The installer reads the 64 bit
         DLL version: a 32 bit process would see another view of the
         registry and another Program Files.-->
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>..\bin\</OutputPath>
    <LangVersion>7.3</LangVersion>
    <!-- Two builds of the same source give the same bytes, like the bridge
         and the library: without it every build of Installer.exe differs and
         nobody can check the published file against the source. -->
    <Deterministic>true</Deterministic>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <WarningLevel>4</WarningLevel>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Steps.cs" />
    <Compile Include="Payload.cs" />
    <Compile Include="Configuration.cs" />
    <Compile Include="Window.cs" />
    <Compile Include="Output.cs" />
    <Compile Include="ClaudeCli.cs" />
    <Compile Include="Verify.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="app.manifest" />
  </ItemGroup>
  <ItemGroup>
    <!--
      THE BRIDGE INSIDE THE INSTALLER.

      Everything in Payload\ becomes an embedded resource, so that
      `Installer.exe` is A SINGLE FILE: download, double click, done. No
      zip to unpack, no «put this next to that».

      The folder is empty in the repository and build.ps1 fills it right before
      compiling. If it is empty, the installer compiles all the same and looks for the files
      next to itself: it is the way the developer works, without having to
      maintain two different roads.

      The add-in is NOT put here: it is private code, and a public installer
      that carries it around publishes it.
    -->
    <EmbeddedResource Include="Payload\**\*" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!-- THE WIN32 VERSION FROM VERSION.txt (entry H14): same rule as the bridge.
       Right click -> Properties -> Details on Installer.exe said 0.0.0.0.-->
  <Target Name="VersionFromFile" BeforeTargets="CoreCompile">
    <ReadLinesFromFile File="$(MSBuildThisFileDirectory)..\VERSION.txt">
      <Output TaskParameter="Lines" PropertyName="BridgeVersion" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <BridgeVersion>$(BridgeVersion.Trim())</BridgeVersion>
      <VersionFile>$(IntermediateOutputPath)Version.g.cs</VersionFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(VersionFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
      Lines="[assembly: System.Reflection.AssemblyVersion(&quot;$(BridgeVersion).0&quot;)];[assembly: System.Reflection.AssemblyFileVersion(&quot;$(BridgeVersion).0&quot;)];[assembly: System.Reflection.AssemblyInformationalVersion(&quot;$(BridgeVersion)&quot;)]" />
    <ItemGroup>
      <Compile Include="$(VersionFile)" />
      <FileWrites Include="$(VersionFile)" />
    </ItemGroup>
  </Target>
</Project>
