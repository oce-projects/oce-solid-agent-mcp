{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "C:\\Lavoro"],
      "env": { "FS_ROOT": "C:\\Lavoro" }
    },
    "github": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "ghcr.io/github/github-mcp-server"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "finto-per-la-prova" }
    }
  },
  "altreImpostazioniDelClient": {
    "tema": "scuro",
    "scalaDelTesto": 1.1
  }
}
