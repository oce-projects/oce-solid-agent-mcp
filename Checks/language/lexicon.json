 "italian_suffixes": [
  {
   "pattern": "zion[ei]",
   "prose": true,
   "note": "creazione, operazioni: English never ends in -zione"
  },
  {
   "pattern": "ment[oi]",
   "prose": true,
   "note": "spostamento, avanzamenti"
  },
  {
   "pattern": "(?:ab|ib)il[ei]",
   "prose": true,
   "note": "leggibile, disponibili"
  },
  {
   "pattern": "(?:at|it|ut|tt)or[ei]",
   "prose": true,
   "note": "esecutore, contatori, lettore"
  },
  {
   "pattern": "ezz[ae]",
   "prose": true,
   "note": "larghezza, lunghezze"
  },
  {
   "pattern": "aggi?o",
   "prose": true,
   "note": "salvataggio, ancoraggi"
  },
  {
   "pattern": "mente",
   "prose": true,
   "note": "automaticamente"
  },
  {
   "pattern": "(?:at|it|ut)ura",
   "prose": true,
   "note": "foratura, tornitura: the workshop operations (the plural -ure is English: signature, feature, future)"
  },
  {
   "pattern": "(?:[a-z]{3})(?:ita)",
   "note": "proprieta, velocita (the ASCII form of -ita with the accent); names only: Anita, Margarita"
  },
  {
   "pattern": "(?:[a-z]{2})(?:ando|endo)",
   "note": "gerunds: misurando, leggendo; names only: commando, crescendo"
  },
  {
   "pattern": "[bcdfglmnprstvz]one",
   "note": "bullone, mattone; names only, with english_allow for milestone, standalone..."
  },
  {
   "pattern": "ell[ae]",
   "note": "rondella, tabelle; names only"
  },
  {
   "pattern": "ett[oi]",
   "note": "cuscinetto, oggetti; names only"
  },
  {
   "pattern": "tric[ei]",
   "note": "piegatrice, matrici; names only"
  }
 ],
