#!/bin/sh
# What must not leave this machine, checked AT THE MOMENT in which it
# would be about to leave.
#
# WHY A HOOK AND NOT A LINE IN A LIST.
#
# On 14 September 2026 `check-publishability.ps1` already existed, was already
# right, and one minute before the first push said «Pulito» about the tree while the
# history still carried a network path in 155 places over 41 commits. The
# check did not fail: what failed was that somebody ran it.
#
# A check that is run when one remembers is a check that is not
# run on the day that counts - which is always the day when one is in a hurry.
# Here git runs it, and if it is red the push does not start.
#
# HOW IT IS TURNED ON (once per clone, git does not version .git/hooks):
#
#     .\Checks\install-hooks.ps1
#
# HOW IT IS BYPASSED, when it is really needed:
#
#     git push --no-verify
#
# It is bypassed by hand and one knows one has done it. It is different from never having
# turned it on.

# The hook sits in Checks/hooks/, the check one level up in Checks/.
# It is derived from $0 and not from the current folder: git runs the hooks from the root
# of the working tree, but a `sh Checks/hooks/pre-push` run by hand does not, and a
# hook that works only when git calls it cannot be tested.
qui=$(dirname "$0")

# The refs being pushed arrive on stdin ("<local ref> <local sha> <remote ref>
# <remote sha>" per line). They are read first, before any command below can
# consume stdin; run by hand without a pipe, the hook judges HEAD.
if [ -t 0 ]; then pushed_refs=""; else pushed_refs=$(cat); fi
controllo="$qui/../check-publishability.ps1"
workflow="$qui/../check-workflow.ps1"

if [ ! -f "$controllo" ]; then
    echo "pre-push: non trovo $controllo - il gancio non sa cosa lanciare." >&2
    exit 1
fi
if [ ! -f "$workflow" ]; then
    echo "pre-push: non trovo $workflow - il gancio non sa cosa lanciare." >&2
    exit 1
fi

# -NoProfile: the profile of whoever works must not be able to change the outcome.
# -ExecutionPolicy Bypass: the hook must work also on a machine that
# has never unblocked scripts, otherwise the first who clones turns it off.
# THE CI POWERSHELL, FIRST (entry F9-bis). It costs a tenth of a second and
# catches the thing that the CI, for years, could not catch by itself: a
# step that cannot be read. The push is the right moment because that is where the
# CI starts to exist.
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$workflow"
if [ $? -ne 0 ]; then
    echo "" >&2
    echo "pre-push: FERMO. Un passo della CI non si legge, o non lo chiama" >&2
    echo "nessuno. Sopra c'e' scritto quale." >&2
    exit 1
fi

# THE TODO AGAINST REALITY (23/9/2026).
#
# Two probes that read only files of the repository: do the paths that the TODO cites
# still exist? do the internal cross-references («see K17») point to a real entry?
#
# They were born because a file of 16,000 lines rots in silence, and the day
# in which I wrote them they found **one broken cross-reference and four wrong
# API signatures**. But a probe that is run when one remembers is a probe
# that is not run: here git runs it, like the rest.
#
# The two probes on the interops (`todo-signatures.ps1`,
# `signatures-api.ps1`) are NOT there: they want SOLIDWORKS installed, and a hook that fails
# on a machine without CAD is a hook that the first who clones deactivates.
for sonda in todo-paths.js todo-references.js todo-lines.js; do
    if [ -f "$qui/../$sonda" ]; then
        node "$qui/../$sonda"
        if [ $? -ne 0 ]; then
            echo "" >&2
            echo "pre-push: FERMO. $sonda ha trovato qualcosa nel TODO." >&2
            exit 1
        fi
    fi
done

# ZERO OR «I DO NOT KNOW» (entry Z-C8). Until 25/9/2026 it was only a list of
# work; with all the points repaired, it becomes a guard: a new count that
# answers zero from a catch, without the marker ZERO-E-ZERO and the reason, does not
# leave the workbench. It is tested before being believed (--provami).
zero="$qui/../zero-or-unknown.js"
if [ -f "$zero" ]; then
    node "$zero" --provami > /dev/null
    if [ $? -ne 0 ]; then
        node "$zero" --provami | grep -E 'DA GUARDARE|!  |NON SI COMPORTA' >&2
        echo "" >&2
        echo "pre-push: FERMO. Un conteggio dice zero dove vorrebbe dire «non lo so»." >&2
        echo "Si ripara con -1 o null, oppure col marcatore ZERO-E-ZERO: e la ragione." >&2
        exit 1
    fi
fi

# THE NETS OF W3.1-bis.2, seen failing on every push. Each one has a
# self-test that feeds it fake cases, one per way of failing, and expects red
# where it must and green where it must: token-stream.js (the token streams
# of C#, JavaScript and PowerShell), expected-keys-test.js (every JSON reader
# of the checks exits 1 when an expected key is missing), same-il.ps1 (the
# disassembled assemblies) and name-map-extract.js (the checks of the name
# map of W3.1-bis.3). A self-test that cannot run on this machine (no
# Roslyn, no ildasm: exit 2) is said and does not stop the push, for the same
# reason the interop probes are not here; one that runs and is not as
# expected does.
net_check() {
    net_name="$1"; shift
    net_out=$("$@" 2>&1)
    net_code=$?
    if [ $net_code -eq 2 ]; then
        echo "pre-push: $net_name cannot run here (exit 2), not checked:" >&2
        echo "$net_out" | tail -n 3 >&2
        return 0
    fi
    if [ $net_code -ne 0 ]; then
        echo "$net_out" | grep -E 'XX|NOT|INCOMPLETE|cannot' >&2
        echo "" >&2
        echo "pre-push: STOPPED. The self-test of $net_name is not as expected (see above)." >&2
        return 1
    fi
    return 0
}
net_check token-stream.js node "$qui/../language/token-stream.js" --self-test || exit 1
net_check expected-keys-test.js node "$qui/../expected-keys-test.js" || exit 1
net_check same-il.ps1 powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$qui/../language/same-il.ps1" -SelfTest || exit 1
net_check name-map-extract.js node "$qui/../language/name-map-extract.js" --self-test || exit 1

# THE LANGUAGE GATE (entry W3.1-bis.1). The Italian in the repository may go
# down, never up. The CI is the real gate; this runs the same script on the
# commits being PUSHED (read from git, not from the working tree, so work not
# yet committed changes nothing): every commit against its parent, with the
# rules of the parent, and a raise only with the trailer
# "Language-Baseline-Raise:" on the commit that raises. Then, on each pushed
# tip, --tighten: if the Italian went down and baseline.json was not lowered,
# the push stops until the lower baseline is committed, so the ratchet closes
# on what was just translated.
language_gate="$qui/../language/detect-italian.js"
language_step="$qui/../../.github/steps/language-gate.ps1"
if [ ! -f "$language_gate" ] || [ ! -f "$language_step" ]; then
    echo "pre-push: cannot find $language_gate or $language_step - the hook does not know what to run." >&2
    exit 1
fi
zeros=0000000000000000000000000000000000000000
if [ -z "$pushed_refs" ]; then pushed_refs="HEAD $(git rev-parse HEAD) HEAD $zeros"; fi
echo "$pushed_refs" | while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    [ "$local_sha" = "$zeros" ] && continue   # a branch being deleted
    if [ "$remote_sha" = "$zeros" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        # a new branch: judge what it adds to origin/main, or its tip alone
        remote_sha=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
    fi
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$language_step" -Head "$local_sha" -Base "$remote_sha"
    if [ $? -ne 0 ]; then
        echo "" >&2
        echo "pre-push: STOPPED. The language gate says above which commit grew (or why it" >&2
        echo "cannot run). New text is written in English." >&2
        exit 1
    fi
    node "$language_gate" --rev "$local_sha" --config-rev "$local_sha" --baseline "git:$local_sha" --tighten --quiet
    gate_exit=$?
    if [ $gate_exit -eq 3 ]; then
        echo "" >&2
        echo "pre-push: STOPPED. The Italian went down at $local_sha but Checks/language/baseline.json" >&2
        echo "was not lowered: run node Checks/language/detect-italian.js --tighten, commit, push again." >&2
        exit 1
    fi
    if [ $gate_exit -ne 0 ]; then
        echo "" >&2
        echo "pre-push: STOPPED. The tree of $local_sha is not within its own baseline (see above)." >&2
        exit 1
    fi
done || exit 1

powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$controllo"
esito=$?

if [ $esito -ne 0 ]; then
    echo "" >&2
    echo "pre-push: FERMO. Sopra c'e' scritto cosa uscirebbe e da dove." >&2
    echo "  albero:  si ripara e si rifa' il commit." >&2
    echo "  storia:  Checks\\cleanup-history.js, PRIMA del push." >&2
    echo "           Dopo diventa un force-push." >&2
    echo "" >&2
    echo "Se e' un falso positivo, si allarga l'eccezione nel controllo e si" >&2
    echo "scrive perche'. Non si usa --no-verify per farlo tacere." >&2
    exit 1
fi

exit 0
