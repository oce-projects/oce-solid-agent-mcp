    <!-- IL VALUTATORE DELLE ATTESE, lo stesso file che compila il banco.
         Non una copia: una copia diverge, e il giorno che diverge la suite
         col CAD comincia a passare per ragioni che qui non si vedono. -->
    <Compile Include="..\Banco\Attese.cs">
      <Link>Attese.cs</Link>
    </Compile>
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
