    <Compile Include="ProveIRifiuti.cs" />
    <Compile Include="ProveIlDocumentoRichiesto.cs" />
    <Compile Include="ProveICampiObbligatori.cs" />
    <Compile Include="ProveGliEsempi.cs" />
    <Compile Include="ProveLeImmagini.cs" />
    <Compile Include="ProveIlGuinzaglio.cs" />
    <Compile Include="ProveLaProvaAVuoto.cs" />
