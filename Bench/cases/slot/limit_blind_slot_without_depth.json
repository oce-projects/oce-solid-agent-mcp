{
  "name": "limit_blind_slot_without_depth",
  "family": "slot",
  "why": "Cieca senza dire quanto: non c'e' nessun valore predefinito ragionevole, e sceglierne uno vorrebbe dire decidere al posto di chi disegna quanto materiale togliere.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "front", "length_mm": 200, "width_mm": 120, "thickness_mm": 20, "centered": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 480000 } ] },
    { "operation": "slot",
      "arguments": { "face_uid": "@face(normal=front)", "x_mm": 0, "y_mm": 0, "length_mm": 51, "width_mm": 11, "angle_deg": 0, "through_all": false },
      "must_fail": {
        "message_includes": ["non passante senza profondita"],
        "volume_unchanged": true,
        "no_extra_feature": true,
        "twin": "blind_slot" } }
  ]
}
