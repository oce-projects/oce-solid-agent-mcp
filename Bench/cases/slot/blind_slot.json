{
  "name": "blind_slot",
  "family": "slot",
  "why": "La stessa asola, cieca da 5. Qui il confronto e' un'uguaglianza esatta -- area per profondita' -- e non un tetto: su un taglio cieco il materiale sotto non c'entra.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "front", "length_mm": 200, "width_mm": 120, "thickness_mm": 20, "centered": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 480000 } ] },
    { "operation": "slot",
      "arguments": { "face_uid": "@face(normal=front)", "x_mm": 0, "y_mm": 0, "length_mm": 51, "width_mm": 11, "angle_deg": 0, "through_all": false, "depth_mm": 5 },
      "expect": [
        { "what": "measurements.material_removed_mm3", "equal_to": 2675.17, "tolerance": 0.5,
          "tolerance_why": "535,0332 per 5: il conto ha pi dentro" },
        { "what": "volume_mm3", "equal_to": 477324.83, "tolerance": 0.5,
          "tolerance_why": "come sopra" } ] }
  ]
}
