{
  "name": "limit_slot_outside_the_part",
  "family": "slot",
  "why": "Entirely outside the part: the cut removes nothing, and that must be said. Up to 0.42.0 the answer was «the cut was not created», identical to that of a profile that is too big -- two opposite things to do, move or shrink, and the message did not say which.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "front", "length_mm": 200, "width_mm": 120, "thickness_mm": 20, "centered": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 480000 } ] },
    { "operation": "slot",
      "arguments": { "face_uid": "@face(normal=front)", "x_mm": 400, "y_mm": 0, "length_mm": 51, "width_mm": 11, "angle_deg": 0, "through_all": true },
      "must_fail": {
        "message_includes": ["falls entirely outside the material", "-100 to 100"],
        "volume_unchanged": true,
        "no_extra_feature": true,
        "twin": "off_center_slot" } }
  ]
}
