{
  "name": "two_equal_bases_one_step",
  "family": "assemblies",
  "why": "ADVERSARIAL REVIEW OF 27/9/2026, finding on the STEP of the assembly. The count of the expected solids summed the bodies of every INSTANCE; the STEP of an assembly writes the structure, and the shape of a part that appears twice might be there only once. The bench case had two DIFFERENT parts and the third instance suppressed: it could not see it. Here the base appears twice (the second inserted by the step), the cover once. The case MEASURES how many solids the STEP writes; the mass of the assembly counts the instances.",
  "defect_caught": "A correct STEP refused because the solids are counted per instance.",
  "assembly": {
    "components": [
      {
        "name": "base",
        "steps": [
          {
            "operation": "extrude_rectangle",
            "arguments": {
              "plane": "top",
              "length_mm": 120,
              "width_mm": 80,
              "thickness_mm": 10,
              "centered": true
            }
          },
          {
            "operation": "apply_material",
            "arguments": {
              "material": "AISI 304"
            }
          }
        ]
      },
      {
        "name": "coperchio",
        "position_mm": [
          0,
          7,
          0
        ],
        "steps": [
          {
            "operation": "extrude_rectangle",
            "arguments": {
              "plane": "top",
              "length_mm": 120,
              "width_mm": 80,
              "thickness_mm": 4,
              "centered": true
            }
          },
          {
            "operation": "apply_material",
            "arguments": {
              "material": "S235JR"
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "operation": "insert_component",
      "arguments": {
        "path": "{LAVORO}\\two_equal_bases_one_step_base.sldprt",
        "x_mm": 200,
        "y_mm": 0,
        "z_mm": 0
      },
      "expect": [
        {
          "what": "measurements.components_after",
          "equal_to": 3
        }
      ]
    },
    {
      "operation": "mass_properties",
      "arguments": {},
      "expect": [
        {
          "what": "measurements.mass_kg",
          "equal_to": 1.8355,
          "tolerance": 0.0001,
          "tolerance_why": "rounded to four decimals: 2 x 0.768 + 0.29952 = 1.83552",
          "why": "the mass counts the INSTANCES: two bases weigh twice"
        },
        {
          "what": "measurements.components_weighed",
          "equal_to": 3
        }
      ]
    },
    {
      "operation": "export_step",
      "arguments": {
        "path": "{LAVORO}\\two_equal_bases_one_step.step"
      },
      "expect": [
        {
          "what": "measurements.solids_in_file",
          "equal_to": 2,
          "why": "MEASURED on 28/9/2026: with the base twice and the cover once, the STEP has 2 solids — the shape of a part is written only once, the instances are occurrences"
        },
        {
          "what": "measurements.solids_expected",
          "equal_to": 2,
          "why": "the UNIQUE parts (path and configuration), not the instances"
        }
      ]
    }
  ]
}
