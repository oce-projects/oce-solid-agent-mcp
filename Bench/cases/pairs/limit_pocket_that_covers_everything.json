{
  "name": "limit_pocket_that_covers_everything",
  "family": "pairs",
  "why": "A THROUGH 400 x 400 pocket on a part that occupies 314 x 274 would leave nothing. The twin is the same pocket blind at 5, which instead shortens the part and is legitimate: the two differ by ONE argument only, «through_all», and that is what the check must look at.",
  "start": { "new_part": true },
  "steps": [
    {
      "operation": "extrude_rectangle",
      "arguments": {
        "plane": "front",
        "length_mm": 314,
        "width_mm": 274,
        "thickness_mm": 52,
        "centered": true
      },
      "expect": [
        { "what": "volume_mm3", "equal_to": 4473872 },
        { "what": "state.bounding_box_from_mm", "equal_to": [-157, -137, 0] }
      ]
    },
    {
      "operation": "rectangular_cut",
      "arguments": {
        "face_uid": "@face(normal=front)",
        "x_mm": 0,
        "y_mm": 0,
        "length_mm": 400,
        "width_mm": 400,
        "through_all": true,
        "depth_mm": 5
      },
      "must_fail": {
        "message_includes": ["covers the whole part", "314 x 274"],
        "volume_unchanged": true,
        "no_extra_feature": true,
        "twin": "blind_pocket_400"
      }
    }
  ]
}
