{
  "name": "limit_slot_that_covers_everything",
  "family": "pairs",
  "why": "A through 500 x 300 slot on a part that occupies 314 x 274 would leave nothing. The twin is the same slot reduced to 30 x 9, which is the real slot of the trade: they differ by two arguments, the length and the width, and they are the two that the check looks at.",
  "start": { "new_part": true },
  "steps": [
    {
      "operation": "extrude_rectangle",
      "arguments": {
        "plane": "front",
        "length_mm": 314,
        "width_mm": 274,
        "thickness_mm": 52,
        "centered": true
      },
      "expect": [
        { "what": "volume_mm3", "equal_to": 4473872 },
        { "what": "state.bounding_box_from_mm", "equal_to": [-157, -137, 0] }
      ]
    },
    {
      "operation": "slot",
      "arguments": {
        "face_uid": "@face(normal=front)",
        "x_mm": 0,
        "y_mm": 0,
        "length_mm": 500,
        "width_mm": 300,
        "through_all": true
      },
      "must_fail": {
        "message_includes": ["covers the whole part", "314 x 274"],
        "volume_unchanged": true,
        "no_extra_feature": true,
        "twin": "slot_30x9"
      }
    }
  ]
}
