{
  "name": "hole_270_on_face_274",
  "family": "pairs",
  "why": "La gemella di «limit_hole_that_covers_everything»: un foro da 270 su una faccia larga 274 LASCIA 2 mm di materiale per lato, ed e' legittimo. Senza questa, «il controllo funziona» e «il controllo rifiuta tutto» darebbero lo stesso verde.",
  "start": { "new_part": true },
  "steps": [
    {
      "operation": "extrude_rectangle",
      "arguments": {
        "plane": "front",
        "length_mm": 314,
        "width_mm": 274,
        "thickness_mm": 52,
        "centered": true
      },
      "expect": [
        { "what": "volume_mm3", "equal_to": 4473872 },
        { "what": "state.bounding_box_from_mm", "equal_to": [-157, -137, 0] },
        { "what": "bounding_box_mm", "equal_to": [314, 274, 52] }
      ]
    },
    {
      "operation": "cylindrical_cut",
      "arguments": {
        "face_uid": "@face(normal=front)",
        "x_mm": 0,
        "y_mm": 0,
        "diameter_mm": 270,
        "through_all": true
      },
      "expect": [
        { "what": "measurements.removed_mm3", "equal_to": 2977287.37,
          "tolerance": 0.5,
          "tolerance_why": "pi*135^2*52: il conto ha pi dentro, e l'operazione arrotonda al centesimo" },
        { "what": "bodies", "equal_to": 1 }
      ]
    }
  ]
}
