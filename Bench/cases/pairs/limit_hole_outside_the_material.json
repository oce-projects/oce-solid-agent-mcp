{
  "name": "limit_hole_outside_the_material",
  "family": "pairs",
  "why": "A hole centred at (5000, 5000) on a part that in X goes from -157 to 157: the profile falls entirely outside, there is nothing to remove. It is the twin of the 500 hole: two different defects that up to 0.42.0 gave THE SAME SENTENCE, and the two things to do are opposite.",
  "start": { "new_part": true },
  "steps": [
    {
      "operation": "extrude_rectangle",
      "arguments": {
        "plane": "front",
        "length_mm": 314,
        "width_mm": 274,
        "thickness_mm": 52,
        "centered": true
      },
      "expect": [
        { "what": "volume_mm3", "equal_to": 4473872 },
        { "what": "state.bounding_box_from_mm", "equal_to": [-157, -137, 0] }
      ]
    },
    {
      "operation": "cylindrical_cut",
      "arguments": {
        "face_uid": "@face(normal=front)",
        "x_mm": 5000,
        "y_mm": 5000,
        "diameter_mm": 60,
        "through_all": true
      },
      "must_fail": {
        "message_includes": ["falls entirely outside the material", "-157 to 157"],
        "volume_unchanged": true,
        "no_extra_feature": true,
        "twin": "hole_60_on_the_border"
      }
    }
  ]
}
