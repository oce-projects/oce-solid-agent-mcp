{
  "name": "limit_hole_outside_the_material",
  "family": "pairs",
  "why": "Un foro centrato a (5000, 5000) su un pezzo che su X va da -157 a 157: il profilo cade tutto fuori, non c'e' niente da togliere. E' il gemello del foro da 500: due difetti diversi che fino alla 0.42.0 davano LA STESSA FRASE, e le due cose da fare sono opposte.",
  "start": { "new_part": true },
  "steps": [
    {
      "operation": "extrude_rectangle",
      "arguments": {
        "plane": "front",
        "length_mm": 314,
        "width_mm": 274,
        "thickness_mm": 52,
        "centered": true
      },
      "expect": [
        { "what": "volume_mm3", "equal_to": 4473872 },
        { "what": "state.bounding_box_from_mm", "equal_to": [-157, -137, 0] }
      ]
    },
    {
      "operation": "cylindrical_cut",
      "arguments": {
        "face_uid": "@face(normal=front)",
        "x_mm": 5000,
        "y_mm": 5000,
        "diameter_mm": 60,
        "through_all": true
      },
      "must_fail": {
        "message_includes": ["cade tutto fuori dal materiale", "-157 a 157"],
        "volume_unchanged": true,
        "no_extra_feature": true,
        "twin": "hole_60_on_the_border"
      }
    }
  ]
}
