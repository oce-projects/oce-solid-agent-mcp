{
  "name": "slot_30x9",
  "family": "pairs",
  "why": "The twin of «limit_slot_that_covers_everything». A 30 x 9 slot is the real slot of the trade -- the one that allows assembly -- and the removed material is counted exactly: area 21x9 + pi*4.5^2 = 252.6173 mm2, over the 52 of thickness.",
  "start": { "new_part": true },
  "steps": [
    {
      "operation": "extrude_rectangle",
      "arguments": {
        "plane": "front",
        "length_mm": 314,
        "width_mm": 274,
        "thickness_mm": 52,
        "centered": true
      },
      "expect": [
        { "what": "volume_mm3", "equal_to": 4473872 },
        { "what": "state.bounding_box_from_mm", "equal_to": [-157, -137, 0] }
      ]
    },
    {
      "operation": "slot",
      "arguments": {
        "face_uid": "@face(normal=front)",
        "x_mm": 0,
        "y_mm": 0,
        "length_mm": 30,
        "width_mm": 9,
        "through_all": true
      },
      "expect": [
        { "what": "measurements.area_mm2", "equal_to": 252.62,
          "tolerance": 0.01,
          "tolerance_why": "21*9 + pi*4.5^2 = 252.6173: the operation rounds to the hundredth" },
        { "what": "measurements.material_removed_mm3", "equal_to": 13136.1,
          "tolerance": 0.5,
          "tolerance_why": "252.6173 x 52: the calculation has pi inside" },
        { "what": "bodies", "equal_to": 1 }
      ]
    }
  ]
}
