{
  "name": "blind_pocket_400",
  "family": "pairs",
  "why": "The twin of «limit_pocket_that_covers_everything», and it says why the check needs the cut to go «all the way through»: a pocket that covers the whole face but does NOT go through shortens the part, and shortening a part is something that is done. It differs from the twin by ONE argument only: «through_all».",
  "start": { "new_part": true },
  "steps": [
    {
      "operation": "extrude_rectangle",
      "arguments": {
        "plane": "front",
        "length_mm": 314,
        "width_mm": 274,
        "thickness_mm": 52,
        "centered": true
      },
      "expect": [
        { "what": "volume_mm3", "equal_to": 4473872 },
        { "what": "state.bounding_box_from_mm", "equal_to": [-157, -137, 0] }
      ]
    },
    {
      "operation": "rectangular_cut",
      "arguments": {
        "face_uid": "@face(normal=front)",
        "x_mm": 0,
        "y_mm": 0,
        "length_mm": 400,
        "width_mm": 400,
        "through_all": false,
        "depth_mm": 5
      },
      "expect": [
        { "what": "volume_mm3", "equal_to": 4043692 },
        { "what": "bounding_box_mm", "equal_to": [314, 274, 47] },
        { "what": "bodies", "equal_to": 1 }
      ]
    }
  ]
}
