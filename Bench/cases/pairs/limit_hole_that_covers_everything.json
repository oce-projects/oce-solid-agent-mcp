{
  "name": "limit_hole_that_covers_everything",
  "family": "pairs",
  "why": "A through hole of 500 on a part that occupies 314 x 274 would leave nothing. Up to 0.42.0 the answer was «The cut was not created. The sketch is left in the part...», identical to that of the hole outside the part: two opposite things to do -- make it smaller, or move it -- and the message did not say which.",
  "start": { "new_part": true },
  "steps": [
    {
      "operation": "extrude_rectangle",
      "arguments": {
        "plane": "front",
        "length_mm": 314,
        "width_mm": 274,
        "thickness_mm": 52,
        "centered": true
      },
      "expect": [
        { "what": "volume_mm3", "equal_to": 4473872 },
        { "what": "state.bounding_box_from_mm", "equal_to": [-157, -137, 0] }
      ]
    },
    {
      "operation": "cylindrical_cut",
      "arguments": {
        "face_uid": "@face(normal=front)",
        "x_mm": 0,
        "y_mm": 0,
        "diameter_mm": 500,
        "through_all": true
      },
      "must_fail": {
        "message_includes": ["covers the whole part", "314 x 274"],
        "volume_unchanged": true,
        "no_extra_feature": true,
        "twin": "hole_270_on_face_274"
      }
    }
  ]
}
