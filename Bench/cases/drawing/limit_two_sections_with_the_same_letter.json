{
  "name": "limit_two_sections_with_the_same_letter",
  "family": "drawing",
  "why": "ENTRY Z-C13. Two sections «A-A» on the same drawing are two different cuts that look the same: whoever reads takes the wrong view for that line. SOLIDWORKS does not prevent it. The second section with the same letter is refused before drawing the line, saying the letters already used — and the letter is read from the views (IDrSection.GetLabel), the one asked for is not trusted.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "top", "length_mm": 120, "width_mm": 80, "thickness_mm": 20, "centered": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 192000 } ] },
    { "operation": "save_document",
      "arguments": { "path": "{LAVORO}\\limit_two_sections_with_the_same_letter.sldprt" },
      "expect": [ { "what": "measurements.warnings", "equal_to": 0 } ] },
    { "operation": "create_drawing", "arguments": { "paper_size": "A3" },
      "expect": [ { "what": "state.kind", "equal_to": "drawing" } ] },
    { "operation": "standard_views",
      "arguments": { "model": "{LAVORO}\\limit_two_sections_with_the_same_letter.sldprt" },
      "expect": [ { "what": "measurements.views_created", "equal_to": 3 } ] },
    { "operation": "section_view",
      "arguments": { "view": "V1", "label": "A", "offset_mm": 0 },
      "expect": [
        { "what": "measurements.hatches", "equal_to": 1, "why": "the first section is good" },
        { "what": "measurements.label_reread", "equal_to": "A", "why": "the letter read from the view, not the one asked for" } ] },
    { "operation": "section_view",
      "arguments": { "view": "V1", "label": "A", "offset_mm": 10 },
      "must_fail": {
        "message_includes": ["already belongs to the section", "Use a different letter"],
        "twin": "section_cuts_the_part" } }
  ]
}
