{
  "name": "hole_table_says_where_they_are",
  "family": "drawing",
  "why": "VOCE GT5. La piastra della tavola dimostrativa con un foro Ø20 in piu' al centro: la tabella fori sulla vista dall'alto, poi le quote. Misurato col banchetto e GUARDATO il 26/9/2026: la tabella nasce con l'origine (un vertice, marchio 1) e la faccia forata (marchio 2) selezionate — coi marchi sbagliati nasce VUOTA senza errore — e dice A1..A4 Ø8 e B1 Ø20 alle posizioni dall'angolo. La prima tavola guardata aveva i fori DUE volte (tabella e richiami): adesso drawing_dimension li lascia alla tabella.",
  "defect_caught": "Tre: la tabella di sola intestazione (i marchi scambiati), una posizione che il pezzo non ha, e i fori quotati due volte — sulla tabella e con richiami e quote di posizione sulla vista.",
  "_the_views_are_called_by_uid": "V1 frontale, V2 dall'alto (i fori come cerchi), V3 laterale: l'ordine di standard_views.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "top", "length_mm": 120, "width_mm": 80,
                     "thickness_mm": 10, "centered": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 96000 } ] },
    { "operation": "cylindrical_cut",
      "arguments": { "face_uid": "@face(normal=up)", "x_mm": -45, "y_mm": -25, "diameter_mm": 8, "through_all": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 95497.35, "tolerance": 0.05, "tolerance_why": "pi dentro" } ] },
    { "operation": "cylindrical_cut",
      "arguments": { "face_uid": "@face(normal=up)", "x_mm": 45, "y_mm": -25, "diameter_mm": 8, "through_all": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 94994.69, "tolerance": 0.05, "tolerance_why": "pi dentro" } ] },
    { "operation": "cylindrical_cut",
      "arguments": { "face_uid": "@face(normal=up)", "x_mm": 45, "y_mm": 25, "diameter_mm": 8, "through_all": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 94492.04, "tolerance": 0.05, "tolerance_why": "pi dentro" } ] },
    { "operation": "cylindrical_cut",
      "arguments": { "face_uid": "@face(normal=up)", "x_mm": -45, "y_mm": 25, "diameter_mm": 8, "through_all": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 93989.38, "tolerance": 0.05, "tolerance_why": "pi dentro" } ] },
    { "operation": "cylindrical_cut",
      "arguments": { "face_uid": "@face(normal=up)", "x_mm": 0, "y_mm": 0, "diameter_mm": 20, "through_all": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 90847.79, "tolerance": 0.05,
                    "tolerance_why": "93989,38 meno pi x 10^2 x 10 = 3141,59: pi dentro" } ] },
    { "operation": "save_document",
      "arguments": { "path": "{LAVORO}\\hole_table_says_where_they_are.sldprt" },
      "expect": [ { "what": "measurements.warnings", "equal_to": 0, "why": "una vista si aggancia al FILE del pezzo" } ] },
    { "operation": "create_drawing",
      "arguments": { "paper_size": "A3" },
      "expect": [ { "what": "state.kind", "equal_to": "drawing" } ] },
    { "operation": "standard_views",
      "arguments": { "model": "{LAVORO}\\hole_table_says_where_they_are.sldprt" },
      "expect": [ { "what": "measurements.views_created", "equal_to": 3 } ] },
    { "operation": "hole_table",
      "arguments": { "view": "V2" },
      "expect": [
        { "what": "measurements.holes", "equal_to": 5, "why": "quattro Ø8 e il Ø20: i fori della faccia che guarda chi legge" },
        { "what": "measurements.rows", "equal_to": 6, "why": "l'intestazione e un foro per riga: coi marchi scambiati sarebbe 1" },
        { "what": "measurements.positions_checked", "equal_to": true,
          "why": "ogni posizione scritta corrisponde a un foro misurato sulla vista dall'angolo in basso a sinistra: 15/15, 15/65, 105/15, 105/65, 60/40" } ] },
    { "operation": "drawing_dimension",
      "arguments": { "view": "V1" },
      "expect": [
        { "what": "measurements.holes_in_hole_table", "equal_to": 5,
          "why": "la tabella c'e', e drawing_dimension lo sa: i fori sono suoi" },
        { "what": "measurements.dimensions_mm", "includes": ["120", "10"], "why": "lunghezza e spessore" } ] },
    { "operation": "drawing_dimension",
      "arguments": { "view": "V3" },
      "expect": [
        { "what": "measurements.dimensions_mm", "includes": ["80"], "why": "la larghezza, dalla vista laterale" } ] }
  ]
}
