{
  "name": "limit_hole_table_on_the_side_view",
  "family": "drawing",
  "why": "La tabella fori chiesta sulla vista FRONTALE (V1), dove i fori della piastra si vedono di taglio come linee nascoste e nessuna faccia forata guarda verso chi legge. Si rifiuta dicendo su quale vista va — non si mette una tabella vuota.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "top", "length_mm": 120, "width_mm": 80,
                     "thickness_mm": 10, "centered": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 96000 } ] },
    { "operation": "cylindrical_cut",
      "arguments": { "face_uid": "@face(normal=up)", "x_mm": -45, "y_mm": -25, "diameter_mm": 8, "through_all": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 95497.35, "tolerance": 0.05, "tolerance_why": "pi dentro" } ] },
    { "operation": "save_document",
      "arguments": { "path": "{LAVORO}\\limit_hole_table_on_the_side_view.sldprt" },
      "expect": [ { "what": "measurements.warnings", "equal_to": 0 } ] },
    { "operation": "create_drawing",
      "arguments": { "paper_size": "A3" },
      "expect": [ { "what": "state.kind", "equal_to": "drawing" } ] },
    { "operation": "standard_views",
      "arguments": { "model": "{LAVORO}\\limit_hole_table_on_the_side_view.sldprt" },
      "expect": [ { "what": "measurements.views_created", "equal_to": 3 } ] },
    { "operation": "hole_table",
      "arguments": { "view": "V1" },
      "must_fail": {
        "message_includes": ["nessuna faccia con dei fori guarda verso chi legge", "V2"],
        "twin": "hole_table_says_where_they_are" } }
  ]
}
