{
  "name": "limit_datum_with_the_same_letter",
  "family": "drawing",
  "why": "Two datums «A» in the same drawing give no error in SOLIDWORKS, and every tolerance that cites A becomes ambiguous (the trap written in Z-E6, merged into GT6). The second one is refused, saying which letters are already there.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "top", "length_mm": 120, "width_mm": 80, "thickness_mm": 10, "centered": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 96000 } ] },
    { "operation": "save_document",
      "arguments": { "path": "{LAVORO}\\limit_datum_with_the_same_letter.sldprt" },
      "expect": [ { "what": "measurements.warnings", "equal_to": 0 } ] },
    { "operation": "create_drawing", "arguments": { "paper_size": "A3" },
      "expect": [ { "what": "state.kind", "equal_to": "drawing" } ] },
    { "operation": "standard_views",
      "arguments": { "model": "{LAVORO}\\limit_datum_with_the_same_letter.sldprt" },
      "expect": [ { "what": "measurements.views_created", "equal_to": 3 } ] },
    { "operation": "datum",
      "arguments": { "view": "V1", "side": "bottom", "letter": "A" },
      "expect": [ { "what": "measurements.letter_reread", "equal_to": "A" } ] },
    { "operation": "datum",
      "arguments": { "view": "V1", "side": "left", "letter": "A" },
      "must_fail": {
        "message_includes": ["already has a datum «A»", "ambiguous"],
        "twin": "annotations_stay_outside_the_part" } }
  ]
}
