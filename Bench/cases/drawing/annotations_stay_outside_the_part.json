{
  "name": "annotations_stay_outside_the_part",
  "family": "drawing",
  "why": "ENTRIES GT6 and GT8. On the dimensioned 120 x 80 x 10 plate: datum A on the bottom side of the front view, the surface finish Ra 3.2 on the top side, the perpendicularity 0.05 with respect to A on the right side, the flatness 0.02 on the top face (seen from above). Measured and LOOKED AT on 26/9/2026: without moving them, the surface finish ended up outside the frame (coordinates ignored), the datum flag on the other side of the edge, and then — with the dimensions in place — above the line of the 120 and the frame above the side view. Now each one is attached to its edge and sits outside the part, beyond the dimensions and outside the other views.",
  "defect_caught": "An annotation that says something else (Ra, letter, symbol, value, reference re-read) or that is not attached to anything. The POSITION was looked at in the PNG: here we demand that the annotation be attached to the edge and say what was asked.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "top", "length_mm": 120, "width_mm": 80, "thickness_mm": 10, "centered": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 96000 } ] },
    { "operation": "save_document",
      "arguments": { "path": "{LAVORO}\\annotations_stay_outside_the_part.sldprt" },
      "expect": [ { "what": "measurements.warnings", "equal_to": 0 } ] },
    { "operation": "create_drawing", "arguments": { "paper_size": "A3" },
      "expect": [ { "what": "state.kind", "equal_to": "drawing" } ] },
    { "operation": "standard_views",
      "arguments": { "model": "{LAVORO}\\annotations_stay_outside_the_part.sldprt" },
      "expect": [ { "what": "measurements.views_created", "equal_to": 3 } ] },
    { "operation": "drawing_dimension", "arguments": { "view": "V1" },
      "expect": [ { "what": "measurements.dimensions_mm", "includes": ["120", "10"] } ] },
    { "operation": "datum",
      "arguments": { "view": "V1", "side": "bottom", "letter": "A" },
      "expect": [
        { "what": "measurements.letter_reread", "equal_to": "A" },
        { "what": "measurements.attached_to_edge", "equal_to": true },
        { "what": "measurements.datum_after", "equal_to": 1 } ] },
    { "operation": "surface_finish",
      "arguments": { "view": "V1", "side": "top", "ra_um": 3.2 },
      "expect": [
        { "what": "measurements.ra_reread", "equal_to": "3.2" },
        { "what": "measurements.attached_to_edge", "equal_to": true },
        { "what": "measurements.symbols_after", "equal_to": 1 } ] },
    { "operation": "geometric_tolerance",
      "arguments": { "view": "V1", "side": "right", "characteristic": "perpendicularity", "value_mm": 0.05, "references": ["A"] },
      "expect": [
        { "what": "measurements.symbol_reread", "equal_to": 21, "why": "swGcsPERP: the perpendicularity, re-read as a code from the frame" },
        { "what": "measurements.value_reread", "equal_to": "0.05" },
        { "what": "measurements.references_reread", "includes": ["A"] },
        { "what": "measurements.attached_to_edge", "equal_to": true } ] },
    { "operation": "geometric_tolerance",
      "arguments": { "view": "V2", "side": "top", "characteristic": "flatness", "value_mm": 0.02 },
      "expect": [
        { "what": "measurements.symbol_reread", "equal_to": 15, "why": "swGcsFLAT" },
        { "what": "measurements.value_reread", "equal_to": "0.02" },
        { "what": "measurements.frames_after", "equal_to": 2 } ] }
  ]
}
