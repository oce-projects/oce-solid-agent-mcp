{
  "name": "limit_flatness_with_one_reference",
  "family": "drawing",
  "why": "Flatness is a FORM tolerance: by ISO 1101 it refers to no datum. A flatness frame with «A» in it prints and looks valid — and a check that reads it does not know what to do with it. It is refused before touching the drawing.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "top", "length_mm": 120, "width_mm": 80, "thickness_mm": 10, "centered": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 96000 } ] },
    { "operation": "save_document",
      "arguments": { "path": "{LAVORO}\\limit_flatness_with_one_reference.sldprt" },
      "expect": [ { "what": "measurements.warnings", "equal_to": 0 } ] },
    { "operation": "create_drawing", "arguments": { "paper_size": "A3" },
      "expect": [ { "what": "state.kind", "equal_to": "drawing" } ] },
    { "operation": "standard_views",
      "arguments": { "model": "{LAVORO}\\limit_flatness_with_one_reference.sldprt" },
      "expect": [ { "what": "measurements.views_created", "equal_to": 3 } ] },
    { "operation": "datum",
      "arguments": { "view": "V1", "side": "bottom", "letter": "A" },
      "expect": [ { "what": "measurements.letter_reread", "equal_to": "A" } ] },
    { "operation": "geometric_tolerance",
      "arguments": { "view": "V2", "side": "top", "characteristic": "flatness", "value_mm": 0.02, "references": ["A"] },
      "must_fail": {
        "message_includes": ["FORM tolerance", "ISO 1101"],
        "twin": "annotations_stay_outside_the_part" } }
  ]
}
