{
  "name": "limit_tolerance_on_a_datum_that_is_not_there",
  "family": "drawing",
  "why": "Una perpendicolarita' rispetto a «B» su una tavola che ha solo il datum A: la cornice nascerebbe e citerebbe un riferimento che non esiste. Si rifiuta dicendo quali datum ci sono, e come si mette quello che manca.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "top", "length_mm": 120, "width_mm": 80, "thickness_mm": 10, "centered": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 96000 } ] },
    { "operation": "save_document",
      "arguments": { "path": "{LAVORO}\\limit_tolerance_on_a_datum_that_is_not_there.sldprt" },
      "expect": [ { "what": "measurements.warnings", "equal_to": 0 } ] },
    { "operation": "create_drawing", "arguments": { "paper_size": "A3" },
      "expect": [ { "what": "state.kind", "equal_to": "drawing" } ] },
    { "operation": "standard_views",
      "arguments": { "model": "{LAVORO}\\limit_tolerance_on_a_datum_that_is_not_there.sldprt" },
      "expect": [ { "what": "measurements.views_created", "equal_to": 3 } ] },
    { "operation": "datum",
      "arguments": { "view": "V1", "side": "bottom", "letter": "A" },
      "expect": [ { "what": "measurements.letter_reread", "equal_to": "A" } ] },
    { "operation": "geometric_tolerance",
      "arguments": { "view": "V1", "side": "right", "characteristic": "perpendicularity", "value_mm": 0.05, "references": ["B"] },
      "must_fail": {
        "message_includes": ["datum «B»", "non c'e'", "datum"],
        "twin": "annotations_stay_outside_the_part" } }
  ]
}
