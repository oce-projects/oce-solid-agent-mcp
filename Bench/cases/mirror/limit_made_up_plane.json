{
  "name": "limit_made_up_plane",
  "family": "mirror",
  "why": "«diagonale» non e' un piano dell'albero. Un nome inventato deve essere rifiutato dicendo che quel piano non c'e': senza il controllo, la selezione fallirebbe e l'operazione uscirebbe con un errore di SOLIDWORKS che non dice da dove viene.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "front", "length_mm": 200, "width_mm": 120,
                     "thickness_mm": 20, "centered": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 480000 } ] },
    { "operation": "cylindrical_cut",
      "arguments": { "face_uid": "@face(normal=front)", "x_mm": 60, "y_mm": 25,
                     "diameter_mm": 12, "through_all": true },
      "expect": [ { "what": "diameters_mm", "equal_to": [12], "tolerance": 0.02,
                    "tolerance_why": "il diametro si legge da CylinderParams" } ] },
    { "operation": "mirror",
      "arguments": { "feature_uid": "@feature(kind=ICE,n=1)", "plane": "diagonale" },
      "must_fail": {
        "message_includes": ["Non ho trovato il piano", "diagonale"],
        "volume_unchanged": true,
        "no_extra_feature": true,
        "twin": "hole_mirrored_on_right" } }
  ]
}
