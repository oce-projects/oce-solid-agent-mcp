{
  "name": "limit_moved_axis",
  "family": "patterns",
  "why": "ENTRY E4, the AXES part. Up to library 0.113.0 an axis was {uid, tipo} and nothing else: if between the confirmation of the plan and the execution someone redid it elsewhere under the same name as before, `circular_pattern` repeated around the new axis, in silence. Here the signature says an axis that passes 30 mm from the true one: the step must refuse, say by how much it moved, and not touch the part.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_circle",
      "arguments": { "plane": "front", "diameter_mm": 100, "height_mm": 50 },
      "expect": [ { "what": "volume_mm3", "equal_to": 392699.08, "tolerance": 0.5,
                    "tolerance_why": "pi * 50^2 * 50: the calculation has pi inside" } ] },
    { "operation": "cylindrical_cut",
      "arguments": { "face_uid": "@face(normal=front)", "x_mm": 35, "y_mm": 0,
                     "diameter_mm": 10, "through_all": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 388772.09, "tolerance": 0.5,
                    "tolerance_why": "minus pi * 5^2 * 50 = 3926.99" } ] },
    { "operation": "create_axis",
      "arguments": { "face_uid": "@face(area~=15707.96)" },
      "expect": [ { "what": "axes_created", "equal_to": 1 } ] },
    { "operation": "circular_pattern",
      "arguments": {
        "feature_uid": "@feature(kind=ICE,n=1)",
        "axis_uid": "Assi1",
        "instance_count": 6,
        "total_angle_deg": 360,
        "_signatures": { "Assi1": { "point_mm": [30, 0, 25], "direction": [0, 0, 1] } }
      },
      "must_fail": {
        "message_includes": ["has moved", "wrong axis"],
        "volume_unchanged": true,
        "no_extra_feature": true,
        "twin": "recognized_axis" } }
  ]
}
