{
  "name": "anchored_hole_follows_the_border",
  "family": "features",
  "why": "ENTRY E18, part (a). A hole «20 from the right side and 20 from the top» on a plate that gets longer and then taller. The centred 200 plate grows ON ONE SIDE ONLY (measured in E2): set to 260 it runs from X -100 to +160, set to 180 from Y -60 to +120. The anchors are put on purpose on the two sides that MOVE: anchored to the fixed sides, the hole would have stayed where it was even without an anchor, and the check would have proved nothing (it happened in the first draft of the bench probe). Without an anchor the same hole stays at (80, 40): measured on 25/9/2026.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "front", "length_mm": 200, "width_mm": 120,
                     "thickness_mm": 20, "centered": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 480000 } ] },
    { "operation": "cylindrical_cut",
      "arguments": { "face_uid": "@face(normal=front)", "x_mm": 80, "y_mm": 40,
                     "diameter_mm": 10, "through_all": true,
                     "anchor": { "x": { "edge_uid": "@edge(axis=Y,x~=100,z~=20)", "distance_mm": 20 },
                                 "y": { "edge_uid": "@edge(axis=X,y~=60,z~=20)", "distance_mm": 20 } } },
      "expect": [
        { "what": "volume_mm3", "equal_to": 478429.2, "tolerance": 0.05,
          "tolerance_why": "480000 minus pi*5^2*20 = 1570.796: the twentieth covers the rounding" },
        { "what": "centers_x_mm", "equal_to": [80], "tolerance": 0.05,
          "tolerance_why": "the cylinder axis is read in metres from CylinderParams" },
        { "what": "centers_y_mm", "equal_to": [40], "tolerance": 0.05,
          "tolerance_why": "as above" },
        { "what": "measurements.anchor.x.dimension_reread_mm", "equal_to": 20, "tolerance": 0.01,
          "tolerance_why": "the dimension is read back in metres from the dimension just created" },
        { "what": "measurements.anchor.sketch", "equal_to": "fully defined" } ] },
    { "operation": "set_dimension",
      "arguments": { "dimension": "@dimension(feature={SW:feature.sketch}1,name=D1)", "value_mm": 260 },
      "expect": [
        { "what": "measurements.now_mm", "equal_to": 260 },
        { "what": "centers_x_mm", "equal_to": [140], "tolerance": 0.05,
          "tolerance_why": "the right side moves to 160, the hole must stay at 20: 140" },
        { "what": "centers_y_mm", "equal_to": [40], "tolerance": 0.05,
          "tolerance_why": "the top has not moved" },
        { "what": "volume_mm3", "equal_to": 622429.2, "tolerance": 0.05,
          "tolerance_why": "260*120*20 minus the whole hole" } ] },
    { "operation": "set_dimension",
      "arguments": { "dimension": "@dimension(feature={SW:feature.sketch}1,name=D2)", "value_mm": 180 },
      "expect": [
        { "what": "measurements.now_mm", "equal_to": 180 },
        { "what": "centers_x_mm", "equal_to": [140], "tolerance": 0.05,
          "tolerance_why": "the right side has not moved" },
        { "what": "centers_y_mm", "equal_to": [100], "tolerance": 0.05,
          "tolerance_why": "the top moves to 120, the hole must stay at 20: 100" },
        { "what": "volume_mm3", "equal_to": 934429.2, "tolerance": 0.05,
          "tolerance_why": "260*180*20 minus the whole hole" } ] }
  ]
}
