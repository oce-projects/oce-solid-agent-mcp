{
  "name": "hole_on_the_side_stays_at_half_thickness",
  "family": "features",
  "why": "VOCE E18, rischio 4 del critico: le regole dell'ancora parlano degli assi DELLA FACCIA (`assi[]`), non della X e della Y del modello. Sulla faccia di destra (normale +X) x_mm e' la Y del modello e y_mm la Z: un foro Ø6 a 30 dall'alto e centrato nello spessore. Alzando la piastra l'alto va da 60 a 120 e il foro deve seguirlo (Y 30 -> 90); ingrossandola da 20 a 30 il foro deve restare a meta' (Z 10 -> 15). Misurato il 25/9/2026 col banchetto.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "front", "length_mm": 200, "width_mm": 120,
                     "thickness_mm": 20, "centered": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 480000 } ] },
    { "operation": "cylindrical_cut",
      "arguments": { "face_uid": "@face(normal=right)", "x_mm": 30, "y_mm": 10,
                     "diameter_mm": 6, "through_all": false, "depth_mm": 10,
                     "anchor": { "x": { "edge_uid": "@edge(axis=Z,x~=100,y~=60)", "distance_mm": 30 },
                                 "y": { "centered_between": [ "@edge(axis=Y,x~=100,z~=20)", "@edge(axis=Y,x~=100,z~=0)" ] } } },
      "expect": [
        { "what": "volume_mm3", "equal_to": 479717.26, "tolerance": 0.05,
          "tolerance_why": "480000 meno pi*3^2*10 = 282,743" },
        { "what": "centers_y_mm", "equal_to": [30], "tolerance": 0.05,
          "tolerance_why": "l'asse del cilindro si legge in metri" },
        { "what": "centers_z_mm", "equal_to": [10], "tolerance": 0.05,
          "tolerance_why": "come sopra" },
        { "what": "measurements.anchor.sketch", "equal_to": "fully defined" } ] },
    { "operation": "set_dimension",
      "arguments": { "dimension": "@dimension(feature=Schizzo1,name=D2)", "value_mm": 180 },
      "expect": [
        { "what": "measurements.now_mm", "equal_to": 180 },
        { "what": "centers_y_mm", "equal_to": [90], "tolerance": 0.05,
          "tolerance_why": "l'alto va a 120, il foro deve restare a 30: 90" },
        { "what": "centers_z_mm", "equal_to": [10], "tolerance": 0.05,
          "tolerance_why": "lo spessore non e' cambiato" } ] },
    { "operation": "set_dimension",
      "arguments": { "dimension": "@dimension(feature=Estrusione-Estrusione1,name=D1)", "value_mm": 30 },
      "expect": [
        { "what": "measurements.now_mm", "equal_to": 30 },
        { "what": "centers_z_mm", "equal_to": [15], "tolerance": 0.05,
          "tolerance_why": "lo spessore va da 0 a 30, il foro deve restare a meta'" },
        { "what": "volume_mm3", "equal_to": 1079717.26, "tolerance": 0.05,
          "tolerance_why": "200*180*30 meno il foro intero" } ] }
  ]
}
