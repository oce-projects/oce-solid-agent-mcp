{
  "name": "limit_anchored_hole_wizard_holes_halfway",
  "family": "features",
  "why": "ENTRY E18: the holes of `hole_wizard` are in a single sketch, and a point without an anchor would leave it under-constrained — at the first change that hole would go wherever the solver puts it. So the anchor is given to all the positions or to none, and it is refused before the hole is created.",
  "start": {
    "new_part": true
  },
  "steps": [
    {
      "operation": "extrude_rectangle",
      "arguments": {
        "plane": "front",
        "length_mm": 200,
        "width_mm": 120,
        "thickness_mm": 20,
        "centered": true
      },
      "expect": [
        {
          "what": "volume_mm3",
          "equal_to": 480000
        }
      ]
    },
    {
      "operation": "hole_wizard",
      "arguments": {
        "face_uid": "@face(normal=front)",
        "size": "M8",
        "through_all": true,
        "positions": [
          {
            "x_mm": -80,
            "y_mm": -40,
            "anchor": {
              "x": {
                "edge_uid": "@edge(axis=Y,x~=-100,z~=20)",
                "distance_mm": 20
              },
              "y": {
                "edge_uid": "@edge(axis=X,y~=-60,z~=20)",
                "distance_mm": 20
              }
            }
          },
          {
            "x_mm": 80,
            "y_mm": -40
          }
        ]
      },
      "must_fail": {
        "message_includes": [
          "to ALL the positions or to none",
          "1 of 2"
        ],
        "volume_unchanged": true,
        "no_extra_feature": true,
        "twin": "anchored_hole_wizard_holes_stay_at_twenty"
      }
    }
  ]
}
