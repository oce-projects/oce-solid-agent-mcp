{
  "name": "limit_anchored_hole_wizard_holes_halfway",
  "family": "features",
  "why": "VOCE E18: i fori di `hole_wizard` stanno in uno schizzo solo, e un punto senza ancora lo lascerebbe sottovincolato — alla prima modifica quel foro andrebbe dove lo mette il risolutore. Quindi l'ancora si da' a tutte le posizioni o a nessuna, e si rifiuta prima di creare il foro.",
  "start": {
    "new_part": true
  },
  "steps": [
    {
      "operation": "extrude_rectangle",
      "arguments": {
        "plane": "front",
        "length_mm": 200,
        "width_mm": 120,
        "thickness_mm": 20,
        "centered": true
      },
      "expect": [
        {
          "what": "volume_mm3",
          "equal_to": 480000
        }
      ]
    },
    {
      "operation": "hole_wizard",
      "arguments": {
        "face_uid": "@face(normal=front)",
        "size": "M8",
        "through_all": true,
        "positions": [
          {
            "x_mm": -80,
            "y_mm": -40,
            "anchor": {
              "x": {
                "edge_uid": "@edge(axis=Y,x~=-100,z~=20)",
                "distance_mm": 20
              },
              "y": {
                "edge_uid": "@edge(axis=X,y~=-60,z~=20)",
                "distance_mm": 20
              }
            }
          },
          {
            "x_mm": 80,
            "y_mm": -40
          }
        ]
      },
      "must_fail": {
        "message_includes": [
          "a TUTTE le posizioni o a nessuna",
          "1 su 2"
        ],
        "volume_unchanged": true,
        "no_extra_feature": true,
        "twin": "anchored_hole_wizard_holes_stay_at_twenty"
      }
    }
  ]
}
