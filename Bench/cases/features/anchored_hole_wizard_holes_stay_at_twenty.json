{
  "name": "anchored_hole_wizard_holes_stay_at_twenty",
  "family": "features",
  "why": "ENTRY E18 on `hole_wizard`, the last part of the entry. The sketch of the points is made by HoleWizard: the library goes back into it after placing them, every point gets its anchor, and the sketch is required to be fully defined after the last one. Measured on 25/9/2026 with the bench probe: four M8 holes 20 from the edges, with the plate raised to 180 and then lengthened to 260, sit at y -40 -40 100 100 and x -80 -80 140 140.",
  "start": {
    "new_part": true
  },
  "steps": [
    {
      "operation": "extrude_rectangle",
      "arguments": {
        "plane": "front",
        "length_mm": 200,
        "width_mm": 120,
        "thickness_mm": 20,
        "centered": true
      },
      "expect": [
        {
          "what": "volume_mm3",
          "equal_to": 480000
        }
      ]
    },
    {
      "operation": "hole_wizard",
      "arguments": {
        "face_uid": "@face(normal=front)",
        "size": "M8",
        "through_all": true,
        "positions": [
          {
            "x_mm": -80,
            "y_mm": -40,
            "anchor": {
              "x": {
                "edge_uid": "@edge(axis=Y,x~=-100,z~=20)",
                "distance_mm": 20
              },
              "y": {
                "edge_uid": "@edge(axis=X,y~=-60,z~=20)",
                "distance_mm": 20
              }
            }
          },
          {
            "x_mm": 80,
            "y_mm": -40,
            "anchor": {
              "x": {
                "edge_uid": "@edge(axis=Y,x~=100,z~=20)",
                "distance_mm": 20
              },
              "y": {
                "edge_uid": "@edge(axis=X,y~=-60,z~=20)",
                "distance_mm": 20
              }
            }
          },
          {
            "x_mm": 80,
            "y_mm": 40,
            "anchor": {
              "x": {
                "edge_uid": "@edge(axis=Y,x~=100,z~=20)",
                "distance_mm": 20
              },
              "y": {
                "edge_uid": "@edge(axis=X,y~=60,z~=20)",
                "distance_mm": 20
              }
            }
          },
          {
            "x_mm": -80,
            "y_mm": 40,
            "anchor": {
              "x": {
                "edge_uid": "@edge(axis=Y,x~=-100,z~=20)",
                "distance_mm": 20
              },
              "y": {
                "edge_uid": "@edge(axis=X,y~=60,z~=20)",
                "distance_mm": 20
              }
            }
          }
        ]
      },
      "expect": [
        {
          "what": "centers_y_mm",
          "equal_to": [
            -40,
            -40,
            40,
            40
          ],
          "tolerance": 0.05,
          "tolerance_why": "the cylinder axis is read in metres"
        },
        {
          "what": "measurements.hole_sketch",
          "equal_to": "fully defined"
        }
      ]
    },
    {
      "operation": "set_dimension",
      "arguments": {
        "dimension": "@dimension(feature={SW:feature.sketch}1,name=D2)",
        "value_mm": 180
      },
      "expect": [
        {
          "what": "centers_y_mm",
          "equal_to": [
            -40,
            -40,
            100,
            100
          ],
          "tolerance": 0.05,
          "tolerance_why": "the top moves to 120: the holes at the top stay 20 from it"
        }
      ]
    },
    {
      "operation": "set_dimension",
      "arguments": {
        "dimension": "@dimension(feature={SW:feature.sketch}1,name=D1)",
        "value_mm": 260
      },
      "expect": [
        {
          "what": "centers_x_mm",
          "equal_to": [
            -80,
            -80,
            140,
            140
          ],
          "tolerance": 0.05,
          "tolerance_why": "the right side moves to 160: the holes on the right stay 20 from it"
        }
      ]
    }
  ]
}
