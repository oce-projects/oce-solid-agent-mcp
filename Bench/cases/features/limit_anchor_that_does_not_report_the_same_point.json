{
  "name": "limit_anchor_that_does_not_report_the_same_point",
  "family": "features",
  "why": "ENTRY E18: the refusals of the anchor, one per rule, all BEFORE drawing. Each one is a way of writing an anchor that SOLIDWORKS would accept in silence: a dimension of 25 on a point that sits at 20 moves the hole by 5 mm without an error; an axis with no anchor leaves the point to the solver; an edge of the other face or of the wrong axis dimensions something else. Measured on 25/9/2026 with the bench probe: eight refusals, zero features left in the part.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "front", "length_mm": 200, "width_mm": 120,
                     "thickness_mm": 20, "centered": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 480000 } ] },
    { "operation": "cylindrical_cut",
      "arguments": { "face_uid": "@face(normal=front)", "x_mm": 80, "y_mm": 40, "diameter_mm": 10, "through_all": true,
                     "anchor": { "x": { "edge_uid": "@edge(axis=Y,x~=100,z~=20)", "distance_mm": 20 } } },
      "must_fail": { "message_includes": ["BOTH axes"], "volume_unchanged": true,
                        "no_extra_feature": true, "twin": "anchored_hole_follows_the_border" } },
    { "operation": "cylindrical_cut",
      "arguments": { "face_uid": "@face(normal=front)", "x_mm": 80, "y_mm": 40, "diameter_mm": 10, "through_all": true,
                     "anchor": { "x": { "edge_uid": "@edge(axis=Y,x~=100,z~=20)", "distance_mm": 25 },
                                 "y": { "edge_uid": "@edge(axis=X,y~=60,z~=20)", "distance_mm": 20 } } },
      "must_fail": { "message_includes": ["not 25", "must say the same point"], "volume_unchanged": true,
                        "no_extra_feature": true, "twin": "anchored_hole_follows_the_border" } },
    { "operation": "cylindrical_cut",
      "arguments": { "face_uid": "@face(normal=front)", "x_mm": 80, "y_mm": 40, "diameter_mm": 10, "through_all": true,
                     "anchor": { "x": { "edge_uid": "@edge(axis=X,y~=60,z~=20)", "distance_mm": 20 },
                                 "y": { "edge_uid": "@edge(axis=Y,x~=100,z~=20)", "distance_mm": 20 } } },
      "must_fail": { "message_includes": ["you need an edge that runs along"], "volume_unchanged": true,
                        "no_extra_feature": true, "twin": "anchored_hole_follows_the_border" } },
    { "operation": "cylindrical_cut",
      "arguments": { "face_uid": "@face(normal=front)", "x_mm": 97, "y_mm": 40, "diameter_mm": 10, "through_all": true,
                     "anchor": { "x": { "edge_uid": "@edge(axis=Y,x~=100,z~=20)", "distance_mm": 3 },
                                 "y": { "edge_uid": "@edge(axis=X,y~=60,z~=20)", "distance_mm": 20 } } },
      "must_fail": { "message_includes": ["would cross over the edge"], "volume_unchanged": true,
                        "no_extra_feature": true, "twin": "anchored_hole_follows_the_border" } },
    { "operation": "cylindrical_cut",
      "arguments": { "face_uid": "@face(normal=front)", "x_mm": 80, "y_mm": 40, "diameter_mm": 10, "through_all": true,
                     "anchor": { "x": { "edge_uid": "@edge(axis=Y,x~=100,z~=0)", "distance_mm": 20 },
                                 "y": { "edge_uid": "@edge(axis=X,y~=60,z~=20)", "distance_mm": 20 } } },
      "must_fail": { "message_includes": ["is not in the plane of the"], "volume_unchanged": true,
                        "no_extra_feature": true, "twin": "anchored_hole_follows_the_border" } },
    { "operation": "cylindrical_cut",
      "arguments": { "face_uid": "@face(normal=front)", "x_mm": 80, "y_mm": 40, "diameter_mm": 10, "through_all": true,
                     "anchor": { "x": { "centered_between": [ "@edge(axis=Y,x~=-100,z~=20)", "@edge(axis=Y,x~=100,z~=20)" ] },
                                 "y": { "edge_uid": "@edge(axis=X,y~=60,z~=20)", "distance_mm": 20 } } },
      "must_fail": { "message_includes": ["halfway between"], "volume_unchanged": true,
                        "no_extra_feature": true, "twin": "anchored_hole_follows_the_border" } },
    { "operation": "cylindrical_cut",
      "arguments": { "face_uid": "@face(normal=front)", "x_mm": 80, "y_mm": 40, "diameter_mm": 10, "through_all": true,
                     "_signatures": { "E999": {} },
                     "anchor": { "x": { "edge_uid": "@edge(axis=Y,x~=100,z~=20)", "distance_mm": 20 },
                                 "y": { "edge_uid": "@edge(axis=X,y~=60,z~=20)", "distance_mm": 20 } } },
      "_why_the_fake_signatures": "Risk 2 of the critic: without a signature `FirmaCombacia` says yes, and between equal edges the order of the state is not guaranteed. The bridge sends the signatures of EVERYTHING in the state, so a plan that carries `_signatures` without that of an edge of the anchor does not know which edge it meant. The declared bench attaches no signatures: this fake entry puts in one that has nothing to do with it, and that is enough for the rule to fire.",
      "must_fail": { "message_includes": ["carries the signatures of the entities"], "volume_unchanged": true,
                        "no_extra_feature": true, "twin": "anchored_hole_follows_the_border" } },
    { "operation": "rectangular_cut",
      "arguments": { "face_uid": "@face(normal=front)", "x_mm": 0, "y_mm": -45,
                     "length_mm": 60, "width_mm": 40, "through_all": false, "depth_mm": 5,
                     "anchor": { "x": { "centered_between": [ "@edge(axis=Y,x~=-100,z~=20)", "@edge(axis=Y,x~=100,z~=20)" ] },
                                 "y": { "edge_uid": "@edge(axis=X,y~=-60,z~=20)", "distance_mm": 15 } } },
      "_why_the_pocket": "Half the width is taken PER AXIS: in y the pocket is 40 wide, so its centre must be at least 20 from the bottom. At 15 it would stick out by 5, and in x (60 long, between sides at 200) it would fit easily.",
      "must_fail": { "message_includes": ["would cross over the edge"], "volume_unchanged": true,
                        "no_extra_feature": true, "twin": "centered_pocket_follows_the_centerline" } }
  ]
}
