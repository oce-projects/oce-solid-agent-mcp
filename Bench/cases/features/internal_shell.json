{
  "name": "internal_shell",
  "family": "features",
  "why": "Does «Outward» remove towards the outside or towards the inside? The doubt of 80j. Inward, the bounding box does NOT change and the void is (100-10) x (60-10) x (40-5) = 157500: 82500 mm3 remain. The twin «external_shell» makes the same gesture in the opposite direction, and the two numbers are very far apart: if the direction were inverted it would show at the first comparison.",
  "start": { "new_part": true },
  "steps": [
    {
      "operation": "extrude_rectangle",
      "arguments": {
        "plane": "front",
        "length_mm": 100,
        "width_mm": 60,
        "thickness_mm": 40,
        "centered": true
      },
      "expect": [
        { "what": "volume_mm3", "equal_to": 240000 },
        { "what": "state.bounding_box_from_mm", "equal_to": [-50, -30, 0] },
        { "what": "bounding_box_mm", "equal_to": [100, 60, 40] },
        { "what": "state.bodies_total", "equal_to": 1 }
      ]
    },
    {
      "operation": "shell",
      "arguments": {
        "faces_uid": ["@face(normal=front)"],
        "thickness_mm": 5,
        "outward": false
      },
      "expect": [
        { "what": "volume_mm3", "equal_to": 82500 },
        { "what": "bounding_box_mm", "equal_to": [100, 60, 40] },
        { "what": "measurements.material_removed_mm3", "equal_to": 157500,
          "tolerance": 0.1,
          "tolerance_why": "the operation rounds to the tenth before reporting it" },
        { "what": "measurements.faces_removed", "equal_to": 1 },
        { "what": "measurements.facing", "equal_to": "inner" }
      ]
    }
  ]
}
