{
  "name": "limit_axis_from_a_planar_face",
  "family": "axis",
  "why": "Una faccia piana non e' un asse. Va rifiutata con un motivo che dica COSA FARE -- l'asse si fa dal centro di un foro o di un albero -- e non con un «non riuscito» che lascia chi legge a indovinare.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "front", "length_mm": 120, "width_mm": 120,
                     "thickness_mm": 15, "centered": true },
      "expect": [ { "what": "axes_created", "equal_to": 0 } ] },
    { "operation": "cylindrical_cut",
      "arguments": { "face_uid": "@face(normal=front)", "x_mm": 0, "y_mm": 0,
                     "diameter_mm": 10, "through_all": true },
      "expect": [ { "what": "diameters_mm", "equal_to": [10], "tolerance": 0.02,
                    "tolerance_why": "il diametro si legge da CylinderParams" } ] },
    { "operation": "create_axis",
      "arguments": { "face_uid": "@face(normal=front)" },
      "must_fail": {
        "message_includes": ["non e' cilindrica ne' conica", "dal centro di un foro"],
        "volume_unchanged": true,
        "twin": "axis_from_hole_wall" } }
  ]
}
