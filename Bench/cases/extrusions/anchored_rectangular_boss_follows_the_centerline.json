{
  "name": "anchored_rectangular_boss_follows_the_centerline",
  "family": "extrusions",
  "why": "VOCE E18 su `extrude_on_face`, il contorno rettangolare: 40 x 20 alto 10, centrato fra i fianchi e col centro a 30 dal fondo. Il rettangolo e' una spezzata di quattro linee (gli angoli disegnati sotto AddToDB si fondono): orizzontali e verticali, due quote, e il centro costruito con la diagonale come la tasca. Portata la piastra a 260 deve andare a x = 30. Misurato il 25/9/2026.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "front", "length_mm": 200, "width_mm": 120,
                     "thickness_mm": 20, "centered": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 480000 } ] },
    { "operation": "extrude_on_face",
      "arguments": { "face_uid": "@face(normal=front)", "height_mm": 10,
                     "contours": [ { "vertices": [ [-20, -40], [20, -40], [20, -20], [-20, -20] ] } ],
                     "anchor": { "x": { "centered_between": [ "@edge(axis=Y,x~=-100,z~=20)", "@edge(axis=Y,x~=100,z~=20)" ] },
                                 "y": { "edge_uid": "@edge(axis=X,y~=-60,z~=20)", "distance_mm": 30 } } },
      "expect": [
        { "what": "volume_mm3", "equal_to": 488000, "tolerance": 0.05,
          "tolerance_why": "480000 piu' 40*20*10" },
        { "what": "center_of_mass_mm", "equal_to": [0, -0.492, 10.246], "tolerance": 0.01,
          "tolerance_why": "piastra 480000 in (0,0,10) piu' rialzo 8000 in (0,-30,25)" },
        { "what": "measurements.anchor.sketch", "equal_to": "fully defined" } ] },
    { "operation": "set_dimension",
      "arguments": { "dimension": "@dimension(feature=Schizzo1,name=D1)", "value_mm": 260 },
      "expect": [
        { "what": "center_of_mass_mm", "equal_to": [30, -0.38, 10.19], "tolerance": 0.01,
          "tolerance_why": "piastra 624000 in (30,0,10) piu' rialzo 8000 in (30,-30,25): il rialzo e' andato a meta' della piastra nuova" } ] }
  ]
}
