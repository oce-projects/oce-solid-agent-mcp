{
  "name": "anchored_rectangular_boss_follows_the_centerline",
  "family": "extrusions",
  "why": "ENTRY E18 on `extrude_on_face`, the rectangular outline: 40 x 20 high 10, centred between the sides and with the centre at 30 from the bottom. The rectangle is a polyline of four lines (the corners drawn under AddToDB merge): horizontals and verticals, two dimensions, and the centre built with the diagonal like the pocket. With the plate brought to 260 it must go to x = 30. Measured on 25/9/2026.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "front", "length_mm": 200, "width_mm": 120,
                     "thickness_mm": 20, "centered": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 480000 } ] },
    { "operation": "extrude_on_face",
      "arguments": { "face_uid": "@face(normal=front)", "height_mm": 10,
                     "contours": [ { "vertices": [ [-20, -40], [20, -40], [20, -20], [-20, -20] ] } ],
                     "anchor": { "x": { "centered_between": [ "@edge(axis=Y,x~=-100,z~=20)", "@edge(axis=Y,x~=100,z~=20)" ] },
                                 "y": { "edge_uid": "@edge(axis=X,y~=-60,z~=20)", "distance_mm": 30 } } },
      "expect": [
        { "what": "volume_mm3", "equal_to": 488000, "tolerance": 0.05,
          "tolerance_why": "480000 plus 40*20*10" },
        { "what": "center_of_mass_mm", "equal_to": [0, -0.492, 10.246], "tolerance": 0.01,
          "tolerance_why": "plate 480000 at (0,0,10) plus boss 8000 at (0,-30,25)" },
        { "what": "measurements.anchor.sketch", "equal_to": "fully defined" } ] },
    { "operation": "set_dimension",
      "arguments": { "dimension": "@dimension(feature={SW:feature.sketch}1,name=D1)", "value_mm": 260 },
      "expect": [
        { "what": "center_of_mass_mm", "equal_to": [30, -0.38, 10.19], "tolerance": 0.01,
          "tolerance_why": "plate 624000 at (30,0,10) plus boss 8000 at (30,-30,25): the boss went to the middle of the new plate" } ] }
  ]
}
