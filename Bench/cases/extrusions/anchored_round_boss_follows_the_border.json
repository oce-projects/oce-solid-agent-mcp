{
  "name": "anchored_round_boss_follows_the_border",
  "family": "extrusions",
  "why": "ENTRY E18 on `extrude_on_face`, the last operation of the entry that takes a position on a face (apart from `hole_wizard`). Here there are no x_mm/y_mm: the point the anchor keeps is the CENTRE of the outline, and it holds for a single outline, round or rectangular. A Ø20 pin 10 high at 30 from the right side and centred in height: after 260 x 180 it must be at (130, 30). Measured on 25/9/2026 with the little test rig.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "front", "length_mm": 200, "width_mm": 120,
                     "thickness_mm": 20, "centered": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 480000 } ] },
    { "operation": "extrude_on_face",
      "arguments": { "face_uid": "@face(normal=front)", "height_mm": 10,
                     "contours": [ { "circle": [70, 0], "diameter_mm": 20 } ],
                     "anchor": { "x": { "edge_uid": "@edge(axis=Y,x~=100,z~=20)", "distance_mm": 30 },
                                 "y": { "centered_between": [ "@edge(axis=X,y~=-60,z~=20)", "@edge(axis=X,y~=60,z~=20)" ] } } },
      "expect": [
        { "what": "volume_mm3", "equal_to": 483141.59, "tolerance": 0.05,
          "tolerance_why": "480000 plus pi*10^2*10" },
        { "what": "centers_x_mm", "equal_to": [70], "tolerance": 0.05,
          "tolerance_why": "the axis of the cylinder is read in metres" },
        { "what": "measurements.anchor.sketch", "equal_to": "fully defined" } ] },
    { "operation": "set_dimension",
      "arguments": { "dimension": "@dimension(feature={SW:feature.sketch}1,name=D1)", "value_mm": 260 },
      "expect": [
        { "what": "centers_x_mm", "equal_to": [130], "tolerance": 0.05,
          "tolerance_why": "the right side goes to 160, the pin stays at 30: 130" } ] },
    { "operation": "set_dimension",
      "arguments": { "dimension": "@dimension(feature={SW:feature.sketch}1,name=D2)", "value_mm": 180 },
      "expect": [
        { "what": "centers_y_mm", "equal_to": [30], "tolerance": 0.05,
          "tolerance_why": "the height goes from -60 to 120, in the middle there is 30" },
        { "what": "volume_mm3", "equal_to": 939141.59, "tolerance": 0.05,
          "tolerance_why": "260*180*20 plus the pin" } ] }
  ]
}
