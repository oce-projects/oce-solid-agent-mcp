{
  "name": "limit_suppress_twice",
  "family": "removal",
  "why": "Asking twice for the same suppression BROKE NOTHING, and it is not a design error: but it is not answered «done», because then «done» would no longer tell a change from nothing. It is refused saying that it was already so and how to get the opposite.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "top", "length_mm": 200, "width_mm": 100,
                     "thickness_mm": 20, "centered": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 400000 } ] },
    { "operation": "cylindrical_cut",
      "arguments": { "face_uid": "@face(normal=up)", "x_mm": -60, "y_mm": 0,
                     "diameter_mm": 14, "through_all": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 396921.24, "tolerance": 0.5,
                    "tolerance_why": "400000 minus pi*7^2*20: the calculation has pi inside" } ] },
    { "operation": "cylindrical_cut",
      "arguments": { "face_uid": "@face(normal=up)", "x_mm": 0, "y_mm": 0,
                     "diameter_mm": 14, "through_all": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 393842.48, "tolerance": 0.5,
                    "tolerance_why": "400000 minus twice pi*7^2*20: the calculation has pi inside" } ] },
    { "operation": "suppress_feature",
      "arguments": { "feature_uid": "{SW:feature.cut_extrude}2" },
      "expect": [ { "what": "volume_mm3", "equal_to": 396921.24, "tolerance": 0.5,
                    "tolerance_why": "the volume with a single hole comes back: the calculation has pi inside" } ] },
    { "operation": "suppress_feature",
      "arguments": { "feature_uid": "{SW:feature.cut_extrude}2" },
      "must_fail": {
        "message_includes": ["already suppressed", "reactivate"],
        "volume_unchanged": true,
        "twin": "suppress_the_third_hole" } }
  ]
}
