{
  "name": "limit_made_up_name",
  "family": "removal",
  "why": "A name that does not exist must be refused by LISTING THE REAL ONES. Without the list, whoever reads only knows they were wrong and not where to look -- and the names of the features cannot be guessed: «Taglio-Estrusione2» looks like nothing the model has written.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "top", "length_mm": 200, "width_mm": 100,
                     "thickness_mm": 20, "centered": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 400000 } ] },
    { "operation": "cylindrical_cut",
      "arguments": { "face_uid": "@face(normal=up)", "x_mm": -60, "y_mm": 0,
                     "diameter_mm": 14, "through_all": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 396921.24, "tolerance": 0.5,
                    "tolerance_why": "400000 minus pi*7^2*20: the calculation has pi inside" } ] },
    { "operation": "delete_feature",
      "arguments": { "feature_uid": "Cut-That-Does-Not-Exist" },
      "must_fail": {
        "message_includes": ["I cannot find the feature", "There are:"],
        "volume_unchanged": true,
        "twin": "delete_first_hole" } }
  ]
}
