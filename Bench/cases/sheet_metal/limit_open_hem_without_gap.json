{
  "name": "limit_open_hem_without_gap",
  "family": "sheet_metal",
  "why": "Un orlo «open» senza gioco e' un orlo chiuso chiesto col nome sbagliato: si rifiuta prima di toccare il pezzo, dicendo cosa manca e come si chiama la cosa che forse si voleva.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "base_flange",
      "arguments": { "plane": "front", "points": [[0, 30], [0, 0], [50, 0]],
                     "thickness_mm": 2, "radius_mm": 2, "depth_mm": 40 },
      "expect": [ { "what": "bodies", "equal_to": 1 } ] },
    { "operation": "hem",
      "arguments": { "edge_uid": "@edge(axis=Z,x~=50,y~=0)", "variant": "open",
                     "length_mm": 10, "gap_mm": 0 },
      "must_fail": {
        "message_includes": ["gap_mm", "maggiore di zero", "«closed»"],
        "volume_unchanged": true,
        "no_extra_feature": true,
        "twin": "open_hem_checks_out" } }
  ]
}
