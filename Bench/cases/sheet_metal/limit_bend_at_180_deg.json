{
  "name": "limit_bend_at_180_deg",
  "family": "sheet_metal",
  "why": "At 180 degrees the sheet folds back on itself: it is not a sketched bend, it is a hem. It is refused before touching the part, and the refusal names the right operation.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "base_flange",
      "arguments": { "plane": "front", "points": [[0, 0], [100, 0]],
                     "thickness_mm": 2, "radius_mm": 2, "depth_mm": 40 },
      "expect": [ { "what": "bodies", "equal_to": 1 } ] },
    { "operation": "sketched_bend",
      "arguments": { "face_uid": "@face(normal=up)", "start_mm": [50, 0, 0], "end_mm": [50, 0, 40],
                     "angle_deg": 180 },
      "must_fail": {
        "message_includes": ["between 0 and 180", "«hem»"],
        "volume_unchanged": true,
        "no_extra_feature": true,
        "twin": "sketched_bend_raises_half_the_sheet_metal" } }
  ]
}
