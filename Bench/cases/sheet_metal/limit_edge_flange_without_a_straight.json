{
  "name": "limit_edge_flange_without_a_straight",
  "family": "sheet_metal",
  "why": "Una flangia lunga 4 allo spigolo esterno, con raggio 2 e spessore 2: la piega consuma tutto, non resta niente di dritto. Si rifiuta PRIMA di toccare il pezzo, col conto che dice fin dove si puo' scendere.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "base_flange",
      "arguments": { "plane": "front", "points": [[0, 30], [0, 0], [50, 0]],
                     "thickness_mm": 2, "radius_mm": 2, "depth_mm": 40 },
      "expect": [ { "what": "bodies", "equal_to": 1 } ] },
    { "operation": "edge_flange",
      "arguments": { "edge_uid": "@edge(axis=Z,x~=50,y~=0)", "length_mm": 4 },
      "must_fail": {
        "message_includes": ["niente di dritto", "piu' lunga di 4 mm"],
        "volume_unchanged": true,
        "no_extra_feature": true,
        "twin": "edge_flange_closes_the_side" } }
  ]
}
