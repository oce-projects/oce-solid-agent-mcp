<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <OutputType>Exe</OutputType>
    <RootNamespace>Oce.Solid.Agent.Bench</RootNamespace>
    <AssemblyName>Oce.Solid.Agent.Bench</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>bin\</OutputPath>
    <LangVersion>7.3</LangVersion>
    <!-- Two builds of the same source give the same bytes (W3.1-bis.2,
         Checks\language\same-il.ps1). -->
    <Deterministic>true</Deterministic>
    <!-- [CallerFilePath] of the bench recorders gives the path as seen from the
         repository, not the absolute path of this checkout: the same source
         builds the same bytes in any folder (W3.1-bis.2, item 7). -->
    <PathMap>$(MSBuildProjectDirectory)=Banco</PathMap>
    <!-- WHERE THE INTEROP IS, and it can be overridden in three ways.
         `README.md` documented `set SW_REDIST=...`, but that variable was
         read only by `Program.cs` at RUN time, for the AssemblyResolve:
         at BUILD time this value was constant, and whoever followed
         the documented instruction saw the build fail for HintPath not
         found. The remedy did not solve the problem it named.
         Now: environment variable SW_REDIST, or /p:SwRedist=..., and in
         the absence of both the standard place.

         ENTRY H10, 17/9/2026: THE RIGHT VARIABLE IS SW_INSTALL_PATH, the ROOT
         of the installation — the same one the other two .csproj already read.
         Here only `api\redist` was read, and whoever set the root to
         build the library saw the bench fail without understanding why:
         two names, two meanings, and neither told the other.
         The order: /p:SwRedist (explicit, wins) -> SW_INSTALL_PATH ->
         SW_REDIST (the old name, still read) -> the standard place.-->
    <SwRedist Condition=" '$(SwRedist)' == '' AND '$(SwInstallPath)' != '' ">$(SwInstallPath)\api\redist</SwRedist>
    <SwRedist Condition=" '$(SwRedist)' == '' AND '$(SW_INSTALL_PATH)' != '' ">$(SW_INSTALL_PATH)\api\redist</SwRedist>
    <SwRedist Condition=" '$(SwRedist)' == '' AND '$(SW_REDIST)' != '' ">$(SW_REDIST)</SwRedist>
    <SwRedist Condition=" '$(SwRedist)' == '' ">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\api\redist</SwRedist>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Core" />
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SwRedist)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SwRedist)\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\McpClient.cs" />
    <Compile Include="..\Shared\SolidWorksSentinel.cs" />
    <Compile Include="..\Shared\PreparationFailed.cs" />
    <Compile Include="..\Shared\Leash.cs" />
    <!-- The table of the SOLIDWORKS names and the reading of the language: the same files as the library,
         compiled here too (no copy), so that the cases can say {SW:feature.cut_extrude}. -->
    <Compile Include="..\Oce.Solid.Agent.Core\Localization\SolidWorksNameTable.cs">
      <Link>SolidWorksNameTable.cs</Link>
    </Compile>
    <Compile Include="..\Oce.Solid.Agent.Core\Localization\SolidWorksLanguage.cs">
      <Link>SolidWorksLanguage.cs</Link>
    </Compile>
    <Compile Include="CaseNames.cs" />
    <Compile Include="Expectations.cs" />
    <Compile Include="TestAssembly.cs" />
    <Compile Include="CaseKeys.cs" />
    <Compile Include="DeclaredCases.cs" />
    <Compile Include="ReflectionLog.cs" />
    <Compile Include="Regression.cs" />
    <Compile Include="ClientPort.cs" />
    <Compile Include="FacesBeyondSixty.cs" />
    <Compile Include="Orphans.cs" />
    <Compile Include="DimensionNumbers.cs" />
    <Compile Include="BareViews.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="NewOperationsTests.cs" />
    <Compile Include="NoPartTests.cs" />
    <Compile Include="Session.cs" />
    <Compile Include="TestLedger.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\Oce.Solid.Agent.Core\Localization\solidworks-names.json">
      <Link>solidworks-names.json</Link>
      <LogicalName>solidworks-names.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>

