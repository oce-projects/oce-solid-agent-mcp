{
  "about": [
    "The keys a bench case may carry (entry W3.1-bis.2, item 4). The bench loader refuses any other key, and Oce.Solid.Agent.ContractTests (CaseKeysTests) applies the same rule before the bench runs.",
    "Every context is one place of a case. \"read\": the keys the loader reads, written as strings, as the reader writes them (each must appear as a literal in the bench sources). \"documented\": prose keys the loader never reads. \"children\": the key that leads to another context, as an object or as a list of objects. \"frozen_free\": notes with invented names written before this list existed; the list only shrinks, and a new note starts with an underscore, which is admitted anywhere and never read. Documented and frozen keys are written as keys, as the cases write them.",
    "The renaming script of W3.1-bis.4 rewrites this file together with the cases, in the same commit: the keys of documented, frozen_free and children, and the strings of read."
  ],
  "format": 1,
  "roots": {
    "declared": "case",
    "regression": "regression_case"
  },
  "contexts": {
    "case": {
      "read": [
        "assembly",
        "name",
        "red_before",
        "steps",
        "why"
      ],
      "documented": {
        "defect_caught": true,
        "family": true,
        "start": true
      },
      "children": {
        "assembly": "assembly",
        "start": "start",
        "steps": "step"
      },
      "frozen_free": {}
    },
    "start": {
      "read": [],
      "documented": {
        "new_part": true
      },
      "children": {},
      "frozen_free": {}
    },
    "step": {
      "read": [
        "activate_before",
        "arguments",
        "expect",
        "hide_first",
        "must_fail",
        "operation",
        "select_first",
        "uid_from_step"
      ],
      "documented": {},
      "children": {
        "activate_before": "activate_before",
        "expect": "expectation",
        "must_fail": "must_fail"
      },
      "frozen_free": {}
    },
    "expectation": {
      "read": [
        "does_not_include",
        "equal_to",
        "includes",
        "tolerance",
        "tolerance_why",
        "what"
      ],
      "documented": {
        "why": true
      },
      "children": {},
      "frozen_free": {}
    },
    "must_fail": {
      "read": [
        "difference_is_the_part",
        "message_includes",
        "no_extra_feature",
        "twin",
        "volume_unchanged"
      ],
      "documented": {},
      "children": {},
      "frozen_free": {}
    },
    "activate_before": {
      "read": [
        "configuration",
        "document"
      ],
      "documented": {},
      "children": {},
      "frozen_free": {}
    },
    "assembly": {
      "read": [
        "components",
        "configurations",
        "reopen_lightweight"
      ],
      "documented": {},
      "children": {
        "components": "component",
        "configurations": "assembly_configuration"
      },
      "frozen_free": {}
    },
    "component": {
      "read": [
        "components",
        "envelope",
        "hidden",
        "name",
        "position_mm",
        "steps",
        "to_insert"
      ],
      "documented": {},
      "children": {
        "components": "component",
        "steps": "component_step"
      },
      "frozen_free": {}
    },
    "component_step": {
      "read": [
        "arguments",
        "operation"
      ],
      "documented": {},
      "children": {},
      "frozen_free": {}
    },
    "assembly_configuration": {
      "read": [
        "excluded_from_bom",
        "name",
        "suppressed"
      ],
      "documented": {},
      "children": {},
      "frozen_free": {}
    },
    "regression_case": {
      "read": [
        "after",
        "build",
        "intent",
        "intent_why",
        "modify"
      ],
      "documented": {
        "family": true,
        "name": true,
        "why": true
      },
      "children": {
        "after": "regression_expectation",
        "build": "regression_step"
      },
      "frozen_free": {}
    },
    "regression_step": {
      "read": [
        "arguments",
        "operation"
      ],
      "documented": {},
      "children": {},
      "frozen_free": {}
    },
    "regression_expectation": {
      "read": [
        "does_not_include",
        "equal_to",
        "includes",
        "same_as_before",
        "tolerance",
        "tolerance_why",
        "what"
      ],
      "documented": {
        "why": true
      },
      "children": {},
      "frozen_free": {}
    }
  }
}
