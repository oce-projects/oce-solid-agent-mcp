<?xml version="1.0" encoding="utf-8"?>
<!--
  Oce.Solid.Agent.Catalog — writes catalog.json from the C# catalog.

  It does not reference the SOLIDWORKS interops and does not need them: the catalog is
  data, and writing it does not require SOLIDWORKS to be installed. It does reference
  `Oce.Solid.Agent.Core`, though, which needs the interops at compile time —
  so for now the machine that regenerates the catalog must have SOLIDWORKS.

  IT COULD BE SPLIT, and it is not done now: putting the catalog in a library of
  its own would free this executable from SOLIDWORKS, but it would add a third
  project for a gain nobody needs today. When it is needed — the day an
  automatic build without SOLIDWORKS has to check the catalog — that will be
  the moment to do it, and this line will be the reminder.
-->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{2C8A5D71-4E33-4B26-9F18-6D0A7C3E91B4}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>Oce.Solid.Agent.Catalog</RootNamespace>
    <AssemblyName>Oce.Solid.Agent.Catalog</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <LangVersion>9.0</LangVersion>
    <Deterministic>true</Deterministic>
    <OutputPath>..\bin\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Oce.Solid.Agent.Core\Oce.Solid.Agent.Core.csproj">
      <Project>{7B3C1F42-9A5E-4D18-A6C2-51E0D7B44A93}</Project>
      <Name>Oce.Solid.Agent.Core</Name>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
