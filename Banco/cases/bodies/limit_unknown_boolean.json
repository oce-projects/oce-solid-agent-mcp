{
  "name": "limit_unknown_boolean",
  "family": "bodies",
  "why": "«fondi» non e' una delle tre. Un nome sconosciuto va rifiutato dicendo quali ci sono: se passasse in silenzio finirebbe nell'enum come numero, e un valore fuori dai tre consuma il corpo sbagliato senza errore.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "estrudi_rettangolo",
      "arguments": { "piano": "frontale", "lunghezza_mm": 10, "larghezza_mm": 10,
                     "spessore_mm": 10, "centrato": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 1000 } ] },
    { "operation": "sposta_corpi",
      "arguments": { "corpi_uid": ["C1"], "dx_mm": 2, "dz_mm": 5,
                     "copia": true, "quante_copie": 1 },
      "expect": [ { "what": "corpi", "equal_to": 2 } ] },
    { "operation": "combina_corpi",
      "arguments": { "operazione": "fondi" },
      "must_fail": {
        "message_includes": ["fondi", "unisci", "sottrai", "interseca"],
        "volume_unchanged": true,
        "no_extra_feature": true,
        "twin": "merge_two_cubes" } }
  ]
}
