{
  "name": "limit_unknown_boolean",
  "family": "bodies",
  "why": "«fondi» non e' una delle tre. Un nome sconosciuto va rifiutato dicendo quali ci sono: se passasse in silenzio finirebbe nell'enum come numero, e un valore fuori dai tre consuma il corpo sbagliato senza errore.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "front", "length_mm": 10, "width_mm": 10,
                     "thickness_mm": 10, "centered": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 1000 } ] },
    { "operation": "move_bodies",
      "arguments": { "bodies_uid": ["C1"], "dx_mm": 2, "dz_mm": 5,
                     "copy": true, "copy_count": 1 },
      "expect": [ { "what": "bodies", "equal_to": 2 } ] },
    { "operation": "combine_bodies",
      "arguments": { "operation": "fondi" },
      "must_fail": {
        "message_includes": ["fondi", "union", "subtract", "intersect"],
        "volume_unchanged": true,
        "no_extra_feature": true,
        "twin": "merge_two_cubes" } }
  ]
}
