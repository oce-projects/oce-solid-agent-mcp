{
  "name": "anchored_round_boss_follows_the_border",
  "family": "extrusions",
  "why": "VOCE E18 su `extrude_on_face`, l'ultima operazione della voce che prende una posizione su una faccia (a parte `hole_wizard`). Qui non ci sono x_mm/y_mm: il punto che l'ancora tiene e' il CENTRO del contorno, e vale per un contorno solo, tondo o rettangolare. Un perno Ø20 alto 10 a 30 dal fianco destro e centrato in altezza: dopo 260 x 180 deve stare a (130, 30). Misurato il 25/9/2026 col banchetto.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "front", "length_mm": 200, "width_mm": 120,
                     "thickness_mm": 20, "centered": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 480000 } ] },
    { "operation": "extrude_on_face",
      "arguments": { "face_uid": "@face(normal=front)", "height_mm": 10,
                     "contours": [ { "circle": [70, 0], "diameter_mm": 20 } ],
                     "anchor": { "x": { "edge_uid": "@edge(axis=Y,x~=100,z~=20)", "distance_mm": 30 },
                                 "y": { "centered_between": [ "@edge(axis=X,y~=-60,z~=20)", "@edge(axis=X,y~=60,z~=20)" ] } } },
      "expect": [
        { "what": "volume_mm3", "equal_to": 483141.59, "tolerance": 0.05,
          "tolerance_why": "480000 piu' pi*10^2*10" },
        { "what": "centers_x_mm", "equal_to": [70], "tolerance": 0.05,
          "tolerance_why": "l'asse del cilindro si legge in metri" },
        { "what": "measurements.anchor.sketch", "equal_to": "fully defined" } ] },
    { "operation": "set_dimension",
      "arguments": { "dimension": "@dimension(feature=Schizzo1,name=D1)", "value_mm": 260 },
      "expect": [
        { "what": "centers_x_mm", "equal_to": [130], "tolerance": 0.05,
          "tolerance_why": "il fianco destro va a 160, il perno resta a 30: 130" } ] },
    { "operation": "set_dimension",
      "arguments": { "dimension": "@dimension(feature=Schizzo1,name=D2)", "value_mm": 180 },
      "expect": [
        { "what": "centers_y_mm", "equal_to": [30], "tolerance": 0.05,
          "tolerance_why": "l'altezza va da -60 a 120, a meta' c'e' 30" },
        { "what": "volume_mm3", "equal_to": 939141.59, "tolerance": 0.05,
          "tolerance_why": "260*180*20 piu' il perno" } ] }
  ]
}
