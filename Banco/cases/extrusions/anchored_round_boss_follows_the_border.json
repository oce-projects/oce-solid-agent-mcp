{
  "name": "anchored_round_boss_follows_the_border",
  "family": "extrusions",
  "why": "VOCE E18 su `estrudi_su_faccia`, l'ultima operazione della voce che prende una posizione su una faccia (a parte `foro_guidato`). Qui non ci sono x_mm/y_mm: il punto che l'ancora tiene e' il CENTRO del contorno, e vale per un contorno solo, tondo o rettangolare. Un perno Ø20 alto 10 a 30 dal fianco destro e centrato in altezza: dopo 260 x 180 deve stare a (130, 30). Misurato il 25/9/2026 col banchetto.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "estrudi_rettangolo",
      "arguments": { "piano": "frontale", "lunghezza_mm": 200, "larghezza_mm": 120,
                     "spessore_mm": 20, "centrato": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 480000 } ] },
    { "operation": "estrudi_su_faccia",
      "arguments": { "faccia_uid": "@faccia(verso=davanti)", "altezza_mm": 10,
                     "contorni": [ { "cerchio": [70, 0], "diametro_mm": 20 } ],
                     "ancora": { "x": { "spigolo_uid": "@spigolo(asse=Y,x~=100,z~=20)", "distanza_mm": 30 },
                                 "y": { "centrata_fra": [ "@spigolo(asse=X,y~=-60,z~=20)", "@spigolo(asse=X,y~=60,z~=20)" ] } } },
      "expect": [
        { "what": "volume_mm3", "equal_to": 483141.59, "tolerance": 0.05,
          "tolerance_why": "480000 piu' pi*10^2*10" },
        { "what": "centri_x_mm", "equal_to": [70], "tolerance": 0.05,
          "tolerance_why": "l'asse del cilindro si legge in metri" },
        { "what": "misure.ancora.schizzo", "equal_to": "completamente definito" } ] },
    { "operation": "modifica_quota",
      "arguments": { "quota": "@quota(feature=Schizzo1,nome=D1)", "valore_mm": 260 },
      "expect": [
        { "what": "centri_x_mm", "equal_to": [130], "tolerance": 0.05,
          "tolerance_why": "il fianco destro va a 160, il perno resta a 30: 130" } ] },
    { "operation": "modifica_quota",
      "arguments": { "quota": "@quota(feature=Schizzo1,nome=D2)", "valore_mm": 180 },
      "expect": [
        { "what": "centri_y_mm", "equal_to": [30], "tolerance": 0.05,
          "tolerance_why": "l'altezza va da -60 a 120, a meta' c'e' 30" },
        { "what": "volume_mm3", "equal_to": 939141.59, "tolerance": 0.05,
          "tolerance_why": "260*180*20 piu' il perno" } ] }
  ]
}
