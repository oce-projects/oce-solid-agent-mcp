{
  "name": "anchored_rectangular_boss_follows_the_centerline",
  "family": "extrusions",
  "why": "VOCE E18 su `estrudi_su_faccia`, il contorno rettangolare: 40 x 20 alto 10, centrato fra i fianchi e col centro a 30 dal fondo. Il rettangolo e' una spezzata di quattro linee (gli angoli disegnati sotto AddToDB si fondono): orizzontali e verticali, due quote, e il centro costruito con la diagonale come la tasca. Portata la piastra a 260 deve andare a x = 30. Misurato il 25/9/2026.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "estrudi_rettangolo",
      "arguments": { "piano": "frontale", "lunghezza_mm": 200, "larghezza_mm": 120,
                     "spessore_mm": 20, "centrato": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 480000 } ] },
    { "operation": "estrudi_su_faccia",
      "arguments": { "faccia_uid": "@faccia(verso=davanti)", "altezza_mm": 10,
                     "contorni": [ { "vertici": [ [-20, -40], [20, -40], [20, -20], [-20, -20] ] } ],
                     "ancora": { "x": { "centrata_fra": [ "@spigolo(asse=Y,x~=-100,z~=20)", "@spigolo(asse=Y,x~=100,z~=20)" ] },
                                 "y": { "spigolo_uid": "@spigolo(asse=X,y~=-60,z~=20)", "distanza_mm": 30 } } },
      "expect": [
        { "what": "volume_mm3", "equal_to": 488000, "tolerance": 0.05,
          "tolerance_why": "480000 piu' 40*20*10" },
        { "what": "centro_massa_mm", "equal_to": [0, -0.492, 10.246], "tolerance": 0.01,
          "tolerance_why": "piastra 480000 in (0,0,10) piu' rialzo 8000 in (0,-30,25)" },
        { "what": "misure.ancora.schizzo", "equal_to": "completamente definito" } ] },
    { "operation": "modifica_quota",
      "arguments": { "quota": "@quota(feature=Schizzo1,nome=D1)", "valore_mm": 260 },
      "expect": [
        { "what": "centro_massa_mm", "equal_to": [30, -0.38, 10.19], "tolerance": 0.01,
          "tolerance_why": "piastra 624000 in (30,0,10) piu' rialzo 8000 in (30,-30,25): il rialzo e' andato a meta' della piastra nuova" } ] }
  ]
}
