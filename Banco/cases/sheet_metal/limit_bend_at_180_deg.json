{
  "name": "limit_bend_at_180_deg",
  "family": "sheet_metal",
  "why": "A 180 gradi la lamiera si richiude su se stessa: non e' una piega da schizzo, e' un orlo. Si rifiuta prima di toccare il pezzo, e il rifiuto nomina l'operazione giusta.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "flangia_base",
      "arguments": { "piano": "frontale", "punti": [[0, 0], [100, 0]],
                     "spessore_mm": 2, "raggio_mm": 2, "profondita_mm": 40 },
      "expect": [ { "what": "corpi", "equal_to": 1 } ] },
    { "operation": "piega_da_schizzo",
      "arguments": { "faccia_uid": "@faccia(verso=alto)", "da_mm": [50, 0, 0], "a_mm": [50, 0, 40],
                     "angolo_gradi": 180 },
      "must_fail": {
        "message_includes": ["fra 0 e 180", "«orlo»"],
        "volume_unchanged": true,
        "no_extra_feature": true,
        "twin": "sketched_bend_raises_half_the_sheet_metal" } }
  ]
}
