{
  "name": "limit_made_up_protocol",
  "family": "export",
  "why": "«AP999» non esiste. Va rifiutato dicendo quali ci sono: i tre protocolli non sono indovinabili, e uno sbagliato che passasse in silenzio lascerebbe scrivere il file col protocollo predefinito della macchina -- cioe' col protocollo di chi ha usato SOLIDWORKS prima.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "estrudi_rettangolo",
      "arguments": { "piano": "frontale", "lunghezza_mm": 100, "larghezza_mm": 100,
                     "spessore_mm": 20, "centrato": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 200000 } ] },
    { "operation": "esporta_step",
      "arguments": { "percorso": "{LAVORO}\\gp3_ap214.step", "protocollo": "AP999",
                     "riapri_e_confronta": true },
      "must_fail": {
        "message_includes": ["AP999", "AP203", "AP214"],
        "volume_unchanged": true,
        "no_extra_feature": true,
        "twin": "step_ap214_reread" } }
  ]
}
