{
  "name": "limit_made_up_name",
  "family": "removal",
  "why": "Un nome che non c'e' va rifiutato ELENCANDO QUELLI VERI. Senza l'elenco, chi legge sa solo di aver sbagliato e non da che parte guardare -- e i nomi delle lavorazioni non sono indovinabili: «Taglio-Estrusione2» non somiglia a niente che il modello abbia scritto.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "estrudi_rettangolo",
      "arguments": { "piano": "superiore", "lunghezza_mm": 200, "larghezza_mm": 100,
                     "spessore_mm": 20, "centrato": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 400000 } ] },
    { "operation": "taglio_cilindrico",
      "arguments": { "faccia_uid": "@faccia(verso=alto)", "x_mm": -60, "y_mm": 0,
                     "diametro_mm": 14, "passante": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 396921.24, "tolerance": 0.5,
                    "tolerance_why": "400000 meno pi*7^2*20: il conto ha pi dentro" } ] },
    { "operation": "elimina_lavorazione",
      "arguments": { "feature_uid": "Taglio-Che-Non-Esiste" },
      "must_fail": {
        "message_includes": ["Non trovo la lavorazione", "Ci sono:"],
        "volume_unchanged": true,
        "twin": "delete_first_hole" } }
  ]
}
