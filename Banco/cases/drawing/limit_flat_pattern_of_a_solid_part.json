{
  "name": "limit_flat_pattern_of_a_solid_part",
  "family": "drawing",
  "why": "Una piastra estrusa non ha uno sviluppo: non e' lamiera. SOLIDWORKS sulla stessa chiamata potrebbe non creare niente o creare una vista qualunque; si rifiuta prima di toccare la tavola, dicendo perche'.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "estrudi_rettangolo",
      "arguments": { "piano": "superiore", "lunghezza_mm": 120, "larghezza_mm": 80, "spessore_mm": 2, "centrato": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 19200 } ] },
    { "operation": "salva_documento",
      "arguments": { "percorso": "{LAVORO}\\limit_flat_pattern_of_a_solid_part.sldprt" },
      "expect": [ { "what": "misure.avvisi", "equal_to": 0 } ] },
    { "operation": "crea_disegno", "arguments": { "formato": "A3" },
      "expect": [ { "what": "stato.tipo", "equal_to": "tavola" } ] },
    { "operation": "vista_sviluppo",
      "arguments": { "modello": "{LAVORO}\\limit_flat_pattern_of_a_solid_part.sldprt" },
      "must_fail": {
        "message_includes": ["non e' di lamiera"],
        "twin": "flat_pattern_in_the_drawing" } }
  ]
}
