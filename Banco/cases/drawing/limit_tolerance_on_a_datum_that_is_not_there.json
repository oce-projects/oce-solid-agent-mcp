{
  "name": "limit_tolerance_on_a_datum_that_is_not_there",
  "family": "drawing",
  "why": "Una perpendicolarita' rispetto a «B» su una tavola che ha solo il datum A: la cornice nascerebbe e citerebbe un riferimento che non esiste. Si rifiuta dicendo quali datum ci sono, e come si mette quello che manca.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "estrudi_rettangolo",
      "arguments": { "piano": "superiore", "lunghezza_mm": 120, "larghezza_mm": 80, "spessore_mm": 10, "centrato": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 96000 } ] },
    { "operation": "salva_documento",
      "arguments": { "percorso": "{LAVORO}\\limit_tolerance_on_a_datum_that_is_not_there.sldprt" },
      "expect": [ { "what": "misure.avvisi", "equal_to": 0 } ] },
    { "operation": "crea_disegno", "arguments": { "formato": "A3" },
      "expect": [ { "what": "stato.tipo", "equal_to": "tavola" } ] },
    { "operation": "viste_standard",
      "arguments": { "modello": "{LAVORO}\\limit_tolerance_on_a_datum_that_is_not_there.sldprt" },
      "expect": [ { "what": "misure.viste_create", "equal_to": 3 } ] },
    { "operation": "datum_in_tavola",
      "arguments": { "vista": "V1", "lato": "basso", "lettera": "A" },
      "expect": [ { "what": "misure.lettera_riletta", "equal_to": "A" } ] },
    { "operation": "tolleranza_geometrica_in_tavola",
      "arguments": { "vista": "V1", "lato": "destra", "caratteristica": "perpendicolarita", "valore_mm": 0.05, "riferimenti": ["B"] },
      "must_fail": {
        "message_includes": ["datum «B»", "non c'e'", "datum_in_tavola"],
        "twin": "annotations_stay_outside_the_part" } }
  ]
}
