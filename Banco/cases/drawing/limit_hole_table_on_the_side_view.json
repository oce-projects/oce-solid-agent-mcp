{
  "name": "limit_hole_table_on_the_side_view",
  "family": "drawing",
  "why": "La tabella fori chiesta sulla vista FRONTALE (V1), dove i fori della piastra si vedono di taglio come linee nascoste e nessuna faccia forata guarda verso chi legge. Si rifiuta dicendo su quale vista va — non si mette una tabella vuota.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "estrudi_rettangolo",
      "arguments": { "piano": "superiore", "lunghezza_mm": 120, "larghezza_mm": 80,
                     "spessore_mm": 10, "centrato": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 96000 } ] },
    { "operation": "taglio_cilindrico",
      "arguments": { "faccia_uid": "@faccia(verso=alto)", "x_mm": -45, "y_mm": -25, "diametro_mm": 8, "passante": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 95497.35, "tolerance": 0.05, "tolerance_why": "pi dentro" } ] },
    { "operation": "salva_documento",
      "arguments": { "percorso": "{LAVORO}\\limit_hole_table_on_the_side_view.sldprt" },
      "expect": [ { "what": "misure.avvisi", "equal_to": 0 } ] },
    { "operation": "crea_disegno",
      "arguments": { "formato": "A3" },
      "expect": [ { "what": "stato.tipo", "equal_to": "tavola" } ] },
    { "operation": "viste_standard",
      "arguments": { "modello": "{LAVORO}\\limit_hole_table_on_the_side_view.sldprt" },
      "expect": [ { "what": "misure.viste_create", "equal_to": 3 } ] },
    { "operation": "tabella_fori_in_tavola",
      "arguments": { "vista": "V1" },
      "must_fail": {
        "message_includes": ["nessuna faccia con dei fori guarda verso chi legge", "V2"],
        "twin": "hole_table_says_where_they_are" } }
  ]
}
