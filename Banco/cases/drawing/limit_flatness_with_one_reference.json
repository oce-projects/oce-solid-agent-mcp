{
  "name": "limit_flatness_with_one_reference",
  "family": "drawing",
  "why": "La planarita' e' una tolleranza di FORMA: per la ISO 1101 non si riferisce a nessun datum. Una cornice di planarita' con «A» dentro si stampa e sembra valida — e un controllo che la legge non sa cosa farne. Si rifiuta prima di toccare la tavola.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "estrudi_rettangolo",
      "arguments": { "piano": "superiore", "lunghezza_mm": 120, "larghezza_mm": 80, "spessore_mm": 10, "centrato": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 96000 } ] },
    { "operation": "salva_documento",
      "arguments": { "percorso": "{LAVORO}\\limit_flatness_with_one_reference.sldprt" },
      "expect": [ { "what": "misure.avvisi", "equal_to": 0 } ] },
    { "operation": "crea_disegno", "arguments": { "formato": "A3" },
      "expect": [ { "what": "stato.tipo", "equal_to": "tavola" } ] },
    { "operation": "viste_standard",
      "arguments": { "modello": "{LAVORO}\\limit_flatness_with_one_reference.sldprt" },
      "expect": [ { "what": "misure.viste_create", "equal_to": 3 } ] },
    { "operation": "datum_in_tavola",
      "arguments": { "vista": "V1", "lato": "basso", "lettera": "A" },
      "expect": [ { "what": "misure.lettera_riletta", "equal_to": "A" } ] },
    { "operation": "tolleranza_geometrica_in_tavola",
      "arguments": { "vista": "V2", "lato": "alto", "caratteristica": "planarita", "valore_mm": 0.02, "riferimenti": ["A"] },
      "must_fail": {
        "message_includes": ["di FORMA", "ISO 1101"],
        "twin": "annotations_stay_outside_the_part" } }
  ]
}
