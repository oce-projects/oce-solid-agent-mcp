{
  "name": "limit_weld_on_a_single_body",
  "family": "drawing",
  "why": "Una piastra estrusa e' un corpo solo: non ha giunti. Un simbolo di saldatura attaccato a un suo spigolo si stamperebbe e manderebbe il saldatore a saldare dove non c'e' niente da unire. Si rifiuta prima di toccare la tavola.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "top", "length_mm": 120, "width_mm": 80, "thickness_mm": 10, "centered": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 96000 } ] },
    { "operation": "save_document",
      "arguments": { "path": "{LAVORO}\\limit_weld_on_a_single_body.sldprt" },
      "expect": [ { "what": "measurements.warnings", "equal_to": 0 } ] },
    { "operation": "create_drawing", "arguments": { "paper_size": "A3" },
      "expect": [ { "what": "state.kind", "equal_to": "drawing" } ] },
    { "operation": "standard_views",
      "arguments": { "model": "{LAVORO}\\limit_weld_on_a_single_body.sldprt" },
      "expect": [ { "what": "measurements.views_created", "equal_to": 3 } ] },
    { "operation": "drawing_weld_symbol",
      "arguments": { "view": "V1", "variant": "fillet", "throat_mm": 3 },
      "must_fail": {
        "message_includes": ["fra DUE corpi"],
        "twin": "weld_symbol_on_the_joint" } }
  ]
}
