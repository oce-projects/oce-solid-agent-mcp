{
  "name": "limit_weld_on_a_single_body",
  "family": "drawing",
  "why": "Una piastra estrusa e' un corpo solo: non ha giunti. Un simbolo di saldatura attaccato a un suo spigolo si stamperebbe e manderebbe il saldatore a saldare dove non c'e' niente da unire. Si rifiuta prima di toccare la tavola.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "estrudi_rettangolo",
      "arguments": { "piano": "superiore", "lunghezza_mm": 120, "larghezza_mm": 80, "spessore_mm": 10, "centrato": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 96000 } ] },
    { "operation": "salva_documento",
      "arguments": { "percorso": "{LAVORO}\\limit_weld_on_a_single_body.sldprt" },
      "expect": [ { "what": "misure.avvisi", "equal_to": 0 } ] },
    { "operation": "crea_disegno", "arguments": { "formato": "A3" },
      "expect": [ { "what": "stato.tipo", "equal_to": "tavola" } ] },
    { "operation": "viste_standard",
      "arguments": { "modello": "{LAVORO}\\limit_weld_on_a_single_body.sldprt" },
      "expect": [ { "what": "misure.viste_create", "equal_to": 3 } ] },
    { "operation": "saldatura_in_tavola",
      "arguments": { "vista": "V1", "tipo": "angolo", "a_mm": 3 },
      "must_fail": {
        "message_includes": ["fra DUE corpi"],
        "twin": "weld_symbol_on_the_joint" } }
  ]
}
