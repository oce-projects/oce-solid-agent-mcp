{
  "name": "annotations_stay_outside_the_part",
  "family": "drawing",
  "why": "VOCI GT6 e GT8. Sulla piastra 120 x 80 x 10 quotata: il datum A sul lato basso della vista frontale, la rugosita' Ra 3,2 sul lato alto, la perpendicolarita' 0,05 rispetto ad A sul fianco destro, la planarita' 0,02 sulla faccia in alto (vista dall'alto). Misurato e GUARDATO il 26/9/2026: senza spostarle, la rugosita' finiva fuori cornice (coordinate ignorate), la bandierina del datum dall'altra parte dello spigolo, e poi — a quote messe — sopra la linea del 120 e la cornice sopra la vista laterale. Adesso ognuna e' attaccata al suo spigolo e sta fuori dal pezzo, oltre le quote e fuori dalle altre viste.",
  "defect_caught": "Un'annotazione che dice un'altra cosa (Ra, lettera, simbolo, valore, riferimento riletti) o che non e' attaccata a niente. La POSIZIONE si e' guardata nel PNG: qui si pretende che l'annotazione sia attaccata allo spigolo e che dica cio' che si e' chiesto.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "estrudi_rettangolo",
      "arguments": { "piano": "superiore", "lunghezza_mm": 120, "larghezza_mm": 80, "spessore_mm": 10, "centrato": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 96000 } ] },
    { "operation": "salva_documento",
      "arguments": { "percorso": "{LAVORO}\\annotations_stay_outside_the_part.sldprt" },
      "expect": [ { "what": "misure.avvisi", "equal_to": 0 } ] },
    { "operation": "crea_disegno", "arguments": { "formato": "A3" },
      "expect": [ { "what": "stato.tipo", "equal_to": "tavola" } ] },
    { "operation": "viste_standard",
      "arguments": { "modello": "{LAVORO}\\annotations_stay_outside_the_part.sldprt" },
      "expect": [ { "what": "misure.viste_create", "equal_to": 3 } ] },
    { "operation": "quota_in_tavola", "arguments": { "vista": "V1" },
      "expect": [ { "what": "misure.quote_mm", "includes": ["120", "10"] } ] },
    { "operation": "datum_in_tavola",
      "arguments": { "vista": "V1", "lato": "basso", "lettera": "A" },
      "expect": [
        { "what": "misure.lettera_riletta", "equal_to": "A" },
        { "what": "misure.attaccato_allo_spigolo", "equal_to": true },
        { "what": "misure.datum_dopo", "equal_to": 1 } ] },
    { "operation": "rugosita_in_tavola",
      "arguments": { "vista": "V1", "lato": "alto", "ra_um": 3.2 },
      "expect": [
        { "what": "misure.ra_riletto", "equal_to": "3.2" },
        { "what": "misure.attaccato_allo_spigolo", "equal_to": true },
        { "what": "misure.simboli_dopo", "equal_to": 1 } ] },
    { "operation": "tolleranza_geometrica_in_tavola",
      "arguments": { "vista": "V1", "lato": "destra", "caratteristica": "perpendicolarita", "valore_mm": 0.05, "riferimenti": ["A"] },
      "expect": [
        { "what": "misure.simbolo_riletto", "equal_to": 21, "why": "swGcsPERP: la perpendicolarita', riletta come codice dalla cornice" },
        { "what": "misure.valore_riletto", "equal_to": "0.05" },
        { "what": "misure.riferimenti_riletti", "includes": ["A"] },
        { "what": "misure.attaccata_allo_spigolo", "equal_to": true } ] },
    { "operation": "tolleranza_geometrica_in_tavola",
      "arguments": { "vista": "V2", "lato": "alto", "caratteristica": "planarita", "valore_mm": 0.02 },
      "expect": [
        { "what": "misure.simbolo_riletto", "equal_to": 15, "why": "swGcsFLAT" },
        { "what": "misure.valore_riletto", "equal_to": "0.02" },
        { "what": "misure.cornici_dopo", "equal_to": 2 } ] }
  ]
}
