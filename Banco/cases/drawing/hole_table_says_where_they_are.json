{
  "name": "hole_table_says_where_they_are",
  "family": "drawing",
  "why": "VOCE GT5. La piastra della tavola dimostrativa con un foro Ø20 in piu' al centro: la tabella fori sulla vista dall'alto, poi le quote. Misurato col banchetto e GUARDATO il 26/9/2026: la tabella nasce con l'origine (un vertice, marchio 1) e la faccia forata (marchio 2) selezionate — coi marchi sbagliati nasce VUOTA senza errore — e dice A1..A4 Ø8 e B1 Ø20 alle posizioni dall'angolo. La prima tavola guardata aveva i fori DUE volte (tabella e richiami): adesso quota_in_tavola li lascia alla tabella.",
  "defect_caught": "Tre: la tabella di sola intestazione (i marchi scambiati), una posizione che il pezzo non ha, e i fori quotati due volte — sulla tabella e con richiami e quote di posizione sulla vista.",
  "_the_views_are_called_by_uid": "V1 frontale, V2 dall'alto (i fori come cerchi), V3 laterale: l'ordine di viste_standard.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "estrudi_rettangolo",
      "arguments": { "piano": "superiore", "lunghezza_mm": 120, "larghezza_mm": 80,
                     "spessore_mm": 10, "centrato": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 96000 } ] },
    { "operation": "taglio_cilindrico",
      "arguments": { "faccia_uid": "@faccia(verso=alto)", "x_mm": -45, "y_mm": -25, "diametro_mm": 8, "passante": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 95497.35, "tolerance": 0.05, "tolerance_why": "pi dentro" } ] },
    { "operation": "taglio_cilindrico",
      "arguments": { "faccia_uid": "@faccia(verso=alto)", "x_mm": 45, "y_mm": -25, "diametro_mm": 8, "passante": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 94994.69, "tolerance": 0.05, "tolerance_why": "pi dentro" } ] },
    { "operation": "taglio_cilindrico",
      "arguments": { "faccia_uid": "@faccia(verso=alto)", "x_mm": 45, "y_mm": 25, "diametro_mm": 8, "passante": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 94492.04, "tolerance": 0.05, "tolerance_why": "pi dentro" } ] },
    { "operation": "taglio_cilindrico",
      "arguments": { "faccia_uid": "@faccia(verso=alto)", "x_mm": -45, "y_mm": 25, "diametro_mm": 8, "passante": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 93989.38, "tolerance": 0.05, "tolerance_why": "pi dentro" } ] },
    { "operation": "taglio_cilindrico",
      "arguments": { "faccia_uid": "@faccia(verso=alto)", "x_mm": 0, "y_mm": 0, "diametro_mm": 20, "passante": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 90847.79, "tolerance": 0.05,
                    "tolerance_why": "93989,38 meno pi x 10^2 x 10 = 3141,59: pi dentro" } ] },
    { "operation": "salva_documento",
      "arguments": { "percorso": "{LAVORO}\\hole_table_says_where_they_are.sldprt" },
      "expect": [ { "what": "misure.avvisi", "equal_to": 0, "why": "una vista si aggancia al FILE del pezzo" } ] },
    { "operation": "crea_disegno",
      "arguments": { "formato": "A3" },
      "expect": [ { "what": "stato.tipo", "equal_to": "tavola" } ] },
    { "operation": "viste_standard",
      "arguments": { "modello": "{LAVORO}\\hole_table_says_where_they_are.sldprt" },
      "expect": [ { "what": "misure.viste_create", "equal_to": 3 } ] },
    { "operation": "tabella_fori_in_tavola",
      "arguments": { "vista": "V2" },
      "expect": [
        { "what": "misure.fori", "equal_to": 5, "why": "quattro Ø8 e il Ø20: i fori della faccia che guarda chi legge" },
        { "what": "misure.righe", "equal_to": 6, "why": "l'intestazione e un foro per riga: coi marchi scambiati sarebbe 1" },
        { "what": "misure.posizioni_verificate", "equal_to": true,
          "why": "ogni posizione scritta corrisponde a un foro misurato sulla vista dall'angolo in basso a sinistra: 15/15, 15/65, 105/15, 105/65, 60/40" } ] },
    { "operation": "quota_in_tavola",
      "arguments": { "vista": "V1" },
      "expect": [
        { "what": "misure.fori_nella_tabella_fori", "equal_to": 5,
          "why": "la tabella c'e', e quota_in_tavola lo sa: i fori sono suoi" },
        { "what": "misure.quote_mm", "includes": ["120", "10"], "why": "lunghezza e spessore" } ] },
    { "operation": "quota_in_tavola",
      "arguments": { "vista": "V3" },
      "expect": [
        { "what": "misure.quote_mm", "includes": ["80"], "why": "la larghezza, dalla vista laterale" } ] }
  ]
}
