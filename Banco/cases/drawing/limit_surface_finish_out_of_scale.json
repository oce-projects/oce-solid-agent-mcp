{
  "name": "limit_surface_finish_out_of_scale",
  "family": "drawing",
  "why": "Ra 0 non e' una rugosita': e' di solito un campo dimenticato. Un simbolo «0» in tavola si stampa e chiede una superficie impossibile. Si rifiuta prima di toccare la tavola, dicendo l'intervallo.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "top", "length_mm": 120, "width_mm": 80, "thickness_mm": 10, "centered": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 96000 } ] },
    { "operation": "save_document",
      "arguments": { "path": "{LAVORO}\\limit_surface_finish_out_of_scale.sldprt" },
      "expect": [ { "what": "measurements.warnings", "equal_to": 0 } ] },
    { "operation": "create_drawing", "arguments": { "paper_size": "A3" },
      "expect": [ { "what": "state.kind", "equal_to": "drawing" } ] },
    { "operation": "standard_views",
      "arguments": { "model": "{LAVORO}\\limit_surface_finish_out_of_scale.sldprt" },
      "expect": [ { "what": "measurements.views_created", "equal_to": 3 } ] },
    { "operation": "surface_finish",
      "arguments": { "view": "V1", "side": "top", "ra_um": 0 },
      "must_fail": {
        "message_includes": ["fra 0 e 100"],
        "twin": "annotations_stay_outside_the_part" } }
  ]
}
