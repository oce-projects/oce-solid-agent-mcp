{
  "name": "limit_surface_finish_out_of_scale",
  "family": "drawing",
  "why": "Ra 0 non e' una rugosita': e' di solito un campo dimenticato. Un simbolo «0» in tavola si stampa e chiede una superficie impossibile. Si rifiuta prima di toccare la tavola, dicendo l'intervallo.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "estrudi_rettangolo",
      "arguments": { "piano": "superiore", "lunghezza_mm": 120, "larghezza_mm": 80, "spessore_mm": 10, "centrato": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 96000 } ] },
    { "operation": "salva_documento",
      "arguments": { "percorso": "{LAVORO}\\limit_surface_finish_out_of_scale.sldprt" },
      "expect": [ { "what": "misure.avvisi", "equal_to": 0 } ] },
    { "operation": "crea_disegno", "arguments": { "formato": "A3" },
      "expect": [ { "what": "stato.tipo", "equal_to": "tavola" } ] },
    { "operation": "viste_standard",
      "arguments": { "modello": "{LAVORO}\\limit_surface_finish_out_of_scale.sldprt" },
      "expect": [ { "what": "misure.viste_create", "equal_to": 3 } ] },
    { "operation": "rugosita_in_tavola",
      "arguments": { "vista": "V1", "lato": "alto", "ra_um": 0 },
      "must_fail": {
        "message_includes": ["fra 0 e 100"],
        "twin": "annotations_stay_outside_the_part" } }
  ]
}
