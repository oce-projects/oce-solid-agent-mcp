{
  "name": "anchored_oblique_slot_keeps_its_angle",
  "family": "slot",
  "why": "VOCE E18 sull'asola obliqua: 60 x 20 a 30 gradi, centro a 60 dal fianco destro e centrata in altezza. Senza ancora un'asola obliqua non ha uno spigolo da cui misurare l'angolo e puo' ruotare; con l'ancora l'angolo si quota contro il suo primo spigolo (`AddSpecificDimension` angolare: `Extension.AddDimension` torna null su quella coppia, misurato). Dopo 260 x 180 il centro deve stare a (100, 30) e le estremita' conservare i 30 gradi: (82,68, 20) e (117,32, 40).",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "front", "length_mm": 200, "width_mm": 120,
                     "thickness_mm": 20, "centered": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 480000 } ] },
    { "operation": "slot",
      "arguments": { "face_uid": "@face(normal=front)", "x_mm": 40, "y_mm": 0,
                     "length_mm": 60, "width_mm": 20, "angle_deg": 30, "through_all": true,
                     "anchor": { "x": { "edge_uid": "@edge(axis=Y,x~=100,z~=20)", "distance_mm": 60 },
                                 "y": { "centered_between": [ "@edge(axis=X,y~=-60,z~=20)", "@edge(axis=X,y~=60,z~=20)" ] } } },
      "expect": [
        { "what": "centers_x_mm", "equal_to": [22.68, 57.32], "tolerance": 0.05,
          "tolerance_why": "40 -/+ 20*cos30 = 17,32; i centri si leggono in metri" },
        { "what": "centers_y_mm", "equal_to": [-10, 10], "tolerance": 0.05,
          "tolerance_why": "0 -/+ 20*sen30" },
        { "what": "measurements.dimensions_on_sketch", "equal_to": 3,
          "why": "raggio, distanza fra i centri e l'angolo contro lo spigolo d'ancora" },
        { "what": "measurements.anchor.sketch", "equal_to": "fully defined" } ] },
    { "operation": "set_dimension",
      "arguments": { "dimension": "@dimension(feature=Schizzo1,name=D1)", "value_mm": 260 },
      "expect": [
        { "what": "centers_x_mm", "equal_to": [82.68, 117.32], "tolerance": 0.05,
          "tolerance_why": "il centro va a 160 - 60 = 100, l'angolo non cambia" } ] },
    { "operation": "set_dimension",
      "arguments": { "dimension": "@dimension(feature=Schizzo1,name=D2)", "value_mm": 180 },
      "expect": [
        { "what": "centers_x_mm", "equal_to": [82.68, 117.32], "tolerance": 0.05,
          "tolerance_why": "in x non si muove niente" },
        { "what": "centers_y_mm", "equal_to": [20, 40], "tolerance": 0.05,
          "tolerance_why": "centro a 30, -/+ 10: l'angolo resta 30 gradi" } ] }
  ]
}
