      "argomenti": { "piano": "frontale", "lunghezza_mm": 200, "larghezza_mm": 120,
                     "spessore_mm": 20, "centrato": true },
      "attese": [ { "cosa": "volume_mm3", "uguale": 480000 } ] },
    { "operazione": "asola",
      "argomenti": { "faccia_uid": "@faccia(verso=davanti)", "x_mm": 40, "y_mm": 0,
