    { "operazione": "modifica_quota",
      "argomenti": { "quota": "@quota(feature=Schizzo1,nome=D2)", "valore_mm": 180 },
      "attese": [
        { "cosa": "centri_x_mm", "uguale": [82.68, 117.32], "tolleranza": 0.05,
