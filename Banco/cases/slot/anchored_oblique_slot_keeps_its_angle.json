                     "ancora": { "x": { "spigolo_uid": "@spigolo(asse=Y,x~=100,z~=20)", "distanza_mm": 60 },
                                 "y": { "centrata_fra": [ "@spigolo(asse=X,y~=-60,z~=20)", "@spigolo(asse=X,y~=60,z~=20)" ] } } },
      "attese": [
        { "cosa": "centri_x_mm", "uguale": [22.68, 57.32], "tolleranza": 0.05,
          "perche_questa_tolleranza": "40 -/+ 20*cos30 = 17,32; i centri si leggono in metri" },
        { "cosa": "centri_y_mm", "uguale": [-10, 10], "tolleranza": 0.05,
          "perche_questa_tolleranza": "0 -/+ 20*sen30" },
        { "cosa": "misure.quote_sullo_schizzo", "uguale": 3,
          "perche": "raggio, distanza fra i centri e l'angolo contro lo spigolo d'ancora" },
        { "cosa": "misure.ancora.schizzo", "uguale": "completamente definito" } ] },
    { "operazione": "modifica_quota",
      "argomenti": { "quota": "@quota(feature=Schizzo1,nome=D1)", "valore_mm": 260 },
      "attese": [
        { "cosa": "centri_x_mm", "uguale": [82.68, 117.32], "tolleranza": 0.05,
