{
  "name": "anchored_slot_follows_the_border",
  "family": "slot",
  "why": "VOCE E18 sull'asola: 60 x 20 a 40 dal fianco destro e centrata in altezza. La piastra cresce verso +X e +Y (voce E2): portata a 260 il fianco va a 160 e l'asola deve andare a x = 120 (le estremita' a 100 e 140); portata a 180 l'altezza va da -60 a 120 e l'asola deve salire a y = 30. Misurato il 25/9/2026 col banchetto.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "estrudi_rettangolo",
      "arguments": { "piano": "frontale", "lunghezza_mm": 200, "larghezza_mm": 120,
                     "spessore_mm": 20, "centrato": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 480000 } ] },
    { "operation": "asola",
      "arguments": { "faccia_uid": "@faccia(verso=davanti)", "x_mm": 60, "y_mm": 0,
                     "lunghezza_mm": 60, "larghezza_mm": 20, "passante": true,
                     "ancora": { "x": { "spigolo_uid": "@spigolo(asse=Y,x~=100,z~=20)", "distanza_mm": 40 },
                                 "y": { "centrata_fra": [ "@spigolo(asse=X,y~=-60,z~=20)", "@spigolo(asse=X,y~=60,z~=20)" ] } } },
      "expect": [
        { "what": "centri_x_mm", "equal_to": [40, 80], "tolerance": 0.05,
          "tolerance_why": "i centri delle estremita' si leggono in metri da CylinderParams" },
        { "what": "misure.ancora.schizzo", "equal_to": "completamente definito" } ] },
    { "operation": "modifica_quota",
      "arguments": { "quota": "@quota(feature=Schizzo1,nome=D1)", "valore_mm": 260 },
      "expect": [
        { "what": "centri_x_mm", "equal_to": [100, 140], "tolerance": 0.05,
          "tolerance_why": "il fianco destro va a 160, il centro deve restare a 40: 120, estremita' a 100 e 140" } ] },
    { "operation": "modifica_quota",
      "arguments": { "quota": "@quota(feature=Schizzo1,nome=D2)", "valore_mm": 180 },
      "expect": [
        { "what": "centri_y_mm", "equal_to": [30, 30], "tolerance": 0.05,
          "tolerance_why": "l'altezza va da -60 a 120: a meta' c'e' 30" },
        { "what": "volume_mm3", "equal_to": 913716.81, "tolerance": 0.05,
          "tolerance_why": "260*180*20 meno l'asola intera, 22283,19" } ] }
  ]
}
