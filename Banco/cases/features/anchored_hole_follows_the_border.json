{
  "name": "anchored_hole_follows_the_border",
  "family": "features",
  "why": "VOCE E18, pezzo (a). Un foro «a 20 dal fianco destro e 20 dall'alto» su una piastra che si allunga e poi si alza. La piastra 200 centrata cresce DA UNA PARTE SOLA (misurato in E2): portata a 260 va da X -100 a +160, portata a 180 da Y -60 a +120. Si ancora apposta ai due lati che SI MUOVONO: ancorato ai lati fermi, il foro sarebbe rimasto dov'era anche senza ancora, e la prova non avrebbe provato niente (e' successo alla prima stesura del banchetto). Senza ancora lo stesso foro resta a (80, 40): misurato il 25/9/2026.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "estrudi_rettangolo",
      "arguments": { "piano": "frontale", "lunghezza_mm": 200, "larghezza_mm": 120,
                     "spessore_mm": 20, "centrato": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 480000 } ] },
    { "operation": "taglio_cilindrico",
      "arguments": { "faccia_uid": "@faccia(verso=davanti)", "x_mm": 80, "y_mm": 40,
                     "diametro_mm": 10, "passante": true,
                     "ancora": { "x": { "spigolo_uid": "@spigolo(asse=Y,x~=100,z~=20)", "distanza_mm": 20 },
                                 "y": { "spigolo_uid": "@spigolo(asse=X,y~=60,z~=20)", "distanza_mm": 20 } } },
      "expect": [
        { "what": "volume_mm3", "equal_to": 478429.2, "tolerance": 0.05,
          "tolerance_why": "480000 meno pi*5^2*20 = 1570,796: il ventesimo copre l'arrotondamento" },
        { "what": "centri_x_mm", "equal_to": [80], "tolerance": 0.05,
          "tolerance_why": "l'asse del cilindro si legge in metri da CylinderParams" },
        { "what": "centri_y_mm", "equal_to": [40], "tolerance": 0.05,
          "tolerance_why": "come sopra" },
        { "what": "misure.ancora.x.quota_riletta_mm", "equal_to": 20, "tolerance": 0.01,
          "tolerance_why": "la quota si rilegge in metri dalla quota nata" },
        { "what": "misure.ancora.schizzo", "equal_to": "completamente definito" } ] },
    { "operation": "modifica_quota",
      "arguments": { "quota": "@quota(feature=Schizzo1,nome=D1)", "valore_mm": 260 },
      "expect": [
        { "what": "misure.adesso_mm", "equal_to": 260 },
        { "what": "centri_x_mm", "equal_to": [140], "tolerance": 0.05,
          "tolerance_why": "il fianco destro va a 160, il foro deve restare a 20: 140" },
        { "what": "centri_y_mm", "equal_to": [40], "tolerance": 0.05,
          "tolerance_why": "l'alto non si e' mosso" },
        { "what": "volume_mm3", "equal_to": 622429.2, "tolerance": 0.05,
          "tolerance_why": "260*120*20 meno il foro intero" } ] },
    { "operation": "modifica_quota",
      "arguments": { "quota": "@quota(feature=Schizzo1,nome=D2)", "valore_mm": 180 },
      "expect": [
        { "what": "misure.adesso_mm", "equal_to": 180 },
        { "what": "centri_x_mm", "equal_to": [140], "tolerance": 0.05,
          "tolerance_why": "il fianco destro non si e' mosso" },
        { "what": "centri_y_mm", "equal_to": [100], "tolerance": 0.05,
          "tolerance_why": "l'alto va a 120, il foro deve restare a 20: 100" },
        { "what": "volume_mm3", "equal_to": 934429.2, "tolerance": 0.05,
          "tolerance_why": "260*180*20 meno il foro intero" } ] }
  ]
}
