{
  "name": "blind_becomes_through",
  "family": "features",
  "why": "VOCE Z-F4. Una cieca che deve diventare passante, una piastra che deve crescere: prima l'unica strada era rifare il pezzo. Misurato il 27/9/2026 (prova0089 zf4): GetDefinition come IExtrudeFeatureData2, SetEndCondition/SetDepth, ModifyDefinition cambiano la lavorazione al suo posto, e il foro sulla faccia di sopra segue la piastra che cresce.",
  "defect_caught": "La definizione creduta cambiata perche' ModifyDefinition ha risposto true, senza rileggerla ne' guardare il volume; «passante» su un'estrusione; il foro che non segue la faccia quando la piastra cresce.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "estrudi_rettangolo",
      "arguments": { "piano": "superiore", "lunghezza_mm": 120, "larghezza_mm": 80, "spessore_mm": 10, "centrato": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 96000 } ] },
    { "operation": "taglio_cilindrico",
      "arguments": { "faccia_uid": "@faccia(verso=alto)", "x_mm": 0, "y_mm": 0, "diametro_mm": 8, "passante": false, "profondita_mm": 5 },
      "expect": [ { "what": "volume_mm3", "equal_to": 95748.67, "tolerance": 0.05,
                    "tolerance_why": "pi dentro: 96000 meno pi x 4^2 x 5" } ] },
    { "operation": "cambia_estrusione",
      "arguments": { "feature_uid": "Taglio-Estrusione1", "passante": true },
      "expect": [
        { "what": "misure.fine_prima", "equal_to": "cieca" },
        { "what": "misure.fine_dopo", "equal_to": "passante", "why": "riletta dalla definizione" },
        { "what": "volume_mm3", "equal_to": 95497.35, "tolerance": 0.05,
          "tolerance_why": "pi dentro: 96000 meno pi x 4^2 x 10" } ] },
    { "operation": "cambia_estrusione",
      "arguments": { "feature_uid": "Taglio-Estrusione1", "profondita_mm": 7 },
      "expect": [
        { "what": "misure.fine_dopo", "equal_to": "cieca" },
        { "what": "misure.profondita_dopo_mm", "equal_to": 7 },
        { "what": "volume_mm3", "equal_to": 95648.14, "tolerance": 0.05,
          "tolerance_why": "pi dentro: 96000 meno pi x 4^2 x 7" } ] },
    { "operation": "cambia_estrusione",
      "arguments": { "feature_uid": "Estrusione-Estrusione1", "profondita_mm": 12 },
      "expect": [
        { "what": "misure.profondita_prima_mm", "equal_to": 10 },
        { "what": "misure.lavorazioni_in_errore", "equal_to": 0, "why": "il foro sulla faccia di sopra segue la piastra" },
        { "what": "volume_mm3", "equal_to": 114848.14, "tolerance": 0.05,
          "tolerance_why": "pi dentro: 120 x 80 x 12 meno pi x 4^2 x 7" } ] },
    { "operation": "cambia_estrusione",
      "arguments": { "feature_uid": "Estrusione-Estrusione1", "passante": true },
      "must_fail": {
        "message_includes": ["«passante» vale per un taglio", "profondita_mm"],
        "twin": "blind_becomes_through" } }
  ]
}
