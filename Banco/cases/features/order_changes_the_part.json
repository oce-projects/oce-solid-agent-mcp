{
  "name": "order_changes_the_part",
  "family": "features",
  "why": "VOCE Z-F3. Uno svuotamento messo prima di un foro da' un pezzo diverso da uno messo dopo. Misurato il 27/9/2026 (prova0089 zf3): scatola 100x60x40, foro Ø10 passante dall'alto, guscio 3 aprendo l'alto: foro poi guscio 56485,7 mm3, guscio prima del foro 51952,38; ReorderFeature rimette com'era; spostare il foro prima dell'estrusione su cui sta risponde false e non tocca niente.",
  "defect_caught": "Lo spostamento creduto fatto perche' ReorderFeature ha risposto true, senza guardare l'albero e il volume; lo spostamento impossibile preso per buono; un albero lasciato rotto da uno spostamento.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "top", "length_mm": 100, "width_mm": 60, "thickness_mm": 40, "centered": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 240000 } ] },
    { "operation": "cylindrical_cut",
      "arguments": { "face_uid": "@face(normal=up)", "x_mm": 20, "y_mm": 0, "diameter_mm": 10, "through_all": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 236858.41, "tolerance": 0.05,
                    "tolerance_why": "pi dentro: 240000 meno pi x 5^2 x 40" } ] },
    { "operation": "shell",
      "arguments": { "faces_uid": ["@face(normal=up)"], "thickness_mm": 3 },
      "expect": [ { "what": "volume_mm3", "equal_to": 56485.7, "tolerance": 0.5,
                    "tolerance_why": "misurato dalla sonda (56485,7): il guscio attorno al foro non ha una formula corta" } ] },
    { "operation": "reorder_feature",
      "arguments": { "feature_uid": "Svuota1", "relative_to_uid": "Taglio-Estrusione1", "placement": "before" },
      "expect": [
        { "what": "measurements.volume_before_mm3", "equal_to": 56485.7, "tolerance": 0.5,
          "tolerance_why": "la stessa della sonda" },
        { "what": "measurements.volume_after_mm3", "equal_to": 51952.38, "tolerance": 0.5,
          "tolerance_why": "misurato dalla sonda: il foro fatto dopo il guscio taglia solo il fondo",
          "why": "l'ordine cambia il pezzo" },
        { "what": "measurements.features_in_error", "equal_to": 0 },
        { "what": "volume_mm3", "equal_to": 51952.38, "tolerance": 0.5,
          "tolerance_why": "lo stesso, letto dallo stato" } ] },
    { "operation": "reorder_feature",
      "arguments": { "feature_uid": "Svuota1", "relative_to_uid": "Taglio-Estrusione1", "placement": "after" },
      "expect": [
        { "what": "measurements.volume_after_mm3", "equal_to": 56485.7, "tolerance": 0.5,
          "tolerance_why": "la stessa della sonda",
          "why": "rimessa dov'era, il pezzo torna quello di prima" } ] },
    { "operation": "reorder_feature",
      "arguments": { "feature_uid": "Taglio-Estrusione1", "relative_to_uid": "Estrusione-Estrusione1", "placement": "before" },
      "must_fail": {
        "message_includes": ["non sposta", "Non ho toccato niente"],
        "twin": "order_changes_the_part" } }
  ]
}
