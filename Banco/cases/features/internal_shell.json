{
  "name": "internal_shell",
  "family": "features",
  "why": "«Outward» toglie verso l'esterno o verso l'interno? Il dubbio di 80j. Verso l'interno l'ingombro NON cambia e il vuoto e' (100-10) x (60-10) x (40-5) = 157500: restano 82500 mm3. La gemella «external_shell» fa lo stesso gesto col verso opposto, e i due numeri sono lontanissimi: se il verso fosse invertito si vedrebbe al primo confronto.",
  "start": { "new_part": true },
  "steps": [
    {
      "operation": "estrudi_rettangolo",
      "arguments": {
        "piano": "frontale",
        "lunghezza_mm": 100,
        "larghezza_mm": 60,
        "spessore_mm": 40,
        "centrato": true
      },
      "expect": [
        { "what": "volume_mm3", "equal_to": 240000 },
        { "what": "stato.ingombro_da_mm", "equal_to": [-50, -30, 0] },
        { "what": "ingombro_mm", "equal_to": [100, 60, 40] },
        { "what": "stato.corpi_totali", "equal_to": 1 }
      ]
    },
    {
      "operation": "guscio",
      "arguments": {
        "facce_uid": ["@faccia(verso=davanti)"],
        "spessore_mm": 5,
        "verso_esterno": false
      },
      "expect": [
        { "what": "volume_mm3", "equal_to": 82500 },
        { "what": "ingombro_mm", "equal_to": [100, 60, 40] },
        { "what": "misure.materiale_tolto_mm3", "equal_to": 157500,
          "tolerance": 0.1,
          "tolerance_why": "l'operazione arrotonda al decimo prima di riportarlo" },
        { "what": "misure.facce_tolte", "equal_to": 1 },
        { "what": "misure.verso", "equal_to": "interno" }
      ]
    }
  ]
}
