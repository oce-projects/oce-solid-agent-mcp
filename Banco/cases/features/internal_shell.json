{
  "name": "internal_shell",
  "family": "features",
  "why": "«Outward» toglie verso l'esterno o verso l'interno? Il dubbio di 80j. Verso l'interno l'ingombro NON cambia e il vuoto e' (100-10) x (60-10) x (40-5) = 157500: restano 82500 mm3. La gemella «external_shell» fa lo stesso gesto col verso opposto, e i due numeri sono lontanissimi: se il verso fosse invertito si vedrebbe al primo confronto.",
  "start": { "new_part": true },
  "steps": [
    {
      "operation": "extrude_rectangle",
      "arguments": {
        "plane": "front",
        "length_mm": 100,
        "width_mm": 60,
        "thickness_mm": 40,
        "centered": true
      },
      "expect": [
        { "what": "volume_mm3", "equal_to": 240000 },
        { "what": "state.bounding_box_from_mm", "equal_to": [-50, -30, 0] },
        { "what": "bounding_box_mm", "equal_to": [100, 60, 40] },
        { "what": "state.bodies_total", "equal_to": 1 }
      ]
    },
    {
      "operation": "shell",
      "arguments": {
        "faces_uid": ["@face(normal=front)"],
        "thickness_mm": 5,
        "outward": false
      },
      "expect": [
        { "what": "volume_mm3", "equal_to": 82500 },
        { "what": "bounding_box_mm", "equal_to": [100, 60, 40] },
        { "what": "measurements.material_removed_mm3", "equal_to": 157500,
          "tolerance": 0.1,
          "tolerance_why": "l'operazione arrotonda al decimo prima di riportarlo" },
        { "what": "measurements.faces_removed", "equal_to": 1 },
        { "what": "measurements.facing", "equal_to": "inner" }
      ]
    }
  ]
}
