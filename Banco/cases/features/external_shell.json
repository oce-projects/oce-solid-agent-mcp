{
  "name": "external_shell",
  "family": "features",
  "why": "La gemella di «internal_shell», col verso opposto. Verso l'esterno il pieno di prima diventa il vuoto e la parete si aggiunge da fuori: 110 x 70 x 45 - 240000 = 106500 mm3, e l'ingombro CRESCE. E' l'ingombro a rendere questa prova diversa da un confronto di volumi: un guscio che sbagliasse verso lascerebbe l'ingombro dov'era.",
  "start": { "new_part": true },
  "steps": [
    {
      "operation": "extrude_rectangle",
      "arguments": {
        "plane": "front",
        "length_mm": 100,
        "width_mm": 60,
        "thickness_mm": 40,
        "centered": true
      },
      "expect": [
        { "what": "volume_mm3", "equal_to": 240000 },
        { "what": "state.bounding_box_from_mm", "equal_to": [-50, -30, 0] },
        { "what": "bounding_box_mm", "equal_to": [100, 60, 40] }
      ]
    },
    {
      "operation": "shell",
      "arguments": {
        "faces_uid": ["@face(normal=front)"],
        "thickness_mm": 5,
        "outward": true
      },
      "expect": [
        { "what": "volume_mm3", "equal_to": 106500 },
        { "what": "bounding_box_mm", "equal_to": [110, 70, 45] },
        { "what": "measurements.material_removed_mm3", "equal_to": 133500,
          "tolerance": 0.1,
          "tolerance_why": "l'operazione arrotonda al decimo prima di riportarlo" },
        { "what": "measurements.facing", "equal_to": "outer" }
      ]
    }
  ]
}
