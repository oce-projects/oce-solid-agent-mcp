{
  "name": "external_shell",
  "family": "features",
  "why": "La gemella di «internal_shell», col verso opposto. Verso l'esterno il pieno di prima diventa il vuoto e la parete si aggiunge da fuori: 110 x 70 x 45 - 240000 = 106500 mm3, e l'ingombro CRESCE. E' l'ingombro a rendere questa prova diversa da un confronto di volumi: un guscio che sbagliasse verso lascerebbe l'ingombro dov'era.",
  "start": { "new_part": true },
  "steps": [
    {
      "operation": "estrudi_rettangolo",
      "arguments": {
        "piano": "frontale",
        "lunghezza_mm": 100,
        "larghezza_mm": 60,
        "spessore_mm": 40,
        "centrato": true
      },
      "expect": [
        { "what": "volume_mm3", "equal_to": 240000 },
        { "what": "stato.ingombro_da_mm", "equal_to": [-50, -30, 0] },
        { "what": "ingombro_mm", "equal_to": [100, 60, 40] }
      ]
    },
    {
      "operation": "guscio",
      "arguments": {
        "facce_uid": ["@faccia(verso=davanti)"],
        "spessore_mm": 5,
        "verso_esterno": true
      },
      "expect": [
        { "what": "volume_mm3", "equal_to": 106500 },
        { "what": "ingombro_mm", "equal_to": [110, 70, 45] },
        { "what": "misure.materiale_tolto_mm3", "equal_to": 133500,
          "tolerance": 0.1,
          "tolerance_why": "l'operazione arrotonda al decimo prima di riportarlo" },
        { "what": "misure.verso", "equal_to": "esterno" }
      ]
    }
  ]
}
