{
  "name": "limit_anchored_hole_wizard_holes_halfway",
  "family": "features",
  "why": "VOCE E18: i fori di `foro_guidato` stanno in uno schizzo solo, e un punto senza ancora lo lascerebbe sottovincolato — alla prima modifica quel foro andrebbe dove lo mette il risolutore. Quindi l'ancora si da' a tutte le posizioni o a nessuna, e si rifiuta prima di creare il foro.",
  "start": {
    "new_part": true
  },
  "steps": [
    {
      "operation": "estrudi_rettangolo",
      "arguments": {
        "piano": "frontale",
        "lunghezza_mm": 200,
        "larghezza_mm": 120,
        "spessore_mm": 20,
        "centrato": true
      },
      "expect": [
        {
          "what": "volume_mm3",
          "equal_to": 480000
        }
      ]
    },
    {
      "operation": "foro_guidato",
      "arguments": {
        "faccia_uid": "@faccia(verso=davanti)",
        "taglia": "M8",
        "passante": true,
        "posizioni": [
          {
            "x_mm": -80,
            "y_mm": -40,
            "ancora": {
              "x": {
                "spigolo_uid": "@spigolo(asse=Y,x~=-100,z~=20)",
                "distanza_mm": 20
              },
              "y": {
                "spigolo_uid": "@spigolo(asse=X,y~=-60,z~=20)",
                "distanza_mm": 20
              }
            }
          },
          {
            "x_mm": 80,
            "y_mm": -40
          }
        ]
      },
      "must_fail": {
        "message_includes": [
          "a TUTTE le posizioni o a nessuna",
          "1 su 2"
        ],
        "volume_unchanged": true,
        "no_extra_feature": true,
        "twin": "anchored_hole_wizard_holes_stay_at_twenty"
      }
    }
  ]
}
