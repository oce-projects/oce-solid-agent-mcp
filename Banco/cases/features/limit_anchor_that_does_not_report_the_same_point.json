{
  "name": "limit_anchor_that_does_not_report_the_same_point",
  "family": "features",
  "why": "VOCE E18: i rifiuti dell'ancora, uno per regola, tutti PRIMA di disegnare. Ognuno e' un modo di scrivere un'ancora che SOLIDWORKS accetterebbe in silenzio: una quota da 25 su un punto che sta a 20 sposta il foro di 5 mm senza errore; un asse senza ancora lascia il punto al risolutore; uno spigolo dell'altra faccia o dell'asse sbagliato quota un'altra cosa. Misurati il 25/9/2026 col banchetto: otto rifiuti, zero lavorazioni lasciate nel pezzo.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "estrudi_rettangolo",
      "arguments": { "piano": "frontale", "lunghezza_mm": 200, "larghezza_mm": 120,
                     "spessore_mm": 20, "centrato": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 480000 } ] },
    { "operation": "taglio_cilindrico",
      "arguments": { "faccia_uid": "@faccia(verso=davanti)", "x_mm": 80, "y_mm": 40, "diametro_mm": 10, "passante": true,
                     "ancora": { "x": { "spigolo_uid": "@spigolo(asse=Y,x~=100,z~=20)", "distanza_mm": 20 } } },
      "must_fail": { "message_includes": ["TUTTI E DUE gli assi"], "volume_unchanged": true,
                        "no_extra_feature": true, "twin": "anchored_hole_follows_the_border" } },
    { "operation": "taglio_cilindrico",
      "arguments": { "faccia_uid": "@faccia(verso=davanti)", "x_mm": 80, "y_mm": 40, "diametro_mm": 10, "passante": true,
                     "ancora": { "x": { "spigolo_uid": "@spigolo(asse=Y,x~=100,z~=20)", "distanza_mm": 25 },
                                 "y": { "spigolo_uid": "@spigolo(asse=X,y~=60,z~=20)", "distanza_mm": 20 } } },
      "must_fail": { "message_includes": ["non a 25", "devono dire lo stesso punto"], "volume_unchanged": true,
                        "no_extra_feature": true, "twin": "anchored_hole_follows_the_border" } },
    { "operation": "taglio_cilindrico",
      "arguments": { "faccia_uid": "@faccia(verso=davanti)", "x_mm": 80, "y_mm": 40, "diametro_mm": 10, "passante": true,
                     "ancora": { "x": { "spigolo_uid": "@spigolo(asse=X,y~=60,z~=20)", "distanza_mm": 20 },
                                 "y": { "spigolo_uid": "@spigolo(asse=Y,x~=100,z~=20)", "distanza_mm": 20 } } },
      "must_fail": { "message_includes": ["serve uno spigolo che corre lungo"], "volume_unchanged": true,
                        "no_extra_feature": true, "twin": "anchored_hole_follows_the_border" } },
    { "operation": "taglio_cilindrico",
      "arguments": { "faccia_uid": "@faccia(verso=davanti)", "x_mm": 97, "y_mm": 40, "diametro_mm": 10, "passante": true,
                     "ancora": { "x": { "spigolo_uid": "@spigolo(asse=Y,x~=100,z~=20)", "distanza_mm": 3 },
                                 "y": { "spigolo_uid": "@spigolo(asse=X,y~=60,z~=20)", "distanza_mm": 20 } } },
      "must_fail": { "message_includes": ["scavalcherebbe lo spigolo"], "volume_unchanged": true,
                        "no_extra_feature": true, "twin": "anchored_hole_follows_the_border" } },
    { "operation": "taglio_cilindrico",
      "arguments": { "faccia_uid": "@faccia(verso=davanti)", "x_mm": 80, "y_mm": 40, "diametro_mm": 10, "passante": true,
                     "ancora": { "x": { "spigolo_uid": "@spigolo(asse=Y,x~=100,z~=0)", "distanza_mm": 20 },
                                 "y": { "spigolo_uid": "@spigolo(asse=X,y~=60,z~=20)", "distanza_mm": 20 } } },
      "must_fail": { "message_includes": ["non sta nel piano della faccia"], "volume_unchanged": true,
                        "no_extra_feature": true, "twin": "anchored_hole_follows_the_border" } },
    { "operation": "taglio_cilindrico",
      "arguments": { "faccia_uid": "@faccia(verso=davanti)", "x_mm": 80, "y_mm": 40, "diametro_mm": 10, "passante": true,
                     "ancora": { "x": { "centrata_fra": [ "@spigolo(asse=Y,x~=-100,z~=20)", "@spigolo(asse=Y,x~=100,z~=20)" ] },
                                 "y": { "spigolo_uid": "@spigolo(asse=X,y~=60,z~=20)", "distanza_mm": 20 } } },
      "must_fail": { "message_includes": ["ma a meta' fra"], "volume_unchanged": true,
                        "no_extra_feature": true, "twin": "anchored_hole_follows_the_border" } },
    { "operation": "taglio_cilindrico",
      "arguments": { "faccia_uid": "@faccia(verso=davanti)", "x_mm": 80, "y_mm": 40, "diametro_mm": 10, "passante": true,
                     "_firme": { "E999": {} },
                     "ancora": { "x": { "spigolo_uid": "@spigolo(asse=Y,x~=100,z~=20)", "distanza_mm": 20 },
                                 "y": { "spigolo_uid": "@spigolo(asse=X,y~=60,z~=20)", "distanza_mm": 20 } } },
      "_why_the_fake_signatures": "Rischio 2 del critico: senza firma `FirmaCombacia` dice si', e fra spigoli uguali l'ordine dello stato non e' garantito. Il ponte manda le firme di TUTTO lo stato, quindi un piano che porta `_firme` senza quella di uno spigolo dell'ancora non sa quale spigolo intendeva. Il banco dichiarato non attacca firme: questa voce finta ne mette una che non c'entra, ed e' abbastanza perche' la regola scatti.",
      "must_fail": { "message_includes": ["porta le firme delle entita'"], "volume_unchanged": true,
                        "no_extra_feature": true, "twin": "anchored_hole_follows_the_border" } },
    { "operation": "taglio_rettangolare",
      "arguments": { "faccia_uid": "@faccia(verso=davanti)", "x_mm": 0, "y_mm": -45,
                     "lunghezza_mm": 60, "larghezza_mm": 40, "passante": false, "profondita_mm": 5,
                     "ancora": { "x": { "centrata_fra": [ "@spigolo(asse=Y,x~=-100,z~=20)", "@spigolo(asse=Y,x~=100,z~=20)" ] },
                                 "y": { "spigolo_uid": "@spigolo(asse=X,y~=-60,z~=20)", "distanza_mm": 15 } } },
      "_why_the_pocket": "La meta' della larghezza si prende PER ASSE: in y la tasca e' larga 40, quindi il suo centro deve stare ad almeno 20 dal fondo. A 15 ne uscirebbe di 5, e in x (lunga 60, fra fianchi a 200) ci starebbe benissimo.",
      "must_fail": { "message_includes": ["scavalcherebbe lo spigolo"], "volume_unchanged": true,
                        "no_extra_feature": true, "twin": "centered_pocket_follows_the_centerline" } }
  ]
}
