{
  "name": "anchored_hole_wizard_holes_stay_at_twenty",
  "family": "features",
  "why": "VOCE E18 su `hole_wizard`, l'ultimo pezzo della voce. Lo schizzo dei punti lo fa HoleWizard: la libreria ci rientra dopo averli posizionati, ogni punto riceve la sua ancora, e lo schizzo si pretende completamente definito dopo l'ultimo. Misurato il 25/9/2026 col banchetto: quattro fori M8 a 20 dai bordi, alzata la piastra a 180 e poi allungata a 260, stanno a y -40 -40 100 100 e x -80 -80 140 140.",
  "start": {
    "new_part": true
  },
  "steps": [
    {
      "operation": "extrude_rectangle",
      "arguments": {
        "plane": "front",
        "length_mm": 200,
        "width_mm": 120,
        "thickness_mm": 20,
        "centered": true
      },
      "expect": [
        {
          "what": "volume_mm3",
          "equal_to": 480000
        }
      ]
    },
    {
      "operation": "hole_wizard",
      "arguments": {
        "face_uid": "@face(normal=front)",
        "size": "M8",
        "through_all": true,
        "positions": [
          {
            "x_mm": -80,
            "y_mm": -40,
            "anchor": {
              "x": {
                "edge_uid": "@edge(axis=Y,x~=-100,z~=20)",
                "distance_mm": 20
              },
              "y": {
                "edge_uid": "@edge(axis=X,y~=-60,z~=20)",
                "distance_mm": 20
              }
            }
          },
          {
            "x_mm": 80,
            "y_mm": -40,
            "anchor": {
              "x": {
                "edge_uid": "@edge(axis=Y,x~=100,z~=20)",
                "distance_mm": 20
              },
              "y": {
                "edge_uid": "@edge(axis=X,y~=-60,z~=20)",
                "distance_mm": 20
              }
            }
          },
          {
            "x_mm": 80,
            "y_mm": 40,
            "anchor": {
              "x": {
                "edge_uid": "@edge(axis=Y,x~=100,z~=20)",
                "distance_mm": 20
              },
              "y": {
                "edge_uid": "@edge(axis=X,y~=60,z~=20)",
                "distance_mm": 20
              }
            }
          },
          {
            "x_mm": -80,
            "y_mm": 40,
            "anchor": {
              "x": {
                "edge_uid": "@edge(axis=Y,x~=-100,z~=20)",
                "distance_mm": 20
              },
              "y": {
                "edge_uid": "@edge(axis=X,y~=60,z~=20)",
                "distance_mm": 20
              }
            }
          }
        ]
      },
      "expect": [
        {
          "what": "centers_y_mm",
          "equal_to": [
            -40,
            -40,
            40,
            40
          ],
          "tolerance": 0.05,
          "tolerance_why": "l'asse del cilindro si legge in metri"
        },
        {
          "what": "measurements.hole_sketch",
          "equal_to": "fully defined"
        }
      ]
    },
    {
      "operation": "set_dimension",
      "arguments": {
        "dimension": "@dimension(feature=Schizzo1,name=D2)",
        "value_mm": 180
      },
      "expect": [
        {
          "what": "centers_y_mm",
          "equal_to": [
            -40,
            -40,
            100,
            100
          ],
          "tolerance": 0.05,
          "tolerance_why": "l'alto va a 120: i fori di sopra restano a 20 da lui"
        }
      ]
    },
    {
      "operation": "set_dimension",
      "arguments": {
        "dimension": "@dimension(feature=Schizzo1,name=D1)",
        "value_mm": 260
      },
      "expect": [
        {
          "what": "centers_x_mm",
          "equal_to": [
            -80,
            -80,
            140,
            140
          ],
          "tolerance": 0.05,
          "tolerance_why": "il fianco destro va a 160: i fori di destra restano a 20 da lui"
        }
      ]
    }
  ]
}
