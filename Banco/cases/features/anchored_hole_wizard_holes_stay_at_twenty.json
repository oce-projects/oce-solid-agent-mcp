{
  "name": "anchored_hole_wizard_holes_stay_at_twenty",
  "family": "features",
  "why": "VOCE E18 su `foro_guidato`, l'ultimo pezzo della voce. Lo schizzo dei punti lo fa HoleWizard: la libreria ci rientra dopo averli posizionati, ogni punto riceve la sua ancora, e lo schizzo si pretende completamente definito dopo l'ultimo. Misurato il 25/9/2026 col banchetto: quattro fori M8 a 20 dai bordi, alzata la piastra a 180 e poi allungata a 260, stanno a y -40 -40 100 100 e x -80 -80 140 140.",
  "start": {
    "new_part": true
  },
  "steps": [
    {
      "operation": "estrudi_rettangolo",
      "arguments": {
        "piano": "frontale",
        "lunghezza_mm": 200,
        "larghezza_mm": 120,
        "spessore_mm": 20,
        "centrato": true
      },
      "expect": [
        {
          "what": "volume_mm3",
          "equal_to": 480000
        }
      ]
    },
    {
      "operation": "foro_guidato",
      "arguments": {
        "faccia_uid": "@faccia(verso=davanti)",
        "taglia": "M8",
        "passante": true,
        "posizioni": [
          {
            "x_mm": -80,
            "y_mm": -40,
            "ancora": {
              "x": {
                "spigolo_uid": "@spigolo(asse=Y,x~=-100,z~=20)",
                "distanza_mm": 20
              },
              "y": {
                "spigolo_uid": "@spigolo(asse=X,y~=-60,z~=20)",
                "distanza_mm": 20
              }
            }
          },
          {
            "x_mm": 80,
            "y_mm": -40,
            "ancora": {
              "x": {
                "spigolo_uid": "@spigolo(asse=Y,x~=100,z~=20)",
                "distanza_mm": 20
              },
              "y": {
                "spigolo_uid": "@spigolo(asse=X,y~=-60,z~=20)",
                "distanza_mm": 20
              }
            }
          },
          {
            "x_mm": 80,
            "y_mm": 40,
            "ancora": {
              "x": {
                "spigolo_uid": "@spigolo(asse=Y,x~=100,z~=20)",
                "distanza_mm": 20
              },
              "y": {
                "spigolo_uid": "@spigolo(asse=X,y~=60,z~=20)",
                "distanza_mm": 20
              }
            }
          },
          {
            "x_mm": -80,
            "y_mm": 40,
            "ancora": {
              "x": {
                "spigolo_uid": "@spigolo(asse=Y,x~=-100,z~=20)",
                "distanza_mm": 20
              },
              "y": {
                "spigolo_uid": "@spigolo(asse=X,y~=60,z~=20)",
                "distanza_mm": 20
              }
            }
          }
        ]
      },
      "expect": [
        {
          "what": "centri_y_mm",
          "equal_to": [
            -40,
            -40,
            40,
            40
          ],
          "tolerance": 0.05,
          "tolerance_why": "l'asse del cilindro si legge in metri"
        },
        {
          "what": "misure.schizzo_dei_fori",
          "equal_to": "completamente definito"
        }
      ]
    },
    {
      "operation": "modifica_quota",
      "arguments": {
        "quota": "@quota(feature=Schizzo1,nome=D2)",
        "valore_mm": 180
      },
      "expect": [
        {
          "what": "centri_y_mm",
          "equal_to": [
            -40,
            -40,
            100,
            100
          ],
          "tolerance": 0.05,
          "tolerance_why": "l'alto va a 120: i fori di sopra restano a 20 da lui"
        }
      ]
    },
    {
      "operation": "modifica_quota",
      "arguments": {
        "quota": "@quota(feature=Schizzo1,nome=D1)",
        "valore_mm": 260
      },
      "expect": [
        {
          "what": "centri_x_mm",
          "equal_to": [
            -80,
            -80,
            140,
            140
          ],
          "tolerance": 0.05,
          "tolerance_why": "il fianco destro va a 160: i fori di destra restano a 20 da lui"
        }
      ]
    }
  ]
}
