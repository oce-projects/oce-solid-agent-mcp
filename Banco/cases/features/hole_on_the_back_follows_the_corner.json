{
  "name": "hole_on_the_back_follows_the_corner",
  "family": "features",
  "why": "VOCE E18, rischio 4 del critico, la seconda meta': la faccia di DIETRO (normale -Z). Lo schizzo su una faccia rivolta all'indietro ha la X girata rispetto al modello (lo dice `PuntoNelloSchizzo`), e un'ancora che ragionasse nelle coordinate dello schizzo misurerebbe dal lato sbagliato. Foro Ø8 cieco a 20 dal fianco destro e dall'alto: dopo 260 x 180 deve stare a (140, 100). Misurato il 25/9/2026 col banchetto.",
  "start": { "new_part": true },
  "steps": [
    { "operation": "extrude_rectangle",
      "arguments": { "plane": "front", "length_mm": 200, "width_mm": 120,
                     "thickness_mm": 20, "centered": true },
      "expect": [ { "what": "volume_mm3", "equal_to": 480000 } ] },
    { "operation": "cylindrical_cut",
      "arguments": { "face_uid": "@face(normal=back)", "x_mm": 80, "y_mm": 40,
                     "diameter_mm": 8, "through_all": false, "depth_mm": 5,
                     "anchor": { "x": { "edge_uid": "@edge(axis=Y,x~=100,z~=0)", "distance_mm": 20 },
                                 "y": { "edge_uid": "@edge(axis=X,y~=60,z~=0)", "distance_mm": 20 } } },
      "expect": [
        { "what": "volume_mm3", "equal_to": 479748.67, "tolerance": 0.05,
          "tolerance_why": "480000 meno pi*4^2*5 = 251,327" },
        { "what": "centers_x_mm", "equal_to": [80], "tolerance": 0.05,
          "tolerance_why": "l'asse del cilindro si legge in metri" },
        { "what": "centers_y_mm", "equal_to": [40], "tolerance": 0.05,
          "tolerance_why": "come sopra" } ] },
    { "operation": "set_dimension",
      "arguments": { "dimension": "@dimension(feature=Schizzo1,name=D1)", "value_mm": 260 },
      "expect": [
        { "what": "measurements.now_mm", "equal_to": 260 },
        { "what": "centers_x_mm", "equal_to": [140], "tolerance": 0.05,
          "tolerance_why": "il fianco destro va a 160: 140" } ] },
    { "operation": "set_dimension",
      "arguments": { "dimension": "@dimension(feature=Schizzo1,name=D2)", "value_mm": 180 },
      "expect": [
        { "what": "measurements.now_mm", "equal_to": 180 },
        { "what": "centers_x_mm", "equal_to": [140], "tolerance": 0.05,
          "tolerance_why": "il fianco destro non si e' mosso" },
        { "what": "centers_y_mm", "equal_to": [100], "tolerance": 0.05,
          "tolerance_why": "l'alto va a 120: 100" },
        { "what": "volume_mm3", "equal_to": 935748.67, "tolerance": 0.05,
          "tolerance_why": "260*180*20 meno il foro intero" } ] }
  ]
}
