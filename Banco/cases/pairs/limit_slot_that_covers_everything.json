{
  "name": "limit_slot_that_covers_everything",
  "family": "pairs",
  "why": "Un'asola 500 x 300 passante su un pezzo che occupa 314 x 274 non lascerebbe niente. La gemella e' la stessa asola ridotta a 30 x 9, che e' l'asola vera del mestiere: differiscono per due argomenti, la lunghezza e la larghezza, e sono i due che il controllo guarda.",
  "start": { "new_part": true },
  "steps": [
    {
      "operation": "extrude_rectangle",
      "arguments": {
        "plane": "front",
        "length_mm": 314,
        "width_mm": 274,
        "thickness_mm": 52,
        "centered": true
      },
      "expect": [
        { "what": "volume_mm3", "equal_to": 4473872 },
        { "what": "state.bounding_box_from_mm", "equal_to": [-157, -137, 0] }
      ]
    },
    {
      "operation": "slot",
      "arguments": {
        "face_uid": "@face(normal=front)",
        "x_mm": 0,
        "y_mm": 0,
        "length_mm": 500,
        "width_mm": 300,
        "through_all": true
      },
      "must_fail": {
        "message_includes": ["copre tutto il pezzo", "314 x 274"],
        "volume_unchanged": true,
        "no_extra_feature": true,
        "twin": "slot_30x9"
      }
    }
  ]
}
