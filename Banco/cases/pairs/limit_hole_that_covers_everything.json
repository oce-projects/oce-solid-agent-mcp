{
  "name": "limit_hole_that_covers_everything",
  "family": "pairs",
  "why": "Un foro da 500 passante su un pezzo che occupa 314 x 274 non lascerebbe niente. Fino alla 0.42.0 la risposta era «Il taglio non e' stato creato. Nel pezzo e' rimasto lo schizzo...», identica a quella del foro fuori dal pezzo: due cose da fare opposte -- rimpicciolire, oppure spostare -- e il messaggio non diceva quale.",
  "start": { "new_part": true },
  "steps": [
    {
      "operation": "estrudi_rettangolo",
      "arguments": {
        "piano": "frontale",
        "lunghezza_mm": 314,
        "larghezza_mm": 274,
        "spessore_mm": 52,
        "centrato": true
      },
      "expect": [
        { "what": "volume_mm3", "equal_to": 4473872 },
        { "what": "stato.ingombro_da_mm", "equal_to": [-157, -137, 0] }
      ]
    },
    {
      "operation": "taglio_cilindrico",
      "arguments": {
        "faccia_uid": "@faccia(verso=davanti)",
        "x_mm": 0,
        "y_mm": 0,
        "diametro_mm": 500,
        "passante": true
      },
      "must_fail": {
        "message_includes": ["copre tutto il pezzo", "314 x 274"],
        "volume_unchanged": true,
        "no_extra_feature": true,
        "twin": "hole_270_on_face_274"
      }
    }
  ]
}
