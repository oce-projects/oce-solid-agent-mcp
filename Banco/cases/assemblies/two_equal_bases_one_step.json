{
  "name": "two_equal_bases_one_step",
  "family": "assemblies",
  "why": "REVISIONE AVVERSARIALE DEL 27/9/2026, rilievo sullo STEP dell'assieme. Il conto dei solidi attesi sommava i corpi di ogni ISTANZA; lo STEP di un assieme scrive la struttura, e la forma di un pezzo che compare due volte potrebbe esserci una volta sola. Il caso del banco aveva due pezzi DIVERSI e la terza istanza soppressa: non lo poteva vedere. Qui la base compare due volte (la seconda inserita dal passo), il coperchio una. Il caso MISURA quanti solidi scrive lo STEP; la massa dell'assieme conta le istanze.",
  "defect_caught": "Uno STEP giusto rifiutato perche' i solidi si contano per istanza.",
  "assembly": {
    "components": [
      {
        "name": "base",
        "steps": [
          {
            "operation": "estrudi_rettangolo",
            "arguments": {
              "piano": "superiore",
              "lunghezza_mm": 120,
              "larghezza_mm": 80,
              "spessore_mm": 10,
              "centrato": true
            }
          },
          {
            "operation": "applica_materiale",
            "arguments": {
              "materiale": "AISI 304"
            }
          }
        ]
      },
      {
        "name": "coperchio",
        "position_mm": [
          0,
          7,
          0
        ],
        "steps": [
          {
            "operation": "estrudi_rettangolo",
            "arguments": {
              "piano": "superiore",
              "lunghezza_mm": 120,
              "larghezza_mm": 80,
              "spessore_mm": 4,
              "centrato": true
            }
          },
          {
            "operation": "applica_materiale",
            "arguments": {
              "materiale": "S235JR"
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "operation": "inserisci_componente",
      "arguments": {
        "percorso": "{LAVORO}\\two_equal_bases_one_step_base.sldprt",
        "x_mm": 200,
        "y_mm": 0,
        "z_mm": 0
      },
      "expect": [
        {
          "what": "misure.componenti_dopo",
          "equal_to": 3
        }
      ]
    },
    {
      "operation": "proprieta_di_massa",
      "arguments": {},
      "expect": [
        {
          "what": "misure.massa_kg",
          "equal_to": 1.8355,
          "tolerance": 0.0001,
          "tolerance_why": "arrotondata a quattro decimali: 2 x 0,768 + 0,29952 = 1,83552",
          "why": "la massa conta le ISTANZE: due basi pesano due volte"
        },
        {
          "what": "misure.componenti_pesati",
          "equal_to": 3
        }
      ]
    },
    {
      "operation": "esporta_step",
      "arguments": {
        "percorso": "{LAVORO}\\two_equal_bases_one_step.step"
      },
      "expect": [
        {
          "what": "misure.solidi_nel_file",
          "equal_to": 2,
          "why": "MISURATO il 28/9/2026: con la base due volte e il coperchio una, lo STEP ha 2 solidi — la forma di un pezzo si scrive una volta sola, le istanze sono occorrenze"
        },
        {
          "what": "misure.solidi_attesi",
          "equal_to": 2,
          "why": "i pezzi UNICI (percorso e configurazione), non le istanze"
        }
      ]
    }
  ]
}
