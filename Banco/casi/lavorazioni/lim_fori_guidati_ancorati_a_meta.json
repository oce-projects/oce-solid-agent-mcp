{
  "nome": "lim_fori_guidati_ancorati_a_meta",
  "famiglia": "lavorazioni",
  "perche": "VOCE E18: i fori di `foro_guidato` stanno in uno schizzo solo, e un punto senza ancora lo lascerebbe sottovincolato — alla prima modifica quel foro andrebbe dove lo mette il risolutore. Quindi l'ancora si da' a tutte le posizioni o a nessuna, e si rifiuta prima di creare il foro.",
  "parte": {
    "nuova": true
  },
  "passi": [
    {
      "operazione": "estrudi_rettangolo",
      "argomenti": {
        "piano": "frontale",
        "lunghezza_mm": 200,
        "larghezza_mm": 120,
        "spessore_mm": 20,
        "centrato": true
      },
      "attese": [
        {
          "cosa": "volume_mm3",
          "uguale": 480000
        }
      ]
    },
    {
      "operazione": "foro_guidato",
      "argomenti": {
        "faccia_uid": "@faccia(verso=davanti)",
        "taglia": "M8",
        "passante": true,
        "posizioni": [
          {
            "x_mm": -80,
            "y_mm": -40,
            "ancora": {
              "x": {
                "spigolo_uid": "@spigolo(asse=Y,x~=-100,z~=20)",
                "distanza_mm": 20
              },
              "y": {
                "spigolo_uid": "@spigolo(asse=X,y~=-60,z~=20)",
                "distanza_mm": 20
              }
            }
          },
          {
            "x_mm": 80,
            "y_mm": -40
          }
        ]
      },
      "deve_fallire": {
        "il_messaggio_contiene": [
          "a TUTTE le posizioni o a nessuna",
          "1 su 2"
        ],
        "volume_invariato": true,
        "nessuna_feature_in_piu": true,
        "gemella": "i_fori_guidati_ancorati_restano_a_venti"
      }
    }
  ]
}
