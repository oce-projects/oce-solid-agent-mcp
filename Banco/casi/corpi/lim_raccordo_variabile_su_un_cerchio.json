      "attese": [ { "cosa": "volume_mm3", "uguale": 64000 } ] },
    { "operazione": "taglio_cilindrico",
      "argomenti": { "faccia_uid": "@faccia(verso=davanti)", "x_mm": 0, "y_mm": 0,
