                    "perche_questa_tolleranza": "pi * 50^2 * 50: il conto ha pi dentro" } ] },
    { "operazione": "taglio_cilindrico",
      "argomenti": { "faccia_uid": "@faccia(verso=davanti)", "x_mm": 35, "y_mm": 0,
