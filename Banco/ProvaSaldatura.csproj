<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <OutputType>Exe</OutputType>
    <RootNamespace>ProvaSaldatura</RootNamespace>
    <AssemblyName>ProvaSaldatura</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>bin\</OutputPath>
    <LangVersion>7.3</LangVersion>
    <!-- DOVE STA L'INTEROP, e si puo' scavalcare in tre modi.
         `LEGGIMI.md` documentava `set SW_REDIST=...`, ma quella variabile la
         leggeva solo `Program.cs` a tempo di ESECUZIONE, per l'AssemblyResolve:
         a tempo di COMPILAZIONE questo valore era costante, e chi seguiva
         l'istruzione documentata vedeva fallire la build per HintPath non
         trovato. Il rimedio non risolveva il problema che nominava.
         Adesso: variabile d'ambiente SW_REDIST, oppure /p:SwRedist=..., e in
         mancanza di tutti e due il posto di serie. -->
    <SwRedist Condition=" '$(SwRedist)' == '' AND '$(SW_REDIST)' != '' ">$(SW_REDIST)</SwRedist>
    <SwRedist Condition=" '$(SwRedist)' == '' ">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\api\redist</SwRedist>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Core" />
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SwRedist)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SwRedist)\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="CasiDichiarati.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="ProvaNuove.cs" />
    <Compile Include="Sessione.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>

